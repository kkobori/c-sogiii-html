#deffunc strpq int p100,int p101,int P102,int p103,str p112

mojiqd="　あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをんっゃゅょぁぃぅぇぉがぎぐげござじずぜぞだぢづでどばびぶべぼぱぴぷぺぽアイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンッャュョァィゥェォガギグゲゴザジズゼゾダヂヅデドバビブベボパピプペポ＋。、ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ０１２３４５６７８９？！：．，／％（）小中大ー”＃＊；’［］→←↑↓・「」～　"

    strpp=p112
    px=p101
    py=p102

    notesel strpp
    noteget q,p100

    n=strlen(q)
    nnn=(n/p103)-1
    pxpx=0

    gmode 2

    for nn2,0,nnn+1
        strpg1moji=strmid(q,nn2*p103,p103)
        nnnnnn=instr(mojiqd,0,strpg1moji)
        nnnnnn=nnnnnn/p103
        if (nnnnnn<164) or (nnnnnn>215) {
            if nnnnnn>-1 {
                if nnnnnn=0:nnnnnn=255
                pos px+pxpx,py
                ;--- 修正: (N-1)を基準に配置し、N=128等の境界で
                ;          sxが負にならないようにする ---
                nncol=(nnnnnn-1)\128
                nnrow=(nnnnnn-1)/128
                zure=(nnnnnn<15)
                //gzoom 16,24,1,nncol*16,nnrow*24+zure,16,24-zure
                
                                nncol=((nnnnnn-1)\128)+1
                nnrow=((nnnnnn-1)/128)*24
                zure=(nnnnnn<15)
                gzoom 16,24,1,nncol*16-16,nnrow+zure,16,24-zure
            }
            pxpx=pxpx+16
        }
        if nnnnnn>163 and nnnnnn<216 {
            if nnnnnn>-1 {
                if nnnnnn=0:nnnnnn=255
                nnnnnn=nnnnnn-164
                nnnnnnnn=nnnnnn\128
                pos px+pxpx,py+2
                gzoom 10,24,1,nnnnnnnn*10,48,10,24
            }
            pxpx=pxpx+12
        }
    next

return

#deffunc strp str p100,int p101,int P102,int p103

mojiqd="　あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをんっゃゅょぁぃぅぇぉがぎぐげござじずぜぞだぢづでどばびぶべぼぱぴぷぺぽアイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンッャュョァィゥェォガギグゲゴザジズゼゾダヂヅデドバビブベボパピプペポ＋。、ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ０１２３４５６７８９？！：．，／％（）小中大ー”＃＊；’［］→←↑↓・「」～　"

    ;文字列
    q=p100
    ;表示X位置
    px=p101
    ;表示Y位置
    py=p102
;    mbyte=p103
    ;mbyte=2
    ;p103=mbyte

    n=strlen(q)
    nnn=(n/p103)-1
    pxpx=0

    gmode 2

    for nn2,0,nnn+1
        strpg1moji=strmid(q,nn2*p103,p103)
        nnnnnn=instr(mojiqd,0,strpg1moji)
        nnnnnn=nnnnnn/p103
        if (nnnnnn<164) or (nnnnnn>215) {
            if nnnnnn>-1 {
                if nnnnnn=0:nnnnnn=255
                pos px+pxpx,py
                nnnnnnnn=nnnnnn\128
                if nnnnnn!128{nnnnnnnnnn=(nnnnnn/128)*24}else{nnnnnnnnnn=0}
                zure=(nnnnnn<15)
                //gzoom 16,24,1,nnnnnnnn*16-16,nnnnnnnnnn+zure,16,24-zure
                
                                nncol=((nnnnnn-1)\128)+1
                nnrow=((nnnnnn-1)/128)*24
                zure=(nnnnnn<15)
                gzoom 16,24,1,nncol*16-16,nnrow+zure,16,24-zure
            }
            pxpx=pxpx+16
        }
        if nnnnnn>163 and nnnnnn<216 {
            if nnnnnn>-1 {
                if nnnnnn=0:nnnnnn=255
                nnnnnn=nnnnnn-164
                nnnnnnnn=nnnnnn\128
                pos px+pxpx,py+2
                gzoom 10,24,1,nnnnnnnn*10,48,10,24                
            }
            pxpx=pxpx+12
        }
    next
return


#deffunc varp int p104,int p105,int P106,int p107,int p108

    q=str(p104)
    px=p105
    py=p106
    keta=p107
    lr=p108    ;l=0 r=1
    
    qqq=strmid(q,-1,keta)
        
    n=strlen(qqq)
    ketax=0
    if n<keta and lr=1:ketax=(keta-n)*16:keta=n
    
    j1="0123456789-"

    for nn,0,keta,1
            nnnnn=strmid(qqq,nn,1)
            nnnnnn=instr(j1,0,nnnnn)
            pos px+ketax+(nn*16),py
            if nnnnnn!10 {
                ;gzoom 16,24,1,(nnnnnn)*16+1720,0,16,24
                gzoom 16,24,1,(nnnnnn)*16+1392,24,16,24
            } else {
                ;gzoom 16,24,1,1896,0,16,24    
                gzoom 16,24,1,1744,24,16,24    
            }
    next
    
return

#defcfunc vzstr int p109,int p110

    v=p109
    s=str(v)
    mbyte=p110
    p1102=""
    
    sdim j,30,10

    j(4)="0123456789-"
    j(5)="０１２３４５６７８９ー"
        
    n=strlen(s)
    p111=""

    for nn,0,n,1
        nnnn=strmid(s,nn,1)
        nnnnn=instr(j(4),0,nnnn)
        if nnnnn!-1 {
            nnnnnnnn=strmid(j(5),nnnnn*mbyte,mbyte)
            p111=p111+nnnnnnnn;strf("%02X",nnnnn+215)
        }
    next    

return p111

;bbins(挿入する数値,セットする数値のbit桁,変換前数値,挿入bitインデックス)
#defcfunc bbins int p0,int p1,int P2,int p3

    ;(高速化) 変換前が0以上で、書き込む範囲が31bit内に収まる普通の場合は、シフトとAND/ORで一気に書き込む
    ;  (範囲外・マイナスの場合は下の従来処理に進む。従来処理は1bitずつ計算するため重い)
    if p2>=0 and p3>=0 and p1>=0 and p1<32 and (p3+p1)<32 {
        bbmask=(1<<p1)-1
        return (p2 and ((bbmask<<p3) xor 2147483647)) or ((p0 and bbmask)<<p3)
    }

    invar=p0;挿入する数値
    keta=p1;bitで見てセットする数値の桁
    motovar=p2;変換前数値
    ichi=p3;bitで見て挿入インデックス

    dim getketa,32
    bit32=0
    motoatainai=motovar

if pow2ok=0 {    ;(高速化) 2のべき乗表は初回だけ作る(bbins/bbget/powf2 共通。呼ぶたびの34文の作り直しを廃止)
    dim pow2,33
    pow2(0)=1
    pow2(1)=2
    pow2(2)=4
    pow2(3)=8
    pow2(4)=16
    pow2(5)=32
    pow2(6)=64
    pow2(7)=128
    pow2(8)=256
    pow2(9)=512
    pow2(10)=1024
    pow2(11)=2048
    pow2(12)=4096
    pow2(13)=8192
    pow2(14)=16384
    pow2(15)=32768
    pow2(16)=65536
    pow2(17)=131072
    pow2(18)=262144
    pow2(19)=524288
    pow2(20)=1048576
    pow2(21)=2097152
    pow2(22)=4194304
    pow2(23)=8388608
    pow2(24)=16777216
    pow2(25)=33554432
    pow2(26)=67108864
    pow2(27)=134217728
    pow2(28)=268435456
    pow2(29)=536870912
    pow2(30)=1073741824
    pow2(31)=2147483648
    pow2(32)=4294967296
    pow2ok=1
}
    ;セットする値を２進数に変換して各桁を配列変数に入れる
    for nnpp,0,keta
        motovar22=invar;取り出す元の数値
        ichi22=nnpp;bitで見て取り出すインデックス
        keta22=1;bitで見て何桁取り出すか
    
        mainasu22=0

        ;値がマイナスの場合は2147483648を足してプラスに変える
        ;その代わり３２ビット目を１にする準備をする
        if motovar22<0 {
            motovar22=motovar22+1073741824
            motovar22=motovar22+1073741824
            if ichi22+keta22=32:mainasu22=1
        }
    
        kai=ichi22
        p1002=pow2(kai)
        if kai=0:p1002=1
        bbbbb=p1002
        
        kai=keta22
        p1002=pow2(kai)
        if kai=0:p1002=1
        ccccc=p1002-1

        ;ビットを左にシフト 左側はきえる
        ddddd=motovar22/bbbbb
        ;取り出す桁以外を０にしてANDすると取り出す桁以外が全部ゼロになる つまり右側が消える
        eeeee=(ddddd and ccccc)
        ;値がマイナスの場合に３２ビット目を１にする
        ;左にずらした後なのでマイナスにならない
        getketa(nnpp)=(eeeee or mainasu22)

    next

    ;motoataiがマイナスの場合は一度プラスに変える(32bit目をゼロにする)
    if motoatainai<0 {
        motoatainai=motoatainai+1073741824
        motoatainai=motoatainai+1073741824
        ;後でまた32bit目を1にするための予約
        bit32=1
    }

    ;セットする値を各桁ごとにチェックしながらmotoataiを変換する
    getatai=motoatainai
    for nnnpp,0,keta

        kai=ichi+nnnpp
        p1002=pow2(kai)
        if kai=0:p1002=1
        b9=p1002

        if getketa(nnnpp)=0 {
            ;セットする値がゼロの場合motoataiがゼロでも１でもゼロにしたいので
            ;セットされる値 and ゼロにする位置 xor セットされる値　という式にする
            getatai=getatai and b9 xor getatai
        } else {
            ;セットする値が１の場合motoataiがゼロでも１でも１にしたいので
            ;セットされる値 or ゼロにする位置　という式にする
            ;b9=powi(2,ichi+nnnpp)
            getatai=(getatai or b9)
        }
        ;32bit目が操作される場合
        if ichi+nnnpp=31 {
            if getketa(nnnpp)=1:bit32=1
            if getketa(nnnpp)=0:bit32=0
        }
    next
    
    ;32bit目が1の場合はマイナスに戻す(32bit目に1を立てる)
    if getatai>0 and bit32=1 {
        getatai=getatai-1073741824
        getatai=getatai-1073741824
    }

    p4=getatai

return p4

#defcfunc bbget int p000,int p001,int P002

    ;(高速化) 0以上の値で、取り出す範囲が31bit内に収まる普通の場合は、シフトとANDで一気に取り出す
    if p000>=0 and p001>=0 and p002>=0 and p001<31 and p002<31 {
        return (p000>>p001) and ((1<<p002)-1)
    }

    motovar02=p000;取り出す元の数値
    ichi02=p001;bitで見て取り出すインデックス
    keta02=p002;bitで見て何桁取り出すか
    
    if pow2ok=0 {    ;(高速化) 2のべき乗表は初回だけ作る(bbins/bbget/powf2 共通。呼ぶたびの34文の作り直しを廃止)
        dim pow2,33
        pow2(0)=1
        pow2(1)=2
        pow2(2)=4
        pow2(3)=8
        pow2(4)=16
        pow2(5)=32
        pow2(6)=64
        pow2(7)=128
        pow2(8)=256
        pow2(9)=512
        pow2(10)=1024
        pow2(11)=2048
        pow2(12)=4096
        pow2(13)=8192
        pow2(14)=16384
        pow2(15)=32768
        pow2(16)=65536
        pow2(17)=131072
        pow2(18)=262144
        pow2(19)=524288
        pow2(20)=1048576
        pow2(21)=2097152
        pow2(22)=4194304
        pow2(23)=8388608
        pow2(24)=16777216
        pow2(25)=33554432
        pow2(26)=67108864
        pow2(27)=134217728
        pow2(28)=268435456
        pow2(29)=536870912
        pow2(30)=1073741824
        pow2(31)=2147483648
        pow2(32)=4294967296
        pow2ok=1
    }
    mainasu02=0
    
    ;値がマイナスの場合は2147483648を足してプラスに変える
    ;その代わり３２ビット目を１にする準備をする
    if motovar02<0 {
        motovar02=motovar02+1073741824
        motovar02=motovar02+1073741824
        if ichi02+keta02=32 {
            kai02=keta02-1
            ppppp=pow2(kai02)
            if kai02=0:ppppp=1
            mainasu02=ppppp
        }
    }
    
    kai02=ichi02
    ppppp02=pow2(kai02)
    if kai02=0:ppppp02=1
    bbbbbbbb=ppppp02

    kai02=keta02
    ppppp=pow2(kai02)
    if kai02=0:ppppp=1
    ccccc=ppppp-1

    ;ビットを左にシフト 左側はきえる
    if bbbbbbbb!0:ddddd=motovar02/bbbbbbbb
    
    ;取り出す桁以外を０にしてANDすると取り出す桁以外が全部ゼロになる つまり右側が消える
    eeeee=(ddddd and ccccc)
    
    ;値がマイナスの場合に３２ビット目を１にする
    ;左にずらした後なのでマイナスにならない
    p03=(eeeee or mainasu02)

return p03

#defcfunc varbit int p19,int p20

    v8=p19;double(p19);変換する数値
    keta3=p20;変換後の桁
    
    ;if v8<0:v=double(v8)+4294967296e
    
    p21=""

    if v8<0 {
        p21="1"
        v8=v8+1073741824
        v8=v8+1073741824
    } else {
        p21="0"
    }

    p1006=int(powf(2,keta3))
    if (p1006-1)<v8:v8=(p1006-1)

    nn8=v8;double(v8)

    for nnn8,keta3-2,-1,-1
        p1006=int(powf(2,nnn8))
        if nn8>p1006-1 {
            p21="1"+p21
            p1005=int(powf(2,nnn8))
            nn8=nn8-p1005
        } else {
            p21="0"+p21
        }
        nn8=int(nn8)
    next
    
return p21

#defcfunc bitvar str p22

    v2=p22;変換するbit
    
    keta4=strlen(v2)
    
    p25=0
    dim dd9,keta4
    
    for n9,0,keta4,1
        dd9(n9)=int(strmid(v2,n9,1))
        p1008=int(powf(2,n9))
        if dd9(n9)=1:p25=p1008+p25
    next

return p25

#deffunc boli int p30,int p31,int P32,int p33,int p34

    ;p30=0-四角枠 1-四角枠&黒塗りつぶし 2-白い四角 3-黒い四角 4-濃い灰色塗りつぶし  5-灰色枠&黒塗りつぶし 6-灰色枠
    ;p31=左上Ｘ
    ;p32=左上Ｙ
    ;p33=右下Ｘ
    ;p34=右下Ｙ
    
    gmode 2
    
    if (p30!0) and (p30!6) {
        color 0,0,0
        if p30=2:color 255,255,255
        if p30=4:color 32,32,32
        ;boxf p1,p2,p3+2,p4+2
        pos p31,p32
        if p30=2:gzoom p33-p31+2,p34-p32+2,1,0,1024,1,1
        if p30!2 {
            ;gzoom p33-p31+2,p34-p32+2,1,0,100,1,1
            boxf p31,p32,p33+2,p34+2
        }
    }

    if p30<2 or p30=4 or p30=5 or p30=6 {
        if p30=4:gmulcolor 24,24,24
        if p30=5 or p30=6:gmulcolor 144,144,144
        pos p31,p32:gzoom p33-p31+2,2,1,0,1024,1,1
        pos p31,p32:gzoom 2,p34-p32+2,1,0,1024,1,1
        pos p33,p32:gzoom 2,p34-p32+2,1,0,1024,1,1
        pos p31,p34:gzoom p33-p31+2,2,1,0,1024,1,1
    }
    color 255,255,255
    gmulcolor 255,255,255
return

#deffunc bolico int p1030,int p1035,int p1031,int P1032,int p1033,int p1034

    ;p1030 0-15=四角枠 16-31=四角塗りつぶし
    ;p1035 線の太さ
    ;p1031=左上Ｘ
    ;p1032=左上Ｙ
    ;p1033=右下Ｘ
    ;p1034=右下Ｙ

    bolicono=(p1030\16)*15

    if p1030>15 {
        ;pos p1031,p1032
        ;gzoom p1033-p1031+1,p1034-p1032+1,1,2016+bolicono,95,1,1
        color bolicono,bolicono,bolicono
        boxf p1031,p1032,p1033,p1034
    }

    if p1030<16 {
        color bolicono,bolicono,bolicono
        ;pos p1031,p1032
        ;gzoom p1033-p1031,p1035,1,2016+bolicono,95,1,1
        boxf p1031,p1032,p1033,p1032+p1035
        boxf p1031,p1034-p1035,p1033,p1034
        boxf p1031,p1032,p1031+p1035,p1034
        boxf p1033-p1035,p1032,p1033,p1034
        
        ;pos p1031,p1034-(p1035-1)
        ;gzoom p1033-p1031,p1035,1,2016+bolicono,95,1,1

        ;pos p1031,p1032
        ;gzoom p1035,p1034-p1032,1,2016+bolicono,95,1,1

        ;pos p1033-(p1035-1),p1032
        ;gzoom p1035,p1034-p1032,1,2016+bolicono,95,1,1
        
        ;color 128,128,128
        ;boxf p1031,p1032,p1033,p1034

    }
return

#deffunc window int p3035,int p3031,int P3032,int p3033,int p3034

    ;p3035 0=枠のみ 1=中の塗りつぶし
    ;p3031=左上Ｘ
    ;p3032=左上Ｙ
    ;p3033=右下Ｘ
    ;p3034=右下Ｙ
    
    if p3035=1:bolico 31,0,p3031,p3032,p3033,p3034

    bolico 10,2,p3031,p3032+2,p3033,p3034
    bolico 15,2,p3031+1,P3032,p3033-1,p3034-2

    ;bolico 5,2,p3033,p3032,p3033,p3034
    

return

#deffunc selbox int p2030,int p2031,int P2032,int p2033,int p2034,int p2035,int p2036


    ;p2030=0-選択状態なし　1=あり　2=ロック(アイテム並べ替えの時に使う) 3=1と2の両方
    ;p2031=左上Ｘ
    ;p2032=左上Ｙ
    ;p2033=右下Ｘ
    ;p2034=右下Ｙ
    
    licono=5

    if p2035>p2031 and p2036>p2032 and p2035<p2033 and p2036<p2034 :licono=15

    
    bolico licono,1,p2031,p2032,p2033-1,p2034-1
    ;bolico 5,1,p2031,p2032,p2033,p2034

    ;if p2030!0:bolico 15,1,p2031+4,p2032+4,p2033-4,p2034-4
    ;if p2030=2:bolico 15,1,p2031+7,p2032+7,p2033-7,p2034-7
    ;ロックの矢印
    if p2030=2 or p2030=3 {
        ;pos p2031+8,p2032+4:gzoom 16,24,1,1872,24,16,24
        pos p2031+12,p2032+4:gzoom 16,24,1,1872,24,16,24
    }
    ;普通の矢印
    if p2030=1 or p2030=3 {
        pos p2031+6,p2032+4:gzoom 16,24,1,1872,24,16,24
    }
    
return


;#defcfunc tsy int xxx,int yyy,int hhx,int hhy,int ccy
#defcfunc tsy int mxmx,int mymy,int motomxmx,int motomymy,int xxx,int yyy,int hhx,int hhy,int ccy
    oy=-1
    
    if mxmx=-1 and mymy=-1 and motomxmx!-1 and motomymy!-1 {
        for n,0,ccy,1
            if xxx<motomxmx and yyy+(hhy*n)<motomymy and xxx+hhx>motomxmx and yyy+(hhy*n)+hhy>motomymy {
                oy=n
            }
        next
    }    

return oy

#defcfunc tsx int mmx,int mmy,int motomxx,int motomyy,int xxx,int yyy,int hhx,int hhy,int ccx
    ox=-1
    
    if mmx=-1 and mmy=-1 and motomxx!-1 and motomyy!-1 {
        for n,0,ccx,1
            if xxx+(hhx*n)<motomxx and yyy<motomyy and xxx+(hhx*n)+hhx>motomxx and yyy+hhy>motomyy {
                ox=n
            }
        next
    }    

return ox

#defcfunc tsc int mcx,int mcy,int motomcx,int motomcy,int mmm,int xxx1,int yyyy1,int xxx2,int yyyy2
    yyy1=yyyy1;-mmm*160
    yyy2=yyyy2;-mmm*160
    otsc=-1

    if mcx=-1 and mcy=-1 and motomcx!-1 and motomcy!-1 {

        if (motomcx<xxx1 or motomcx>xxx2) or (motomcy<yyy1 or mcy>yyy2) and (motomcx!-1 and motomcy!-1 and motomcy<480+mmm*160 and motomcy>0+mmm*160):otsc=1

    }

return otsc

