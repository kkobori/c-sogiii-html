    ;アイテム自動整頓を選ぶ
    if mode=1022 and itemhavemax>1 and rmx!-1 and useseitonsely=1 {
        for itemsortnn,0,itemhavemax-1
            for itemsortchrcknn,0,itemhavemax-itemsortnn-1
                if dt(8,713+itemsortchrcknn)>dt(8,713+itemsortchrcknn+1) {
                    kari8=dt(8,713+itemsortchrcknn)
                    kari9=dt(9,713+itemsortchrcknn)
                    kari10=dt(10,713+itemsortchrcknn)
                    dt(8,713+itemsortchrcknn)=dt(8,713+itemsortchrcknn+1)
                    dt(9,713+itemsortchrcknn)=dt(9,713+itemsortchrcknn+1)
                    dt(10,713+itemsortchrcknn)=dt(10,713+itemsortchrcknn+1)
                    dt(8,713+itemsortchrcknn+1)=kari8
                    dt(9,713+itemsortchrcknn+1)=kari9
                    dt(10,713+itemsortchrcknn+1)=kari10
                }
            next
        next
        useseitonsely=0
    }
    ;アイテム並べ替えを選ぶ
    if mode=1022 and itemhavemax>1 and rmx!-1 and useseitonsely=2 {
        nextmode=1028
        for nn,0,itemhavemax
            dt(10,713+nn)=0
        next
    }
    ;アイテム捨てるを選ぶ
    if mode=1022 and itemhavemax>0 and rmx!-1 and useseitonsely=3 {
        nextmode=1020
        gosub *itemautosortout
        itemselectmode=0
        gosub *itemselectset
        gosub *itempagemaxget
        gosub *itemuseokngset
    }
    ;アイテム並べ替え１つ目を選ぶ
