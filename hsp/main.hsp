            epf=bbget(eveloc(evecheckno),0,8)
            epx=bbget(eveloc(evecheckno),8,8)
            epy=bbget(eveloc(evecheckno),16,8)
            
            evegono=evecheckno
            
            ;gosub *evemaplocateget
