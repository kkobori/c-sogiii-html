                    notesel bgmnmset
                    noteget bgmselset,cbno
                    exist "gdata/bgm/"+bgmselset+".mp3"
                    if strsize!-1 {

                        mmload "gdata/bgm/"+bgmselset+".mp3",1,bgmloopmode(cbno)
                        ;mmload "gdata/bgm/"+bgmselset+".mp3",2,bgmloopmode(cbno)
                        gosub *bgmsevolset
                        ;mmvol 1,bgmvol
                        ;getreq bgmstarttime,SYSREQ_timer
                        mmplay 1

                            ;notesel bgmnmset
                            ;noteget bgmselset,79
                            ;exist "gdata/se/"+bgmselset+".wav"
                            ;if strsize!-1 {
                                ;mmload "gdata/se/"+bgmselset+".wav",2,0
                                ;gosub *bgmsevolset
                                ;mmvol 2,-1000
                                ;mmplay 2
                                ;await 30
                                ;mmstop 2
                            ;}

                        ;bgmplayidno=1
                    }
                }
                bgmno=cbno
                cbno=-1
            }
            if bgmorvol=0 and bgmonoff=0 and (setcbno>50) {
                notesel bgmnmset
                noteget bgmselset,setcbno
                exist "gdata/se/"+bgmselset+".wav"
                if strsize!-1 {
                    ;mmstop 2
                    mmload "gdata/se/"+bgmselset+".wav",seplayno,0
                    ;gosub *bgmsevolset
                    nnnvol=((0+1000)*sevolsys)/10
                    mmvol seplayno,nnnvol-1000
                    ;mmvol seplayno,0
                    mmplay seplayno
                    seplayno++
                    if seplayno>seplaynomax:seplayno=seplaynomin
                }
            }
            ;bgmvolsetmode=0
            ;sevolsetmode=0

        }    
        
        ;画面状態    
        if evesyurui=24 {
            n2=bbget(eved(eveno,eveline,0),8,4)
            n3=bbget(eved(eveno,eveline,0),12,8)
            if n2=1 {;明転
                dspmeidomm=n3
                if dspmeido>-1:dspmeidoend=255
                if dspmeido<0:dspmeidoend=0
            }
            if n2=2 {;暗転
                dspmeidomm=-n3
                if dspmeido>-1:dspmeidoend=0
                if dspmeido<1:dspmeidoend=-255
            }
            if n2=3:evegshakemode=1
            if n2=4:gflashmode=1
            if n2=0 {
                evegshakemode=0
                gflashmode=0
                gdaytime=0
                dspmeido=0
                dspmeidomm=0
            }
            if n2=6:gdaytime=1;夕方
            if n2=7:gdaytime=2;夜
            if n2=8:gdaytime=3;セピア色
            if pxyslideon=0 and mode!2260 {
                if n2=9:pxyslideon=2:maproll=0:nextmode=2260
                if n2=10:pxyslideon=3:maproll=0:nextmode=2260
                if n2=11:pxyslideon=4:maproll=0:nextmode=2260
                if n2=12:pxyslideon=5:maproll=0:nextmode=2260
                idomasusuu=n3
            }
            if n2=13 {
                pxyslideon=0:pxslide=0:pyslide=0:maproll=0
                eveline++
                goto *evelinejump
            }
            
            if n2=14:pgset="00":meswaitput=0
        }
*/
        ;ウェイト
        if evesyurui=25 and mode!2060 {
            n2=bbget(eved(eveno,eveline,0),8,16)*2//((wittime=witup)+1)
