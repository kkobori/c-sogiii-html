*loadm

;       |0                   |10                         |20                 |30                 |40                 |50             
 monketa=6,2,4,4,4,8,8,8,16,8,10,2,7,14,14,10,10,10,10,10,7,7,7,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,7,9,9,9,9,9,9,9,9,9,9,9,9,3,3,3,3,5,5,16,9
;       la          lb     lc       ld    le       lf      lg              lh                  li    lj    lk    lL    |M            |N   

    exist folder+"mondat.dat"    
    filesize=strsize/4
    
    mondmax=filesize/23
    dim sdata,filesize
    dim mond,256,60
    dim monidonoff,256
    sdim monnm,50,257,2

        
        
    if strsize!-1 {

    yousoone=23

    bload folder+"mondat.dat",sdata

    qwe=sdata(0)
    
    for monn,0,mondmax,1
    
        setgint=sdata(0+monn*yousoone)
        gosub *vartostr
        nm1=getg
        setgint=sdata(1+monn*yousoone)
        gosub *vartostr
        nm2=getg
        setgint=sdata(2+monn*yousoone)
        gosub *vartostr
        nm3=getg
        monnm(monn,0)=nm1+nm2+nm3

        setgint=sdata(3+monn*yousoone)
        gosub *vartostre
        nm1=getg
        setgint=sdata(4+monn*yousoone)
        gosub *vartostre
        nm2=getg
        setgint=sdata(5+monn*yousoone)
        gosub *vartostre
        nm3=getg
        monnm(monn,1)=nm1+nm2+nm3

        count=6
        nnn=0
        for you,0,60,1
            ttttt=sdata(monn*yousoone+count)
            mond(monn,you)=bbget(ttttt,nnn,monketa(you))
            nnn=nnn+monketa(you)
            if you<59 {
                if nnn+monketa(you+1)>32:count++:nnn=0
            }
            
        next
/*
        for rgb,0,3
            for nxy,0,8
                ttttt=sdata(monn*yousoone+20+rgb)
                nxy3=nxy*3
                monrgb(monn,nxy,rgb)=bbget(ttttt,nxy3,3)
            next
        next
*/
    next

    gosub *monidset
    ;gosub *monnmset

    motomonsel=-1
    motomonnmjp=""
    monnmjp=monnm(monsel,0)
    monnmen=monnm(monsel,1)

    }

return

*loadchrd


    ;dialog "LOADしますか？",3

    ;if stat=6 {
    

        dim sdatachrd,32*3*10;7
        
        dim chrd,32,5,10;7;レベルアップデータ
        
/*        
        chrd,*,0,* =調整値(32bit)
        chrd,*,1,* =角度　高いほど早くＵＰ(16bit)
        chrd,*,2,* =ＵＰ率　低いほど早くＵＰ(8bit)
        chrd,*,3,* =MAXLV このLVで成長曲線が止まる(8bit)
        chrd,*,4,* =MAXLV以降のUP率 EX以外は100で1LV1UP(32bit)
*/
        exist folder+"chrupd.dat"
        
        if strsize!-1 {

        
            bload folder+"chrupd.dat",sdatachrd
    
            for n1,0,32,1
                for n2,0,10,1
                    chrd(n1,0,n2)=sdatachrd(n1*30+n2*3+0)
                    n3=sdatachrd(n1*30+n2*3+1)
                    chrd(n1,4,n2)=sdatachrd(n1*30+n2*3+2)
                    chrd(n1,1,n2)=bbget(n3,0,16)
                    chrd(n1,2,n2)=bbget(n3,16,8)
                    chrd(n1,3,n2)=bbget(n3,24,8)
                next
            next

        }

return
        
*savedt
        
    ;savefileno=0

    dim sdatadt,24,2048
        
    for nn1,8,32
        nn2end=713
        
        if nn1=8                    :nn2end=2048
        if nn1>8 and nn1<15    :nn2end=1225
        if nn1=15                 :nn2end=733
        if nn1=11                 :nn2end=713
        
        for nn2,0,nn2end
            sdatadt(nn1-8,nn2)=dt(nn1,nn2)
        next
    next

    sdatadt(0,1309)=partymax
    sdatadt(0,1312)=fr
    sdatadt(0,1313)=ix
    sdatadt(0,1314)=iy
    sdatadt(0,1315)=iwe
    sdatadt(0,1316)=ins

    bsave slfolder+"sog3sd"+str(savefileno)+".dat",sdatadt
            
return

*loaddt

    putdver++    ;(高速化) putdan キャッシュ無効化
    ;savefileno=0

    ;exist slfolder+"sog3sd"+str(savefileno)+".dat"
    datfolder=slfolder
    exist slfolder+"sog3sd"+str(savefileno)+".dat"
    
    if strsize=-1 {
        exist testslfolder+"sog3sd"+str(savefileno)+".dat"
        datfolder=testslfolder
    }
        
    if strsize!-1 {

        dim sdatadt,24,2048

        bload datfolder+"sog3sd"+str(savefileno)+".dat",sdatadt        
        
        for nn1,8,32
            nn2end=713
        
            if nn1=8                    :nn2end=2048
            if nn1>8 and nn1<15    :nn2end=1225
            if nn1=15                 :nn2end=733
            if nn1=11                :nn2end=713
        
            for nn2,0,nn2end
                dt(nn1,nn2)=sdatadt(nn1-8,nn2)
            next
        next

        partymax=sdatadt(0,1309)
        fr=sdatadt(0,1312)
        ix=sdatadt(0,1313)
        iy=sdatadt(0,1314)
        iwe=sdatadt(0,1315)
        ins=sdatadt(0,1316)

        ;マップ歩き済みデータをセット
        gosub *mapsteponsetfull
                
        ;gosub *trapnoget
            
        ;ワナがまだ復活していない場合
        for nntrap,0,trapmaxput
            trapcnt=peek(dt(13,713+nntrap),1)
            trapfr=trapdata(nntrap,0)
            trapix=trapdata(nntrap,1)
            trapiy=trapdata(nntrap,2)
            henfr=(trapfr)-dmindanf
            henix=(trapix)-dmindanx
            heniy=(trapiy)-dmindany
            if henfr>-1 and henix>-1 and heniy>-1 {
                if trapcnt>0 {
                    poke mapd(henfr,henix,heniy),2,0
                } else {
                    poke mapd(henfr,henix,heniy),2,4                
                }
            }
        next

        ;宝がまだ復活していない場合
        for nntakara,0,takaramaxput
            takaracnt=peek(dt(13,713+nntakara),0)
            takarafr=takaradata(nntakara,2)+1
            takaraix=takaradata(nntakara,3)
            takaraiy=takaradata(nntakara,4)
            henfr=(takarafr)-dmindanf
            henix=(takaraix)-dmindanx
            heniy=(takaraiy)-dmindany
            if henfr>-1 and henix>-1 and heniy>-1 {
                if takaracnt>0 {
                    poke mapd(henfr,henix,heniy),2,0
                } else {
                    poke mapd(henfr,henix,heniy),2,3
                }
            }
        next
                
        gosub *mappidset

        ;敵味方の名前をセット
        gosub *btlchrnmstrset            

    }        
        
    
return
        
*mapsteponsetfull
        
