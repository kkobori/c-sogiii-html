            ;if (idookngyuka!1) and (idookng=1 or idookng=2 or idookng=6) {
            idookngkabe=putd(2,2,0,0)\1000
            idookngyuka=putd(2,2,0,3)\1000
            idookngkokoyuka=putd(2,2,1,3)\1000
            idookng=0
            if (idookngyuka!1) and (idookngkabe=1 or idookngkabe=2 or idookngkabe=6):idookng=1
            ;if (idookngkokoyuka=14 or idookngyuka=14) and ins=0:idookng=0
            ;if (idookngkokoyuka=15 or idookngyuka=15) and iwe=0:idookng=0
            if idookngkokoyuka>13 and idookngkokoyuka<25 {
                if lrud(idookngkokoyuka-14,ins+1,iwe+1,2)=1:idookng=0                
            }
            if idookngyuka>13 and idookngyuka<25 {
                if lrud(idookngyuka-14,ins+1,iwe+1,0)=1:idookng=0                
            }
            if idookng=1 {
                idocnt=1000
                evestartonoff=1
                btlstartonoff=1
                idocntnext=1
                pmsm=1
                hokouudlr=0
            }
        }
        ;右を向く
        if (btnpushon(1)=1 or btn(1)=1) and nextmode<2000 and mx!-1 and (evestartok!4) {
            idocnt=1000
            idocntnext=3
            btnpushon(1)=0
