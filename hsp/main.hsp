*itemlvpickup
    
    ;pickupitemlv=msetfrd(21),msetfrd(22),msetfrd(23)
    
    itempickupmax=0
    dim pickupitemno,512
    dim pickupitemlvcheck,32

    for nnitemlv,0,3
        if pickupitemlvcheck(pickupitemlv(nnitemlv))=0 {
            for itemlvno,0,itemlvmax(pickupitemlv(nnitemlv))
                pickupitemno(itempickupmax)=itemlv(itemlvno,pickupitemlv(nnitemlv))+1
                itempickupmax++
            next
        }
        pickupitemlvcheck(pickupitemlv(nnitemlv))=1
    next
    
return

*traplvpickup
    
    ;pickuptraplv=msetfrd(21),msetfrd(22),msetfrd(23)
    
    trappickupmax=0
    dim pickuptrapno,512
    dim pickuptraplvno,512
    dim pickuptraplvcheck,32

    for nntraplv,0,3
        if pickuptraplvcheck(pickuptraplv(nntraplv))=0 {
            for traplvno,0,traplvmax(pickuptraplv(nntraplv))
                pickuptrapno(trappickupmax)=traplv(traplvno,pickuptraplv(nntraplv))+1
                pickuptraplvno(trappickupmax)=pickuptraplv(nntraplv)
                trappickupmax++
            next
        }
        pickuptraplvcheck(pickuptraplv(nntraplv))=1
    next
    
return

*msetfrdset
    
    msetfrd(16)=0
    
    ;種類
    for nnmset,0,8
        msetfrd(nnmset)=bbget(msetd(msetfr,nnmset/4),(nnmset\4)*8,8)
        ;このマップにいる種類数
        if msetfrd(nnmset)!0:msetfrd(16)=nnmset+1
        if msetfrd(nnmset)=0:_break
    next
    ;最大出現数
    for nnmset,0,8
        msetfrd(nnmset+8)=bbget(msetd(msetfr,2),nnmset*3,3)
    next
    ;エンカウントカウンター
    msetfrd(17)=bbget(msetd(msetfr,2),24,8)*10

    ;罠レベル
    msetfrd(18)=bbget(msetd(msetfr,3),0,5)
    msetfrd(19)=bbget(msetd(msetfr,3),5,5)
    msetfrd(20)=bbget(msetd(msetfr,3),10,5)
    ;通販レベル
    msetfrd(21)=bbget(msetd(msetfr,3),15,5)
    msetfrd(22)=bbget(msetd(msetfr,3),20,5)
    msetfrd(23)=bbget(msetd(msetfr,3),25,5)

return

