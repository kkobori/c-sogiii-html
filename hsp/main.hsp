    motoins=ins
    motoiwe=iwe
    
    while motoins=ins and motoiwe=iwe

        n3=rnd(4)

        if n3=0:ins=-1:iwe=0
        if n3=1:ins=0:iwe=1
        if n3=2:ins=1:iwe=0
        if n3=3:ins=0:iwe=-1
            
    wend

    gosub *mappidset

return
            
