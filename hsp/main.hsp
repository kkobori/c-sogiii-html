*mapsteponset

    if iwe=0 and ins=-1:stepcntmax=maxdany+1-iy
    if iwe=0 and ins=1:stepcntmax=iy-mindany+1
    if iwe=1 and ins=0:stepcntmax=maxdanx+1-ix
    if iwe=-1 and ins=0:stepcntmax=ix-mindanx+1
        
    stepfr=fr
    stepix=ix
    stepiy=iy
        
    stepins=-ins
        
    for steponcnt,0,stepcntmax
        
        setfr=stepfr-mindanf
        setix=stepix-mindanx+iwe*steponcnt
        setiy=stepiy-mindany-ins*steponcnt

        if setfr<64 and setix<16 and setiy<16 {

            henfr=(stepfr)-dmindanf
            henix=(stepix+iwe*steponcnt)-dmindanx
            heniy=(stepiy+stepins*steponcnt)-dmindany
            ;mapd(henfr,henix,heniy)
            
            yukadat=peek(mapd(henfr+1,henix  ,heniy  ),2)
             tendat=peek(mapd(henfr  ,henix  ,heniy  ),2)
               ndat=peek(mapd(henfr  ,henix  ,heniy  ),0)
               sdat=peek(mapd(henfr  ,henix  ,heniy-1),0)
               wdat=peek(mapd(henfr  ,henix  ,heniy  ),1)
               edat=peek(mapd(henfr  ,henix+1,heniy  ),1)
            
            ;現在地以降で床がない場合以外は踏み済み処理を終わりにする
            if steponcnt>0 and (yukadat!1):_break
            
            henpfr=stepfr-dmindanf
            henpix=(stepix+iwe*steponcnt)-dmindanx
            henpiy=(stepiy+stepins*steponcnt)-dmindany
            
            mapstepon(area,henpfr,henpix,henpiy)=1
            ;mapstepon(area,stepfr,stepix+iwe*steponcnt,stepiy+stepins*steponcnt)=1
        
            ;bbins(挿入する数値,セットする数値のbit桁,変換前数値,挿入bitインデックス)

            beforeint=dt(14,713+setfr*8+setiy/2)
            setindex=(setiy\2)*16+setix
        
            dt(14,713+setfr*8+setiy/2)=bbins(1,1,beforeint,setindex)
            
            ;隣との隔たりがある場合は踏み済み処理を終わりにする
            if iwe=0 and ins=-1 and (ndat=0 or ndat=2):_break
            if iwe=0 and ins=1 and (sdat=0 or sdat=2):_break
            if iwe=1 and ins=0 and (edat=0 or edat=2):_break
            if iwe=-1 and ins=0 and (wdat=0 or wdat=2):_break
            
        }
        
    next
        
return
        
