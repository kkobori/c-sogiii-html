    dim chrselokng,12,7
    
    for koukano,3,7,3
    
        ;HP全回復済み
        if siduse(koukano)=1 {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
            if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,108)-dt(nnnn,110))
                chrselokng(nnnn,koukano)=(dt(nnnn,108)=dt(nnnn,110))*7
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }
    
        ;MP全回復済み
        if siduse(koukano)=2 {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
                if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,109)-dt(nnnn,111))
                chrselokng(nnnn,koukano)=(dt(nnnn,109)=dt(nnnn,111))*7
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }

        ;呪われている
        if (siduse(koukano)=1 or siduse(koukano)=2 or siduse(koukano)=20) {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
                if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,140)>0)
                chrselokng(nnnn,koukano)=(dt(nnnn,140)>0)*13
            next
            if useokngcheck=(spchrno_2+1)-spchrno_1:koukaokng(koukano)=13
        }

        ;HPゼロではない
        if siduse(koukano)=20 {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
                if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,110)<1)
                chrselokng(nnnn,koukano)=(dt(nnnn,110)>0)*7
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }

        ;逃げた
        if siduse(koukano)=20 {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
                useokngcheck=useokngcheck+monrannaway(nnnn)
                chrselokng(nnnn,koukano)=monrannaway(nnnn)*7
            next
            if useokngcheck=(spchrno_2+1)-spchrno_1:koukaokng(koukano)=7
        }

        ;各状態異常無し
        if siduse(koukano)=3 and siduse(koukano-2)<7  {
            useokngcheck=0
            nnnnnnnn=siduse(koukano-2)
            for nnnn,spchrno_1,spchrno_2+1
                if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnnnn)>0)
                chrselokng(nnnn,koukano)=(dt(nnnn,137+nnnnnnnn)=0)*7
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }
    
        ;全状態異常無し
        if siduse(koukano)=3 and siduse(koukano-2)=8 {
            useokngcheck=0
            for nnnnnnnn,0,7
                for nnnn,spchrno_1,spchrno_2+1
                    if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnnnn)>0)
                    chrselokng(nnnn,koukano)=(dt(nnnn,137+nnnnnnnn)=0)*7
                next
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }
        ;盗む時にすでに何か持っている（敵）
        if siduse(koukano)=39 {
            if chrno_1<8 and montrasure(chrno_1,0)!0:koukaokng(koukano)=12
        }
        ;すでに転職可能
        if siduse(koukano)=60 {
            useokngcheck=0
            for nnnn,spchrno_1,spchrno_2+1
                if dt(nnnn,43+siduse(koukano-2))>0:useokngcheck++
                ;if monrannaway(nnnn)=0:useokngcheck=useokngcheck+(dt(nnnn,108)-dt(nnnn,110))
                ;chrselokng(nnnn,koukano)=(dt(nnnn,108)=dt(nnnn,110))*7
            next
            if useokngcheck>(spchrno_2-spchrno_1):koukaokng(koukano)=7
        }
;1288=sys warp okng
        if siduse(koukano)=60 and dt(8,1288)=1 {
            koukaokng(koukano)=10
        }
        ;効果無し
        if siduse(koukano)=0 {
            koukaokng(koukano)=99
        }
    next
    
    ;MPが足りない
    if (siduse(0)>dt(chrno_1,111)) and simode=0:koukaokng(3)=3:koukaokng(6)=3


return


