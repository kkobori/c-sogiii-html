        kari9itemselmtsort=dt(9,713+itemy+itemsellpage*itempmax)
        kari10itemselmtsort=dt(10,713+itemy+itemsellpage*itempmax)
        dt(8,713+itemy+itemsellpage*itempmax)=dt(8,itemselmtsort)
        dt(9,713+itemy+itemsellpage*itempmax)=dt(9,itemselmtsort)
        dt(10,713+itemy+itemsellpage*itempmax)=dt(10,itemselmtsort)
        dt(8,itemselmtsort)=kari8itemselmtsort
        dt(9,itemselmtsort)=kari9itemselmtsort
        dt(10,itemselmtsort)=kari10itemselmtsort
        nextmode=1028
    }

    ;スキル使うを選ぶ
    if mode=1032 and rmx!-1 and useseitonsely=0 {
        ;移動時スキル選択　倒れ　封じ　眠り　混乱の時は使えない
        if (dt(chrno,110)>0) and (dt(chrno,138)=0) and (dt(chrno,139)=0) and (dt(chrno,142)=0) {
                nextmode=1030
        }
    }
    ;スキル自動整頓を選ぶ
    if mode=1032 and sphavemax>1 and rmx!-1 and useseitonsely=1 {
        for spsortnn,0,sphavemax-1
            for spsortchrcknn,0,sphavemax-spsortnn-1
                if dt(chrno,201+spsortchrcknn)>dt(chrno,201+spsortchrcknn+1) {
                    karisp=dt(chrno,201+spsortchrcknn)
                    dt(chrno,201+spsortchrcknn)=dt(chrno,201+spsortchrcknn+1)
                    dt(chrno,201+spsortchrcknn+1)=karisp
                }
            next
        next
