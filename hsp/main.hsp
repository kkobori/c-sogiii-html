    if dt(spchrno,11+dt(spchrno,10))<downex:downex=dt(spchrno,11+dt(spchrno,10))
    dt(spchrno,11+dt(spchrno,10))=dt(spchrno,11+dt(spchrno,10))-downex
            
    notesel q
