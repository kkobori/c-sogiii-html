    camppyset=440
    pxwidth=150
    pywidth=36
    
    boli 1,0,camppyset,2*pxwidth+2,camppyset+3*pywidth+2
    
    notesel q
    
    for n,0,camppmax,1
        
        px=(n/3)*pxwidth+2
