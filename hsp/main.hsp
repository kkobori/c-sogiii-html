        while dt(9,sellitemhaveno)=0 and itemy>0
            itemy--
            sellitemhaveno=713+itemy+itemsellpage*itempmax
        wend
        if dt(8,713)=512:nextmode=1022
    }
    ;アイテムつかうを選ぶ
