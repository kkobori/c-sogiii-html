        selbox ((campsely=n) and (cslpcnt=1)),px,py,px+pxwidth,py+pywidth,mx,my

        
            gmulcolor 255,255,255
        
            ;アイテムを持っていない場合
            ;if n=0 and itemhavemax=0:gmulcolor 127,127,127
        
