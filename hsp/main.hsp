        ;43=攻 44=防 45=力 46=早 47=器 48=魔
        ;49=MAXHP 50=MAXMP 51=HP 52=MP 53=回避 54=クリティ 55=命中減
        ;if lung=0:;critystr=q(801)+q(292)+q(270)
        ;if lung=1:;critystr=q(802)+q(484)
        strpq 452+lung,32+pxp,256+pyp,mbyte,q        ;こうげき
        strpq 454+lung,32+pxp,280+pyp,mbyte,q        ;ぼうぎょ
        strpq 456+lung,224+pxp,256+pyp,mbyte,q        ;かいひりつ
        strpq 458+lung,224+pxp,280+pyp,mbyte,q        ;クリティカルりつ
        varp dt(strchrno,76),112+pxp,256+pyp,5,1        ;こうげき
        varp dt(strchrno,77),112+pxp,280+pyp,5,1        ;ぼうぎょ
        varp dt(strchrno,112),336+pxp,256+pyp,5,1        ;かいひりつ
        varp dt(strchrno,113),336+pxp,280+pyp,5,1        ;クリティカルりつ
    
        ;こうげきぞくせい
        sdim kouzokuseistr,30*mbyte,8
        kouzokuseistrgyoumax=0
        notesel q
        for nnn,165,181
            if dt(strchrno,nnn)>0 {
                noteget qqq,532+(nnn-165)*2+lung
                kouzokuseistr(kouzokuseistrgyoumax)=kouzokuseistr(kouzokuseistrgyoumax)+qqq+"　"
                if strlen(kouzokuseistr(kouzokuseistrgyoumax))>(12*mbyte):kouzokuseistrgyoumax++
            }
        next
        if kouzokuseistr(kouzokuseistrgyoumax)=nostr:kouzokuseistrgyoumax--
        if kouzokuseistr(0)=nostr:noteget qqq,568:kouzokuseistr(0)+qqq
        kouzokuseistrputgyou++
        if kouzokuseistrputgyou>((kouzokuseistrgyoumax+1)*30)-1:kouzokuseistrputgyou=0
        strpq 564+lung,32+pxp,304+pyp,mbyte,q
        strp kouzokuseistr(kouzokuseistrputgyou/30),176+pxp,304+pyp,mbyte

        ;ぼうぎょぞくせい
        sdim bouzokuseistr,30*mbyte,8
        bouzokuseistrgyoumax=0
        notesel q
        for nnn,181,197
            if dt(strchrno,nnn)!0 {;and bouinfoonoff(nnn-181)=1 {
                noteget qqq,532+(nnn-181)*2+lung
                if dt(strchrno,nnn)=1:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"＋１　"
                if dt(strchrno,nnn)=2:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"＋２　"
                if dt(strchrno,nnn)>2:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"＋３　"
                if dt(strchrno,nnn)=-1:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"ー１　"
                if dt(strchrno,nnn)=-2:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"ー２　"
                if dt(strchrno,nnn)<-2:bouzokuseistr(bouzokuseistrgyoumax)=bouzokuseistr(bouzokuseistrgyoumax)+qqq+"ー３　"
                if strlen(bouzokuseistr(bouzokuseistrgyoumax))>(12*mbyte):bouzokuseistrgyoumax++
            }        
        next
        if bouzokuseistr(bouzokuseistrgyoumax)=nostr:bouzokuseistrgyoumax--
        if bouzokuseistr(0)=nostr:noteget qqq,568:bouzokuseistr(0)+qqq
        bouzokuseistrputgyou++
        if bouzokuseistrputgyou>(bouzokuseistrgyoumax+1)*30-1:bouzokuseistrputgyou=0
        strpq 566+lung,32+pxp,328+pyp,mbyte,q
        strp bouzokuseistr(bouzokuseistrputgyou/30),176+pxp,328+pyp,mbyte
        
    }

    pyp=motopyp

return

*putchrd
    
    dim ijoun,32,32
    dim ijouon,32
    ;ijouon=0
    
    for nn,8,partymax+8,1
        for nnn,137,147,1
            if dt(nn,nnn)!0:ijoun(ijouon(nn),nn)=nnn-137:ijouon(nn)++
        next
        for nnn,147,157,1
            if dt(nn,nnn)>0 :ijoun(ijouon(nn),nn)=(nnn-147)*2+10:ijouon(nn)++
            if dt(nn,nnn)<0:ijoun(ijouon(nn),nn)=(nnn-147)*2+11:ijouon(nn)++
        next
        if ijouon(nn)!0:ijoupmax(nn)=(ijouon(nn)+1)*30;*((wittime=witup)+1)
        ijoupcnt(nn)++
        if ijoupcnt(nn)>ijoupmax(nn)-1 {
            ijoupcnt(nn)=0
        }
    next
    if ijouon3!0:ijoupmax3=ijouon3*60
    ijoupcnt3++:if ijoupcnt3>ijoupmax3-1:ijoupcnt3=0

    motopxp=pxp
    motopyp=pyp
    
    pyp=0
        
    ;if mode<4000:pyp=48
    ;if (nextmode>2169 and nextmode<2246) :pyp=pyp-48
    ;if mode=1020 or mode=1021    :pyp=pyp-48
    ;if mode=1030 or mode=1031    :pyp=pyp-48
    ;if mode=1120 or mode=1130    :pyp=pyp-48
    ;if mode=1180 or mode=1181    :pyp=pyp-48
    ;if mode=1300 or mode=1310    :pyp=pyp-48
    
    pypset=pyp

    for n,8,partymax+8,1
    
        npx=n-8
        
        pyp=pypset
        
        if mode<4200 and mode>4019 and updownijouoffon=0 {
            if btlchrno=n:pyp=pypset+24
        }
/*

        if mode>3999 {
            if btlanm(n,0)>0 and gflashmode=0 {
                motopxp=pxp
                motopyp=pyp
                pxp=pxp+rnd(24)-12
                pyp=pyp+rnd(24)-12
            }
            if btlanm(n,2)>0 {
                motopxp=pxp
                motopyp=pyp
                pyp=pyp+16
            }

        }
    */
        if mode=1030 or mode=1050 or mode=1180 or mode=1190 {
            if chrno=n:gmode 2
        }
        if mode=1035 or mode=1037 or mode=1045 or mode=1055 or mode=1105 or mode=1185 or mode=1320 {
            if chrsely=n:gmode 2
        }
        ;ダメージを受けるアニメーション
        dmggppx=0
        dmggppy=0
        if mode>0 and (btldmganm(n)>0) {
            dmggppx=-15+rnd(30)
            dmggppy=-15+rnd(30)
        }

    
        boli 4,0+pxp+npx*120+dmggppx,0+pyp+dmggppy,118+pxp+npx*120+dmggppx,116+pyp+(mode>3999)*10+dmggppy
                    
        namechrno=n
        gosub *plnameget
        pxx=12+pxp+npx*120+dmggppx
        pyy=4+pyp+dmggppy
        
        ;名前
        strp chrname,pxx,pyy,mbyte


        ;HP
        strpq 444,12+pxp+npx*120+dmggppx,52+pyp+dmggppy,mbyte,q
        ;MP
        strpq 446,12+pxp+npx*120+dmggppx,82+pyp+dmggppy,mbyte,q
        ;HPの値
        varp dt(n,110),44+pxp+npx*120+dmggppx,52+pyp+dmggppy,4,1
        ;MPの値
        varp dt(n,111),44+pxp+npx*120+dmggppx,82+pyp+dmggppy,4,1

        boli 0,12+pxp+npx*120+dmggppx,74+pyp+dmggppy,108+pxp+npx*120+dmggppx,80+pyp+dmggppy
        boli 0,12+pxp+npx*120+dmggppx,104+pyp+dmggppy,108+pxp+npx*120+dmggppx,110+pyp+dmggppy

        if dt(n,108)!0:chrhpber=(dt(n,110)*93)/dt(n,108)
        if dt(n,109)!0:chrmpber=(dt(n,111)*93)/dt(n,109)
;
        if dt(n,110)>0:boli 0,13+pxp+npx*120+dmggppx,77+pyp+dmggppy,13+chrhpber+pxp+npx*120+dmggppx,77+pyp+dmggppy
        if dt(n,111)>0:boli 0,13+pxp+npx*120+dmggppx,107+pyp+dmggppy,13+chrmpber+pxp+npx*120+dmggppx,107+pyp+dmggppy

    
        ;lung=1
    
        if (ijouon(n)!0 and 30>ijoupcnt(n)) or ijouon(n)=0 {
            
            ;職業　二文字だけ
            notesel q
            noteget nnn,360+dt(n,10)*2+lung
            ;nnn=q(360+dt(n,10)*2+lung)
            nn=strmid(nnn,0,2*mbyte)
            ;nn=strmid(nnn,0,mbyte*2)
            strp nn,12+pxp+npx*120+dmggppx,28+pyp+dmggppy,mbyte
            
            ;LVの値
            varp dt(n,9),60+pxp+npx*120+dmggppx,28+pyp+dmggppy,3,1
            
            ;LVという文字
            pos 52+pxp+npx*120+dmggppx,30+pyp+dmggppy
            if dt(n,9)<100 {
                gzoom 16,24,1,0,72,16,24
            }
        }
        
        ;状態異常
        nnnn=ijoupcnt(n)/30
        if ijouon(n)!0 and nnnn!0 {
            strpq 470+ijoun(nnnn-1,n)*2+lung,12+pxp+(n-8)*120+dmggppx,28+pyp+dmggppy,mbyte,q
        }

        gmode gmodeset,,,160
    
    next
    
    pxp=motopxp
    pyp=motopyp


return

*putselchr

    selchrputy=504
    selchrboxmodecolor=255
    
    selchrboxmode=1
    if mode=1041:selchrboxmode=5
    if mode=1180 or mode=1181 or mode=1190 {
