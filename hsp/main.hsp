                ;ＭＰ　16000以上は (値-16000)*1000
                if dt(nn,109)>16000 :dt(nn,109)=(dt(nn,109)-16000)*1000:dt(nn,111)=dt(nn,109)
                ;攻撃力　800以上は (値-800)*100
                if dt(nn,76)>800 :dt(nn,76)=(dt(nn,76)-800)*100
                ;防御力　800以上は (値-800)*100
