#module

#deffunc dstrp int p120,int p121,int P122,int p123

    mref p125,64

    if p123<2 {

        dstrpn2=16-p123*6
        p124=0

        for dstrpn,0,4+p123*2,1
            dstrpa=bbget(p120,dstrpn*(8-p123*3),8-p123*3)
            pos p121+dstrpn*(16-p123*4),p122
            if (p123=1 and dstrpa!0 and dstrpa!31) or (p123=0 and dstrpa!0) {
                ;if jimode1=0 {
                ;    gzoom dstrpn2*2,24,1,dstrpa*dstrpn2-dstrpn2,p123*12,dstrpn2,12
                ;} else {
                    nnnnnnnx=(dstrpa\128)*dstrpn2-dstrpn2
                    nnnnnnny=(dstrpa/128)*24+p123*48
                    zure01=(dstrpa<15)
                    if dstrpa=128:nnnnnnnx=nnnnnnnx+2048:nnnnnnny=1024
                    gzoom dstrpn2,24,1,nnnnnnnx,nnnnnnny+zure01,dstrpn2,24-zure01
                ;}
                p124=dstrpn+1
            }
        next

    }
    if p123=2 {
        dstrpn2=10
        p124=0

        for dstrpn,0,4,1
            dstrpa=bbget(p120,dstrpn*8,8)-163
            if dstrpa<0:dstrpa=0
            if dstrpa=66:dstrpa=53:goto *jump
            if dstrpa=63:dstrpa=65:goto *jump
            if dstrpa=64:dstrpa=66:goto *jump
            if dstrpa=53:dstrpa=64:goto *jump
            if dstrpa=76:dstrpa=67:goto *jump
            if dstrpa>53 and dstrpa<63:dstrpa=dstrpa+1:goto *jump
*jump
            pos p121+dstrpn*12,p122
            ;if dstrpa!0 and dstrpa!31 {
                gzoom dstrpn2*2,24,1,dstrpa*dstrpn2-dstrpn2,24,dstrpn2,24
                p124=dstrpn+1
            ;}
        next
    
    }
    
    p125=p124

return
