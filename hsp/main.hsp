    if mode=1045 and rmx!-1 :nextmode=1040
    if mode=1050 and rmx!-1 :nextmode=1010
    if mode=1055 and rmx!-1 :nextmode=1050
    if mode=1060 and rmx!-1 :nextmode=1055
    if mode=1080 and rmx!-1 :nextmode=1090
    if mode=1090 and rmx!-1 :nextmode=1010
    if mode=1120 and rmx!-1    :nextmode=1020
    if mode=1130 and rmx!-1    :nextmode=1030
    if mode=1180 and rmx!-1 :nextmode=1190
    if mode=1181 and rmx!-1 :nextmode=1190
    if mode=1185 and rmx!-1 :nextmode=1010
    if mode=1190 and rmx!-1 :nextmode=1185
    if mode=1200 and simode=1 and rmx!-1 :nextmode=1020
    if mode=1200 and simode=0 and rmx!-1 :nextmode=1030
    if mode=1400 and rmx!-1 :nextmode=1000
    if mode=1410 and rmx!-1 :nextmode=1400
    if mode=1600 and rmx!-1 :nextmode=1000
    if mode=1610 and rmx!-1 :nextmode=1600
    if mode=2020 and rmx!-1 :eveline++:nextmode=2000
    if mode=2300 and rmx!-1 :nextmode=1000
    if mode=2310 and rmx!-1 :nextmode=2300
    if mode=4400 and rmx!-1 :nextmode=1000
    if mode=4410 and rmx!-1 :nextmode=4400
    
    ;２択３択選択時
    if mode=2025 and rmx!-1{
        meswaitput=0
        nextmode=2000
        ojline=eveseljumpline(eveselmax)
        gosub *evelinejumpset
    }
    ;治療所
    if mode=2030 and rmx!-1:nextmode=2000:eveline++
    if mode=2040 and rmx!-1:nextmode=2000:eveline++
    if mode=2050 and rmx!-1:nextmode=2000:eveline++
    ;店
    if mode=2070 and rmx!-1 {
        if sishopon=0:nextmode=2000:eveline++
        if sishopon=1:nextmode=1000
    }
    if mode=2080 and rmx!-1:nextmode=2070
    if mode=2090 and rmx!-1 {
        nextmode=2080
        if shopzerobuyon>0:shopbuyn(shopzerobuyon-1,0)--
    }
    if mode=2120 and rmx!-1:nextmode=2070
    if mode=2121 and rmx!-1:nextmode=2070
    ;no
    if mode=2130 and rmx!-1 {
        nextmode=2120
        if shopzerosellon>0:shopselln(shopzerosellon-1,0)--
    }
    ;かいました
    if mode=2150 and rmx!-1 {
        nextmode=2080
        dim shopbuyn,10,3    ;0=買いたい数 1=既に持っている数 2=買える最大数
        gosub *shopbuynset
    }
    ;うりました
    if mode=2160 and rmx!-1 {
        nextmode=2120
        dim shopselln,1225,3    ;0=売りたい数 1=持っている数
        gosub *shopsellnset
    }
    if mode=2170 and goon=1 and rmx!-1 {
        gosub *plnameset
        for chrno,partymax+8,4
            ;gosub *chrdtcls
            gosub *spgetcheck
        next
        eveline++
        nextmode=2000
        ;ix=7
        ;gosub *現在地
    }
    if mode=2180 and rmx!-1:nextmode=2170:gosub *tsumesyoset
    if mode=2190 and rmx!-1:nextmode=2170:gosub *tsumesyoset
    if mode=2200 and rmx!-1 {
        if namelen=0 {
            nextmode=2170
            for nnn,0,8,1
                dt(chrno,nnn)=0
            next
            for nnn,9,713,1
                dt(chrno,nnn)=0
            next
            ;for nnn,201,251,1
            ;    dt(chrno,nnn)=0
            ;next
            gosub *tsumesyoset
        }
        if namelen>0 {
            namelen--
            name(namelen)=0
        }
    }
    if mode=2205 and rmx!-1:nextmode=2200
    if mode=2207 and rmx!-1:nextmode=2205
    if mode=2210 and rmx!-1:nextmode=2170:gosub *tsumesyoset
    if mode=2215 and rmx!-1:nextmode=2210
    if mode=2220 and rmx!-1:nextmode=2170
    if mode=2225 and rmx!-1:nextmode=2220
    if mode=2230 and rmx!-1:nextmode=2170:gosub *tsumesyoset
    if mode=2235 and rmx!-1:nextmode=2230
    if mode=2240 and rmx!-1:nextmode=2170
    if mode=2245 and rmx!-1:nextmode=2240
    if mode=2400 and rmx!-1:nextmode=1000
    if mode=2405 and rmx!-1:nextmode=1000
    if mode=2420 and rmx!-1:nextmode=1000
    if mode=2430 and rmx!-1:nextmode=2400
    
    if mode=4020 and rmx!-1:nextmode=4010:btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
    if mode=4030 and rmx!-1:nextmode=4020
    if mode=4070 and rmx!-1:nextmode=4020
    if mode=4075 and rmx!-1:nextmode=4070
    if mode=4080 and rmx!-1:nextmode=4070
    if mode=4090 and rmx!-1:nextmode=4075
    if mode=4110 and rmx!-1:nextmode=4020
    if mode=4111 and rmx!-1:nextmode=4020
    if mode=4112 and rmx!-1:nextmode=4020
    if mode=4120 and rmx!-1:nextmode=4110
    if mode=4160 and rmx!-1:nextmode=4020
    if mode=4161 and rmx!-1:nextmode=4020
    if mode=4162 and rmx!-1:nextmode=4020
    if mode=4165 and rmx!-1:nextmode=4160
    
    ;if mode>1999 and mode<3000 {
    ;    xbtnputonoff=1
    ;    pxxbtn=0
    ;    pyxbtn=((ylinemax-kky)-eveselmax*48+pyp)-60
    ;    gosub *xbtn
    ;}

return
                    
*budan
    if (mode=10 or mode=200 or mode=530 or mode=540 or mode=570 or mode=600 or mode=1060 or mode=1110 or mode=1200 or mode=2030 or mode=2050 or mode=2090 or mode=2130 or mode=2207 or mode=2215 or mode=3000) and cmx!-1 :yesnoselx=1-yesnoselx

    if mode=100 and cmx!-1 {
        sldatasely--
        if sldatasely<0:sldatasely=4
    }
    
    if mode=1001 and rmx!-1 {
        fr--
        gosub *mappidset
        msetfr=fr
        gosub *msetfrdset
        idocnt=1000
        idocntnext=4
        btlstartonoff=1
        nextmode=1000
        if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
    }
    if mode=1010 and cmx!-1 {
        campselyplus=0
        if (campsely\3)=0:campselyplus=2
        if (campsely\3)!0:campselyplus=-1
        if (campsely+campselyplus)>=camppmax:campselyplus=0:campsely=camppmax-1
        campsely=campsely+campselyplus
    }
    if (mode=1020 or mode=1028 or mode=1029 or mode=1080 or mode=1180 or mode=4080 or mode=4160) and cmx!-1 {
        itemy--
        ;if itemy<0:itemy=itempmax-1:itemsellpage--:if itemsellpage<0:itemsellpage=itempagemax
        if itemy<0:itemy=itempmax-1;:itemsellpage--:if itemsellpage<0:itemsellpage=itempagemax
        while dt(11,713+itemy+itemsellpage*itempmax)=1226 and itemy>0
            itemy--
        wend
        if mode=1080 or mode=1180 or mode=4080 {
            ;eqipitemno=dt(8,dt(11,713+itemy+itemsellpage*itempmax))
            a=dt(11,713+itemy+itemsellpage*itempmax)
            eqipitemno=dt(8,a)
            if a>1224:eqipitemno=0
            gosub *itemeqipinfoset
        }
    }
    if (mode=1021 or mode=1181 or mode=4081 or mode=4161) and cmx!-1 {
        itemsellpage--:if itemsellpage<0:itemsellpage=itempagemax
        while dt(11,713+itemy+itemsellpage*itempmax)=1226 and itemy>0
            itemy--
        wend
        if mode=1181 or mode=4081 {
            ;eqipitemno=dt(8,dt(11,713+itemy+itemsellpage*itempmax))
            a=dt(11,713+itemy+itemsellpage*itempmax)
            eqipitemno=dt(8,a)
            if a>1224:eqipitemno=0
            gosub *itemeqipinfoset
        }
    }
    if (mode=1022 or mode=1032 or mode=4112 or mode=4162) and cmx!-1 {
        useseitonsely--
        if useseitonsely<0:useseitonsely=nuseseitonmax-1
    }
    if (mode=1030 or mode=1038 or mode=1039 or mode=4110) and cmx!-1 {
        spy--
        ;if spy<0:spy=sppmax-1:spselpage--:if spselpage<0:spselpage=sppagemax
        if spy<0:spy=sppmax-1;:spselpage--:if spselpage<0:spselpage=sppagemax
        while dt(chrno,201+spy+spselpage*sppmax)=512 and spy>0
            spy--
        wend
    }
    if (mode=1031 or mode=4111) and cmx!-1 {
        spselpage--:if spselpage<0:spselpage=sppagemax
        while dt(chrno,201+spy+spselpage*sppmax)=512 and spy>0
            spy--
        wend
    }
    if (mode=1035 or mode=1040 or mode=1045 or mode=1050 or mode=1105 or mode=1185 or mode=1320 or mode=2190 or mode=4120) and cmx!-1 {
        chrsely--
        if chrsely<0:chrsely=partymax-1
        if mode=1035:sppage=0:spy=0:chrno=chrsely+8:gosub *sppagemaxget:gosub *spuseokngset
        if mode=1045 or mode=1040:sppage=0:chrno=chrsely+8:gosub *sppagemaxget
        if mode=1185:chrno=chrsely+8
    }
    if (mode=1041 or mode=2225) and cmx!-1 {
        spselpage--
        if spselpage<0:spselpage=sppagemax
    }
    if (mode=1055 or mode=2205) and cmx!-1 {
        if jobsely>0 {
            jobsely--
        } else {
            jobpageset=0
            jobselxset=0
            jobselyset=0
            if jobpage>0:jobpageset=-1:jobsely=3
            if jobpage=0 {
                jobpageset=jobpagemax
                jobselyset=((jobmax-1)\8)/2
                if (jobmax\2)=1 and jobselx=1:jobselxset=-1
            }
            ;if jobsely=3 and jobpagemax=jobpage:jobpageset=-jobpagemax:jobselyset=-jobsely
            ;if jobsely=3 and jobpagemax>jobpage:jobpageset=1:jobselyset=-jobsely
            ;if jobselx=1 and jobsely<3 and (jobmax\2)=1:jobselyset=1:jobselxset=-1
            ;if jobselx=1 and jobsely<3 and (jobmax\2)=0:jobselyset=-jobsely:jobpageset=-jobpagemax
            ;if jobselx=0 and jobsely<3 :jobselyset=-jobsely:jobpageset=-jobpagemax
            jobpage=jobpage+jobpageset
            jobselx=jobselx+jobselxset
            jobsely=jobsely+jobselyset
        }
    }
    ;if (mode=1055 or mode=2205) and cmx!-1 {
    ;    if jobsely=0:jobpage--
    ;    if jobsely>0:jobsely--
    ;    if jobsely=0 and jobpage<0:jobsely=3:jobpage=jobpagemax
    ;}
    if (mode=1090 or mode=1190 or mode=4070) and cmx!-1:eqipy--:if eqipy<0:eqipy=2
    if (mode=1400 or mode=4400) and cmx!-1 :takaraselx--:if takaraselx<0:takaraselx=2
    if mode=1600 and cmx!-1 {        
        warpself=warpfrselcslset(warpself,0)
    }
    if mode=1610 and cmx!-1 :warpsely--:if warpsely<0:warpsely=15
    if mode=2025 and cmx!-1 :evesely=evesely-1:if evesely<0:evesely=eveselmax-1
    if mode=2070 and cmx!-1 :shopinselx--:if shopinselx<0:shopinselx=2
    if (mode=2080 or mode=2300) and cmx!-1 :shopsely--:dim infoputcutcnt,5:if shopsely<0:shopsely=shopitemmax-1
    if mode=2090 and cmx!-1 :gosub *brdan
    if (mode=2120 or mode=2310) and cmx!-1 {
        itemselly--
        if itemselly<0:itemselly=itempmax-1;:itemsellpage--:if itemsellpage<0:itemsellpage=itempagemax
        while dt(9,713+itemselly+itemsellpage*itempmax)=0 and itemselly>0
            itemselly--
        wend
    }
    if mode=2121 and cmx!-1 {
        itemsellpage--
        if itemsellpage<0:itemsellpage=itempagemax
        while dt(9,713+itemselly+itemsellpage*10)=0 and itemselly>0
            itemselly--
        wend
    }
    if mode=2130 and cmx!-1 :gosub *brdan
    if mode=2170 and cmx!-1 :tsumesyoy--:if tsumesyoy=-1:tsumesyoy=tsumesyomax-1
    if (mode=2180 or mode=2210 or mode=2220 or mode=2230 or mode=2235 or mode=2240) and cmx!-1 :meiboy--:if meiboy=-1:meiboy=9
    if (mode=2200 or mode=2245) and cmx!-1 and nameputx<5:nameputy--:if nameputy=-1:nameputy=11
    if (mode=2200 or mode=2245) and cmx!-1 and nameputx=5 {
        nameputx5y--
        nameputy--
        if kanamode!2 and nameputx5y=-1:nameputx5y=4:nameputy=11
        if kanamode=2 and nameputx5y=2:nameputx5y=4:nameputy=11
    }
    if mode=2400 and cmx!-1 :izumiy--:if izumiy=-1:izumiy=izumimax-1
    if mode=4020 and cmx!-1 {
        btlcomselyplus=0
        if (btlcomsely\2)=0:btlcomselyplus=1
        if (btlcomsely\2)!0:btlcomselyplus=-1
        if (btlcomsely+btlcomselyplus)>=btlcompmax:btlcomselyplus=0:btlcomsely=btlcompmax-1
        btlcomsely=btlcomsely+btlcomselyplus
    }
    if (mode=4030 or mode=4120 or mode=4090 or mode=4165) and cmx!-1 {
        nextoneorall=oneorall
        if oneorall=0 :nextoneorall=10:motomonspchrno=spchrno_1:spchrno_1=motoispchrno:spchrno_2=spchrno_1
        if oneorall=10 :nextoneorall=0:motoispchrno=spchrno_1:spchrno_1=motomonspchrno:spchrno_2=spchrno_1
        if oneorall=11 :nextoneorall=1:spchrno_1=0:spchrno_2=monmax-1
        if oneorall=1 :nextoneorall=11:spchrno_1=8:spchrno_2=partymax+8-1
        oneorall=nextoneorall
        if oneorall=0 {;単体and敵
            for nn,7,-1,-1
                if spchrno_1<0:spchrno_1=monmax-1
                if dt(spchrno_1,110)>0:spchrno_2=spchrno_1:_break
                spchrno_1--
            next
        }
        if oneorall=10 {;単体and味方
            for nn,11,7,-1
                if spchrno_1<8:spchrno_1=partymax+8-1
                if dt(spchrno_1,110)>0:spchrno_2=spchrno_1:_break
                spchrno_1--
            next
        }
    }
    if (mode=4075) and (cmx!-1):useeqipy=1-useeqipy

return

*bddan
    if (mode=10 or mode=200 or mode=530 or mode=540 or mode=570 or mode=600 or mode=1060 or mode=1110 or mode=1200 or mode=2030 or mode=2050 or mode=2090 or mode=2130 or mode=2207 or mode=2215 or mode=3000) and cmx!-1 :yesnoselx=1-yesnoselx

    if mode=100 and cmx!-1 {
        sldatasely++
        if sldatasely>4:sldatasely=0
    }
        
    if mode=1001 and rmx!-1 {
        fr++
        gosub *mappidset
        msetfr=fr
        gosub *msetfrdset
        nextmode=1000
        idocnt=1000
        idocntnext=4
        btlstartonoff=1
        if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
    }
    if mode=1010 and cmx!-1 {
        campselyplus=0
        if (campsely\3)=2:campselyplus=-2
        if (campsely\3)!2:campselyplus=1
        if (campsely+campselyplus)>=camppmax:campselyplus=-(campsely\3)
        campsely=campsely+campselyplus
    }
    if (mode=1020 or mode=1028 or mode=1029 or mode=1080 or mode=1180 or mode=4080 or mode=4160) and cmx!-1 {
        itemy++
        ;if itemy>(itempmax-1):itemy=0:itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
        if itemy>(itempmax-1):itemy=0;:itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
        if dt(11,713+itemy+itemsellpage*itempmax)=1226:itemy=0;:itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
        if mode=1080 or mode=1180 or mode=4080 {
            a=dt(11,713+itemy+itemsellpage*itempmax)
            eqipitemno=dt(8,a)
            if a>1224:eqipitemno=0
            gosub *itemeqipinfoset
        }
    }
    if (mode=1021 or mode=1181 or mode=4081 or mode=4161) and cmx!-1 {
        itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
        while dt(11,713+itemy+itemsellpage*itempmax)=1226 and itemy>0
            itemy--
        wend
        if mode=1181 or mode=4081 {
