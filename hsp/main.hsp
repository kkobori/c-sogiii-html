            if (nnn-43)!dt(chrno,10):dt(chrno,nnn)=0
        next
        for nnn,133,137,1
            dt(chrno,nnn)=512
        next
        gosub *statsset
        dt(chrno,110)=dt(chrno,108);+dt(chrno,60)
        dt(chrno,111)=dt(chrno,109);+dt(chrno,61)

        for nnn,201,713,1
            dt(chrno,nnn)=512
        next
        nextmode=2170
        gosub *tsumesyoset
        gosub *plnameset
        gosub *spgetcheck
    }
    if mode=2210 and rmx!-1 and dt(meibox*10+meiboy+4+8,9)>0 {
        nextmode=2215
        chrno=meibox*10+meiboy+4+8
        namechrno=chrno
        gosub *plnameget
        notesel q
        noteget qqq,322
        if lung=0:msg(0)=chrname+qqq
        noteget qqq,323
        if lung=1:msg(0)=qqq+chrname+"！"
        noteget qqq,324
        msg(1)=qqq
        noteget qqq,326
        msg(2)=qqq
        yesnoselx=1
    }
    if mode=2215 and rmx!-1 and yesnoselx=0 {
        nextmode=2210
        for nnnn,chrno,31,1
            for nnn,0,8,1
                dt(nnnn,nnn)=dt(nnnn+1,nnn)
            next
            for nnn,9,713,1
                dt(nnnn,nnn)=dt(nnnn+1,nnn)
            next
        next
        for nnn,0,8,1
            dt(31,nnn)=0
        next
        for nnn,9,713,1
            dt(31,nnn)=0
        next
    }
    if mode=2215 and rmx!-1 and yesnoselx=1:nextmode=2210
    if mode=2220 and rmx!-1 and dt(meibox*10+meiboy+4+8,9)>0 {
        nextmode=2225
        chrno=meibox*10+meiboy+4+8
        sppage=0
        gosub *sppagemaxget
    }
    if mode=2225 and rmx!-1:nextmode=2220
    if mode=2230 and rmx!-1 and dt(meibox*10+meiboy+4+8,9)>0 {
        nextmode=2235
        motomeibox=meibox
        motomeiboy=meiboy
        motochrno=meibox*10+meiboy+4+8
    }
    if mode=2235 and rmx!-1 and dt(meibox*8+meiboy+4+8,9)>0 {
        nextmode=2230
        chrno=meibox*10+meiboy+4+8
        for ndt,0,8,1
            subdt(ndt)=dt(motochrno,ndt)
            dt(motochrno,ndt)=dt(chrno,ndt)
            dt(chrno,ndt)=subdt(ndt)
        next
        for ndt,9,199,1
            subdt(ndt)=dt(motochrno,ndt)
            dt(motochrno,ndt)=dt(chrno,ndt)
            dt(chrno,ndt)=subdt(ndt)
        next
        for ndt,201,713,1
            subdt(ndt)=dt(motochrno,ndt)
            dt(motochrno,ndt)=dt(chrno,ndt)
            dt(chrno,ndt)=subdt(ndt)
        next
    }
    if mode=2240 and rmx!-1 {
        nextmode=2245
        chrno=meibox*10+meiboy+4+8
        dim name,6
        kanamode=lung*2
        nameputx=0
        nameputy=0
        nameputx5y=lung*3
        namelen=0
        for nnamelen,0,6
            if dt(chrno,nnamelen)!255 {
                name(nnamelen)=dt(chrno,nnamelen)+1
                namelen=nnamelen+1
            }
        next
    }
    ;自分の店
    if mode=2300 and rmx!-1 {
        if dt(15,713+shopsely)=0 :nextmode=2310
        if dt(15,713+shopsely)>0 :dt(15,713+shopsely)=0:myshopitemhave(shopsely)=0

    }
    if mode=2310 and rmx!-1 {
        
        ;dt(15,713-722)=マイストア　売りに出しているもの 1-10 (0で何も売り出していない)
        ;dt(15,723-732)=マイストア　売れた金額 1-10 (1以上で売れた判定 0でまだ売れていない 1以上で２つ目は売らない)

        sellitemhaveno=713+itemselly+itemsellpage*itempmax
        
        if itemd(dt(8,sellitemhaveno),18)!1 {
            dt(15,713+shopsely)=dt(8,sellitemhaveno)
            nextmode=2300
        }
    }
    
    ;ねがいのいずみ
    if mode=2400 and izumiselokng(izumiy)=0 and rmx!-1 {
        nextmode=2410
        notesel q
        noteget msg(0),1624+lung
        msg(1)=nostr
        msg(2)=nostr
        mode2410waitcnt=15
    }
    if mode=2400 and izumiy=6 and rmx!-1:nextmode=1000
    if mode=2405 and rmx!-1:nextmode=1000
    if mode=2420 and rmx!-1:nextmode=1000
    if mode=2430 and rmx!-1:nextmode=2400

    ;バトルコマンド
    ;こうげき
    if mode=4020 and btlcomsely=0 and rmx!-1 {
        simode=0
        nextmode=4030
        oneorall=0;単体か全体か
        for nn,0,monmax
            if dt(nn,110)>0:spchrno_1=nn:spchrno_2=nn:_break
        next
        motomonspchrno=spchrno_1
        for nn,8,partymax+8
            if dt(nn,110)>0:motoispchrno=nn:_break
        next
    }
    ;ぼうぎょ
    if mode=4020 and btlcomsely=1 and rmx!-1 {
        simode=0
        dt(btlchrno,146)=1+(dtspecial(btlchrno,16)>0)*4
        btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
        usespno=1001
        nextmode=4010
        chrno_1=btlchrno
        gosub *btlmsgreset
        dim bdtkoukaonset,12,165
        gosub *autoheal
        if autohealonoff>0:nextmode=4040
    }
    ;スキル
    if mode=4020 and btlcomsely=2 and rmx!-1 {
        if dt(btlchrno,138)=0 {
            simode=0
            chrno=btlchrno
            nextmode=4110
        }
    }
    ;アイテム
    if mode=4020 and btlcomsely=3 and rmx!-1 {
        simode=1
        chrno=btlchrno
        nextmode=4160
    }
    ;装備
    if mode=4020 and btlcomsely=4 and rmx!-1 {
        simode=1
        chrno=btlchrno
        nextmode=4070
    }
    ;逃亡
    if mode=4020 and btlcomsely=5 and rmx!-1 {
        gosub *btlmsgreset
        notesel q
        noteget msgset1,900+lung
        noteget msgset2,898+lung
        btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
        plescape=0
        btlmsg(btlmsgmaxcnt)=msgset1
        n1=rnd(plspd*(10+dtspecial(8,3)*4))
        n2=rnd(monspd*10)
        if (n1>n2) and evebtl=0:plescape=1:btlmsg(btlmsgmaxcnt)=msgset2
        ;seon3=26
        btlmsgmaxcnt++
        nextmode=4100
    }
    ;攻撃対象決定
    if mode=4030 and rmx!-1 {
        btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
        nextmode=4040
        usespno=1000
        gosub *btlkoukaset
    }
    ;装備変更アイテムの選択 または使うor装備替える の選択肢へ
    if mode=4070 and rmx!-1 {
        ;使うor装備替える の選択肢へ
        nextmode=4075
        useeqipy=0
        ;もし使うことができない場合は 装備変更アイテムの選択
        okngitemno=dt(chrno,133+eqipy)
        gosub *itemuseokngsetone
        if (okngsetno!0) or (okngitemno=512) {
            nextmode=4080
            itemy=0
            itemsellpage=0
        }
    }
    if mode=4075 and rmx!-1 {
        ;if useeqipy=0は　mode=4160　と同じ処理をする
        if useeqipy=1 {
            nextmode=4080
            itemy=0
            itemsellpage=0
        }
    }
    ;スキル選択
    if ((mode=1030 and useseitonsely=0) or mode=4110) and rmx!-1 {
        if dt(7,201+spy+spselpage*sppmax)=0 {
            if mode=1030:btlchrno=chrno
            usespno=dt(btlchrno,201+spy+spselpage*sppmax)
            k1=spd(usespno,3)
            k2=spd(usespno,6)
            hanni=spd(usespno,8)
            hpzeroselmode=0
            if k1=20:hpzeroselmode=1
            ;自分
            if hanni=2 or k1=52 or k1=53 or k1=54 or k1=56 or k1=58 {
                chrno_1=btlchrno
                spchrno_1=btlchrno
                spchrno_2=btlchrno
                simode=0
                spitemno=usespno
                gosub *siduseset
                gosub *spitemchrselokngget
                if koukaokng(3)=0 or koukaokng(6)=0 {
                    if mode<4000:nextmode=1310
                    if mode>3999 {
                        nextmode=4040
                        btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
                    }
                    gosub *btlkoukaset
                }
            }
            ;一体または全体
            if hanni<2 {
                ;味方に使うスキル
                if k1=1 or k1=2 or k1=3 or k1=20 or k1=24 or k1=33 or k1=34 or k1=37 or k1=57 or k2=1 or k2=2 or k2=3 or k2=20 or k2=24 or k2=33 or k2=34 or k2=37 or k2=57 {
                    if mode=4110:nextmode=4120
                    if mode=1030:nextmode=1130
                    oneorall=10+hanni;単体か全体
                    if hanni=0 {
                        for nn,8,partymax+8
                            if (k1!20) and dt(nn,110)>0:spchrno_1=nn:spchrno_2=nn:_break
                            if (k1=20) :spchrno_1=nn:spchrno_2=nn:_break
                        next
                        motoispchrno=spchrno_1
                        for nn,0,monmax
                            if dt(nn,110)>0:motomonspchrno=nn:_break
                        next
                    }
                    if hanni=1:spchrno_1=8:spchrno_2=partymax+8-1
                }
                ;敵に使うスキル
                if k1=10 or k1=11 or k1=12 or k1=13 or k1=14 or k1=15 or k1=19 or k1=21 or k1=22 or k1=23 or k1=28 or k1=29 or k1=32 or k1=36 or k1=39 or k2=10 or k2=11 or k2=12 or k2=13 or k2=14 or k2=15 or k2=19 or k2=21 or k2=22 or k2=23 or k2=28 or k2=29 or k2=32 or k2=36 or k2=39 {
                    if mode=4110:nextmode=4120
                    if mode=1030:nextmode=1130
                    oneorall=0+hanni;単体か全体
                    if hanni=0 {
                        for nn,0,monmax
                            if (k1!20) and dt(nn,110)>0:spchrno_1=nn:spchrno_2=nn:_break
                            if (k1=20) :spchrno_1=nn:spchrno_2=nn:_break
                        next
                        motomonspchrno=spchrno_1
                        for nn,8,partymax+8
                            if dt(nn,110)>0:motoispchrno=nn:_break
                        next
                    }
                    if hanni=1:spchrno_1=0:spchrno_2=monmax-1
                } 
            }
        }
    }
    if mode=4112 and rmx!-1 and useseitonsely=0:nextmode=4110
    ;スキル選択時　対象を選択
    if (mode=4120 or mode=1130) and rmx!-1 {
        chrno_1=btlchrno
        simode=0
        spitemno=usespno
        gosub *siduseset
        gosub *spitemchrselokngget
        if koukaokng(3)=0 or koukaokng(6)=0 {
            if mode<4000:nextmode=1310
            if mode>3999 {
                nextmode=4040
                btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
            }
            gosub *btlkoukaset
        }
    }
    ;item選択
    if ((mode=1020 and useseitonsely=0) or mode=4160 or (mode=4075 and useeqipy=0)) and rmx!-1 {
        ;nnn=dt(11,713+itemy+itemsellpage*itempmax)
        if dt(10,713+itemy+itemsellpage*itempmax)=0 or (mode=4075 and useeqipy=0) {
            ;usespno=dt(btlchrno,713+spy+spselpage*sppmax)
            if mode=1020 or mode=4160:usespno=dt(8,713+itemy+itemsellpage*itempmax)
            if (mode=4075 and useeqipy=0):usespno=dt(chrno,133+eqipy)
            k1=itemd(usespno,3)
            k2=itemd(usespno,6)
            hanni=itemd(usespno,8)
            hpzeroselmode=0
            if k1=20:hpzeroselmode=1
            ;自分
            if hanni=2 or k1=52 or k1=53 or k1=54 or k1=56 or k1=58 or k1=61 {
                chrno_1=btlchrno
                spchrno_1=btlchrno
                spchrno_2=btlchrno
                simode=1
                spitemno=usespno
                gosub *siduseset
                gosub *spitemchrselokngget
                if koukaokng(3)=0 or koukaokng(6)=0 {
                    if mode<4000:nextmode=1300
                    if mode>3999 {
                        nextmode=4040
                        btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
                    }
                    gosub *btlkoukaset
                }
            }
            ;一体または全体
            if hanni<2 {
                ;味方に使うスキル
                if k1=1 or k1=2 or k1=3 or k1=20 or k1=24 or k1=33 or k1=34 or k1=37 or k1=57 or k1=60 or k2=1 or k2=2 or k2=3 or k2=20 or k2=24 or k2=33 or k2=34 or k2=37 or k2=57 {
                    if mode=1020:nextmode=1120
                    if mode=4160:nextmode=4165
                    if mode=4075:nextmode=4090
                    oneorall=10+hanni;単体か全体
                    if hanni=0 {
                        for nn,8,partymax+8
                            if (k1!20) and dt(nn,110)>0:spchrno_1=nn:spchrno_2=nn:_break
                            if (k1=20) :spchrno_1=nn:spchrno_2=nn:_break
                        next
                        motoispchrno=spchrno_1
                        for nn,0,monmax
                            if dt(nn,110)>0:motomonspchrno=nn:_break
                        next
                    }
                    if hanni=1:spchrno_1=8:spchrno_2=partymax+8-1
                }
                ;敵に使うスキル
                if k1=10 or k1=11 or k1=12 or k1=13 or k1=14 or k1=15 or k1=19 or k1=21 or k1=22 or k1=23 or k1=28 or k1=29 or k1=32 or k1=36 or k1=39 or k2=10 or k2=11 or k2=12 or k2=13 or k2=14 or k2=15 or k2=19 or k2=21 or k2=22 or k2=23 or k2=28 or k2=29 or k2=32 or k2=36 or k2=39 {
                    if mode=4160:nextmode=4165
                    if mode=4075:nextmode=4090
                    oneorall=0+hanni;単体か全体
                    if hanni=0 {
                        for nn,0,monmax
                            if (k1!20) and dt(nn,110)>0:spchrno_1=nn:spchrno_2=nn:_break
                            if (k1=20) :spchrno_1=nn:spchrno_2=nn:_break
                        next
                        motomonspchrno=spchrno_1
                        for nn,8,partymax+8
                            if dt(nn,110)>0:motoispchrno=nn:_break
                        next
                    }
                    if hanni=1:spchrno_1=0:spchrno_2=monmax-1
                } 
            }
        }
    }
    if mode=4162 and rmx!-1 and useseitonsely=0:nextmode=4160
    ;item選択時　対象を選択
    if (mode=1120 or mode=4165 or mode=4090) and rmx!-1 {
        chrno_1=btlchrno
        if mode=1120:chrno_1=spchrno_1
        simode=1
        spitemno=usespno
        gosub *siduseset
        gosub *spitemchrselokngget
        if koukaokng(3)=0 or koukaokng(6)=0 {
            if mode<4000:nextmode=1300
            if mode>3999 {
                nextmode=4040
                btlgauge(btlchrno)=0+rnd((dtspecial(btlchrno,18)>0)*20000+1)
            }
            gosub *btlkoukaset
        }
    }
    

return

*bbdan
    if mode=1001 and rmx!-1 :nextmode=1000
    if mode=1005 and rmx!-1 :nextmode=1000
    if mode=1010 and rmx!-1 :nextmode=1000:debugput=1-debugput:gosub *savedt
    if mode=1020 and rmx!-1 :nextmode=1022
    if mode=1021 and rmx!-1 :nextmode=1010
    if mode=1022 and rmx!-1 :nextmode=1010
