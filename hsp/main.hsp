                if (a=11 or a=12 or a=13) and putonoff=1  {
                    

                    d3getpos d3px1,d3py1,-r+lrpset,r+okuset,r+takaset
                    d3getpos d3px2,d3py2,r+lrpset,r+okuset,-r+takaset
                    
