return
        
*putbtl

    gmode 2
    
    if mode=4010:updownijouoffon=0
    
    for nn,0,8+partymax
    
        if dt(nn,110)>0 {

            ;状態異常・UP・DOWN効果のカウントを減らす
            ;ゼロになった場合はメッセージ追加
/*
;137=毒 138=封じ 139=眠り 140=呪い
;141=暗闇　142=混乱 143=とりつかれ 144-145=空き
;146=防御状態        0-off 1-on
;147-HP0自動復活    0-off 1-on
;148-かばう or ねらわれ        0=off 1=かばう -1=ねらわれ
;149-攻撃力UPorDOWN     値
;150-防御力UPorDOWN     値
;151-早さUPorDOWN     値
;152-カルマUPorDOWN     値
;153-魔力UPorDOWN     値
;154-物理攻撃回避率UPorDOWN    値
;155-クリティカル率UPorDOWN    値
;156-魔法ダメージUPorDOWN        値
;157=攻撃力UPorDOWN    継続カウンター
;158=防御力UPorDOWN    継続カウンター
;159=速さUPorDOWN        継続カウンター
;160-カルマUPorDOWN    継続カウンター
;161=魔力UPorDOWN        継続カウンター
;162-物理攻撃回避率UPorDOWN    継続カウンター
;163-クリティカル率UPorDOWN    継続カウンター
;164-魔法ダメージUPorDOWN        継続カウンター
            
*/
            if mode=4010 {
                ;137,144,157,165
                for ijoucntmainasu,137,165
                    if ijoucntmainasu=144:ijoucntmainasu=157
                    ;状態に変化があるかどうか
                    if (ijoucntmainasu<146 or ijoucntmainasu>156) and dt(nn,ijoucntmainasu)>0 and updownijouoffon=0 {

                        countdownn=1-rnd(2)
                        
                        ;状態異常が早く治るスキル
                        if dtspecial(nn,11)>0 and ijoucntmainasu<146 {
                            countdownn=2-rnd(6)
                        }
                        ;DOWN状態が早く治るスキル
                        if dtspecial(nn,11)>0 and ijoucntmainasu>156 {
                            if dt(nn,ijoucntmainasu-8)<0 {
                                countdownn=2-rnd(6)
                            }
                        }
                        ;UP状態が持続するスキル
                        if dtspecial(nn,17)>0 and ijoucntmainasu>156 {
                            if dt(nn,ijoucntmainasu-8)>0 {
                                if rnd(10)<5:countdownn=0
                            }
                        }
                        
                        ;カウンターを減らす
                        dt(nn,ijoucntmainasu)=dt(nn,ijoucntmainasu)-countdownn

                        
                        ;カウンターがゼロ以下になった場合
                        if dt(nn,ijoucntmainasu)<1 {
                            ;バトルメッセージの表示準備
                            if updownijouoffon=0 {
                                updownijouoffon=1
                                notesel q
                                gosub *btlmsgreset
                                dim bdtkoukaonset,12,165
                                 dim killon,12
                                ;バトルメッセージ表示モードにする
                                nextmode=4040
                            }
                            ;カウンターをゼロにする
                            dt(nn,ijoucntmainasu)=0
                            ;状態異常の回復
                            if ijoucntmainasu<144 {
                                noteget msgset1,788+(ijoucntmainasu-137)*2+lung
                                btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1
                                btlmsgmaxcnt++
                                btlmsgmaxcnt++
                                btlmsgmaxcnt++
                            }
                            ;UP・DOWN効果切れ
                            if ijoucntmainasu>156 {
                                noteget msgset1,712
                                noteget msgset2,844+(ijoucntmainasu-157)*2+lung
                                noteget msgset3,868
                                btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1
                                btlmsgmaxcnt++
                                btlmsg(btlmsgmaxcnt)=msgset2+msgset3
                                btlmsgmaxcnt++
                                btlmsgmaxcnt++
                                ;値をゼロにする
                                dt(nn,ijoucntmainasu-8)=0
                            }
                            
                        }
                        ;毒状態でHPを減らすタイミング
                        if (dt(nn,137)\45)=1 and ijoucntmainasu=137 and updownijouoffon=0 {
                            ;バトルメッセージの表示準備
                            if updownijouoffon=0 {
                                updownijouoffon=1
                                notesel q
                                gosub *btlmsgreset
                                dim bdtkoukaonset,12,165
                                 dim killon,12
                                ;バトルメッセージ表示モードにする
                                nextmode=4040
                            }
                            damage=rnd(dt(nn,108)/20+1)+dt(nn,108)/20+1
                            dt(nn,137)--
                            ;ダメージアニメーションのセット
                            if damage>0: btldmganm(nn)=5
                            ;効果の予約をセット
                            bdtkoukaonset(nn,110)=-damage                            
                            noteget msgset1,712+lung
                            noteget msgset2,470+lung
                            noteget msgset3,906+lung
                            noteget msgset4,714+lung
                            btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1+msgset2+msgset3
                            btlmsgmaxcnt++
                            btlmsg(btlmsgmaxcnt)=vzstr(damage,mbyte)+msgset4
                            btlmsgmaxcnt++
                            btlmsgmaxcnt++
                        }
                        ;とりつかれ状態でMPを減らすタイミング
                        if (dt(nn,143)\45)=1 and ijoucntmainasu=143 and updownijouoffon=0 {
                            ;バトルメッセージの表示準備
                            if updownijouoffon=0 {
                                updownijouoffon=1
                                notesel q
                                gosub *btlmsgreset
                                dim bdtkoukaonset,12,165
                                 dim killon,12
                                ;バトルメッセージ表示モードにする
                                nextmode=4040
                            }
                            damage=rnd(dt(nn,109)/20+1)+dt(nn,109)/20+1
                            dt(nn,143)--
                            ;ダメージアニメーションのセット
                            if damage>0: btldmganm(nn)=5
                            ;効果の予約をセット
                            bdtkoukaonset(nn,111)=-damage                            
                            noteget msgset1,712+lung
                            noteget msgset2,482+lung
                            noteget msgset3,906+lung
                            noteget msgset4,908+lung
                            btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1+msgset2+msgset3
                            btlmsgmaxcnt++
                            btlmsg(btlmsgmaxcnt)=vzstr(damage,mbyte)+msgset4
                            btlmsgmaxcnt++
                            btlmsgmaxcnt++
                        }
                    }
                next
            }

            ;バトルゲージの加算
            if mode=4010 and dt(nn,139)=0 and updownijouoffon=0 {
                btlgpnn=dt(nn,103)+dt(nn,151)+btlspdbouns
                if btlgpnn>1000:btlgpnn=1000
                btlgplus=(btlgpnn*10000/btlspd)
                if btlgplus<0:btlgplus=1
                if btlgplus>60000:btlgplus=60000
                motobtlgauge=btlgauge(nn)
                btlgauge(nn)=btlgauge(nn)+btlgplus
                if btlgauge(nn)>59999:btlgauge(nn)=60000
                if btlgauge(nn)<0:btlgauge(nn)=0
            }

            ;バトルゲージ表示
            ;敵
            if nn<8 and nn<monmax {
                gpx=monputx(nn)*mongpbai+pxp+((monbtlsize(nn)*mongpbai)-62)/2
                gpy=450+pyp
                if mode<4200 and mode>4019 and btlchrno=nn and updownijouoffon=0:gpy=gpy-(tenpcnt=0)*800
            }
            ;味方
            if nn>7 {
                gpx=(nn-8)*120+(120-62)/2
                gpy=118+pyp
                if mode<4200 and mode>4019 and btlchrno=nn and updownijouoffon=0:gpy=gpy+24-(tenpcnt=0)*200
            }
            boli 0,gpx,gpy,gpx+62,gpy+6
            gaugelen=btlgauge(nn)/1000
            boli 0,gpx+1,gpy+3,gpx+gaugelen,gpy+3
            
        }
        
        ;if btldmganm(nn)>0:btldmganm(nn)--
    next
    
    ;モングラ
    for nn,0,monmax
        ;ダメージを受けるアニメーション
        if dt(nn,110)>0 {
            dmggppx=0
            dmggppy=0
            if (btldmganm(nn)>0) {
                dmggppx=dmggppx-15+rnd(30)
                dmggppy=dmggppy-15+rnd(30)
            }
            if mode<4200 and mode>4019 and btlchrno=nn and updownijouoffon=0:dmggppy=dmggppy+24
            mongppx=monputx(nn)*mongpbai+dmggppx
            mongppy=128+dmggppy
            pos mongppx,mongppy
            gzoom monbtlsize(nn)*mongpbai,64*mongpbai,2,mongetpos(nn,0),mongetpos(nn,1),mongetpos(nn,2)-mongetpos(nn,0),mongetpos(nn,3)-mongetpos(nn,1)
            
        }
    next
    
    ;バトルゲージが満タンかどうか　反撃するかどうか
    if (mode=4010) and (updownijouoffon=0) {
        gaugefull=0
        for nn,0,8+partymax
            ;敵
            if gaugefull=0 and nn<8 and btlgauge(nn)>59999 and dt(nn,110)>0 {
                btlgauge(nn)=0
                if dt(nn,146)>0:dt(nn,146)--
                btlchrno=nn
                gosub *btlautoset
                gaugefull=1
            }
            ;敵の反撃
            if gaugefull=0 and nn<8 and btlgauge(nn)<60000 and dt(nn,110)>0 {
                if doflag(nn)>0 and doflag(nn)<3 {
                    btlgauge(nn)=0
                    if dt(nn,146)>0:dt(nn,146)--
                    btlchrno=nn
                    gosub *btlautoset
                    gaugefull=1
                }
            }
            ;味方
            if gaugefull=0 and nn>7 and btlgauge(nn)>59999 and dt(nn,110)>0 {
                nextmode=4020
                btlchrno=nn
                if dt(nn,146)>0:dt(nn,146)--
                gaugefull=1
                
                ;混乱の場合
                if dt(nn,142)>0 {
                    btlgauge(nn)=0+rnd((dtspecial(nn,18)>0)*20000+1)
                    gosub *btlautoset
                }
            }
        next
    }
        
    ;てきしゅつげんを表示
    if btlstartmode=1:gosub *putbtlmes
    /*
    color 255,255,255
    
    for nn,0,monmax
    pos nn*32,0:mes monputx(nn)
    pos nn*32,16:mes mongetpos(nn,1)
    next
    
    for nn,0,4
    pos nn*32,128
    mes monandmontest(nn)
    next
    
    for nn,0,6
        pos nn*32,32
        mes ;btlsetmon(nn)
        mes msetfrd(nn)
    next
    
    for nn,0,monmax
        pos nn*32,64:mes btlmon(nn)
    next
    pos 0,80:mes "monmax "+str(monmax)
    pos 0,96:mes "monsetrndno "+str(monsetrndno)
    */
    
return

*putbtlcom

    btlcompmax=6
    btlcomputy=480-8-32*(btlcompmax)
    btlcompxset=0
    btlcompyset=462
    pxwidth=120
    pywidth=36
    strpyplus=(pywidth-24)/2
    
    boli 4,btlcompxset-120,btlcompyset,btlcompxset,btlcompyset+pywidth*2
    boli 1,btlcompxset,btlcompyset,btlcompxset+3*pxwidth+2,btlcompyset+2*pywidth+2
    notesel q

/*
    ;名前
    namechrno=btlchrno
    gosub *plnameget
    pxx=btlcompxset-120+8
    pyy=btlcompyset+pywidth/2+strpyplus
    strp chrname,pxx,pyy,mbyte
*/
    for n,0,btlcompmax,1
        
        px=btlcompxset+(n/2)*pxwidth+2
        py=(n\2)*pywidth+btlcompyset+2
        selbox ((btlcomsely=n) and (cslpcnt=1)),px,py,px+pxwidth,py+pywidth,mx,my

        
            gmulcolor 255,255,255
            strpq 700+n*2+lung,px+24,py+strpyplus,mbyte,q
            gmulcolor 255,255,255
        
        
            if rmx>px and rmy>py and rmx<px+pxwidth and rmy<py+pywidth {
                if btlcomsely=n:rmx=0:btlcomsely=n:gosub *badan
                if btlcomsely!n:btlcomsely=n
            }

    next

return

*putbtlchrsel

    gmode 2
    
    for nn,0+(mode<4000)*8,8+partymax
    
        ;カーソル・タッチ位置の設定
        if nn<8 {
            px1=monputx(nn)*mongpbai
            py1=128
            px2=px1+monbtlsize(nn)*mongpbai
            py2=py1+64*mongpbai+32
            mgploadseln=mond(btlmon(nn),0)
            py1plus=0
            if chrpudpos(mgploadseln)=0:py1plus=64-chrgpysize(mgploadseln)-20/mongpbai
            if chrpudpos(mgploadseln)=1:py1plus=(64-chrgpysize(mgploadseln))/2-20/mongpbai
            
            py1=py1+py1plus*mongpbai
        }
        if nn>7 {
            px1=(nn-8)*120
            py1=0+(mode>4019 and mode<4200 and btlchrno=nn)*24
            px2=px1+120
            py2=py1+128
        }
        
        cslhpzero=0
        if hpzeroselmode=0 and dt(nn,110)>0:cslhpzero=1
        if hpzeroselmode=1:cslhpzero=1        
        
        ;タッチで直接選択
        if rmx>px1 and rmy>py1 and rmx<px2 and rmy<py2-(nn<8)*24 {
            ;oneorall=0 ;バトル時の対象選択モード 0=敵単体 1=敵全体 10=味方単体 11=味方全体

            if mode=4020:oneorall=(nn>7)*10

            ;単体
            if cslhpzero=1 and (oneorall\10)=0 {
                if nn>7 and spchrno_1<8:motomonspchrno=spchrno_1:oneorall=10
                if nn<8 and spchrno_1>7:motoispchrno=spchrno_1:oneorall=0
                if mode=4020:nextmode=4030
                if (mode=4030 or mode=4090 or mode=4120 or mode=4165) and nn=spchrno_1:rmx=0:gosub *badan
                spchrno_1=nn:spchrno_2=nn
            }
            
            ;全体
            if (oneorall\10)=1 {
                if (mode=4030 or mode=4090 or mode=4120 or mode=4165) and ((nn<8 and oneorall=1) or (nn>7 and oneorall=11)):rmx=0:gosub *badan
                if nn<8:spchrno_1=0:spchrno_2=monmax-1:oneorall=1
                if nn>7:spchrno_1=8:spchrno_2=partymax+8-1:oneorall=11
                if mode=4020:nextmode=4030
            }
        }
        ;カーソル表示
        if (mode!4020) and nn>spchrno_1-1 and nn<spchrno_2+1 and cslhpzero=1 and (cslpcnt=1) {
            pos px1,py1
            gzoom 32,32,1,0,96,8,8
            pos px2-32,py1
            gzoom 32,32,1,8,96,8,8
            pos px1,py2-32
            gzoom 32,32,1,0,104,8,8
            pos px2-32,py2-32
            gzoom 32,32,1,8,104,8,8
        }

        ;名前を表示 一体を選択しているときのみ　全体を選択している時は表示しない
        if (mode!4020) and nn<8 and (spchrno_1=spchrno_2) and nn>spchrno_1-1 and nn<spchrno_2+1 and cslhpzero=1 {

            namelen=strlen(btlchrnmstr(nn))/mbyte
            monnmpx=monputx(nn)*mongpbai

            mongpwide=mongetpos(nn,2)-mongetpos(nn,0)
            monnmpx=monnmpx+(mongpwide*mongpbai)/2-namelen*(8-lung*2)
            if monnmpx<0:monnmpx=0
            if monnmpx+namelen*(16-lung*4)>479:monnmpx=480-namelen*(16-lung*4)

            strp btlchrnmstr(nn),monnmpx,py2+8,mbyte
                
        }
    next
    
    ;使うことができない
    dim koukaokng,7
    if mode=1130 or mode=4120 {
        chrno_1=btlchrno
        simode=0
        spitemno=usespno
        gosub *siduseset
        gosub *spitemchrselokngget
    }
    if (mode=1120 or mode=4165 or mode=4090) {
        chrno_1=btlchrno
        simode=1
        spitemno=usespno
        gosub *siduseset
        gosub *spitemchrselokngget
    }
    if (koukaokng(3)!0) and (koukaokng(6)!0) {
        noteget infostrset,1120+koukaokng(3)*2+lung
        if spchrno_1<8:py=512
        if spchrno_1>7:py=150
        boli 4,0,py,478,py+22
        if (tenpcnt=1):strp infostrset,8,py+3,mbyte        
    }


return

;使う or 装備する
*putbtleqipcom

    for n,5,-1,-1
        btn(n)=0
    next
    
    useeqipupy=512
    
    

    for yesnon,0,2
        selbox ((useeqipy=yesnon) and (cslpcnt=1)),2+pxp,useeqipupy-40+yesnon*36+pyp,477+pxp,useeqipupy-4+yesnon*36+pyp,mx,my
        if rmx>0+pxp and rmy>(useeqipupy-40+yesnon*36+pyp) and rmx<480+pxp and rmy<(useeqipupy-4+yesnon*36+pyp) {
            if useeqipy=yesnon or dt(8,1290)=1:cmx=0:rmx=0:meswaitput=0:useeqipy=yesnon:gosub *badan
            if useeqipy!yesnon:useeqipy=yesnon
        }
        
        gmulcolor 255,255,255
        if yesnon=0 and eqipitemuseokng=1:gmulcolor 127,127,127
        strpq 894+yesnon*2+lung,32+pxp,(useeqipupy-40+yesnon*36+pyp)+6,mbyte,q;lung
        gmulcolor 255,255,255

    next
    
    boli 0,0+pxp,useeqipupy-40-2,478,useeqipupy-4+36
    
    if useeqipy=0 and eqipitemuseokng=1 {
        noteget infostrset,1120+koukaokng(3)*2+lung
        py=320
        boli 4,0,py,478,py+22
        if (tenpcnt=1):strp infostrset,8,py+3,mbyte        
    }

return

*putdanoutsidedelete
    ;(高速化) 判定は putdan の oku ループ先頭で lrpg(0-4)ごとに計算済み(*putdanoutsidetable)
    if pdoOn {
        frskydput=pdoFd
        mekakushikado=pdoMk(lrpg)
        if pdoA62(lrpg) :a=62
    }
return

*putdanoutsidetable
    ;putdanoutsidedelete の判定は okug/lrpg/frsize/ix/iy/ins/iwe/frskyd(fr) だけで決まる。
    ;oku ループ1周の間は lrpg(0-4)ごとに一定なので、先に5通りを計算しておく
    pdoOn=0:mekakushikado=0
    if fr<128 and frskyd(fr)>0 :pdoOn=1
    if pdoOn {
        pdoFd=frskyd(fr)\1000
        for pdoi,0,5
            pdoM=0:pdoA=0
            if ins=0 and iwe=-1 and ix-oku-1-(pdoFd-1)<(128-(frsize/2)) :pdoM=1
            if ins=0 and iwe=1 and ix+oku+1+(pdoFd-1)>(128+(frsize/2)+1) :pdoM=1
            if ins=1 and iwe=0 and iy-oku-1-(pdoFd-1)<(128-(frsize/2)-1) :pdoM=1
            if ins=-1 and iwe=0 and iy+oku+1+(pdoFd-1)>(128+(frsize/2)) :pdoM=1
            ;左端
            if ins=0 and iwe=-1 and ix-oku-(pdoFd-1)<(128-(frsize/2)) :pdoA=1
            if ins=-1 and iwe=0 and ix+pdoi-3-(pdoFd-1)<(128-(frsize/2)) :pdoA=1
            if ins=1 and iwe=0 and ix-pdoi+1-(pdoFd-1)<(128-(frsize/2)) :pdoA=1
            ;右端
            if ins=0 and iwe=1 and ix+oku+(pdoFd-1)>(128+(frsize/2)+1) :pdoA=1
            if ins=-1 and iwe=0 and ix+pdoi-1+(pdoFd-1)>(128+(frsize/2)+1) :pdoA=1
            if ins=1 and iwe=0 and ix-pdoi+3+(pdoFd-1)>(128+(frsize/2)+1) :pdoA=1
            ;下端
            if ins=1 and iwe=0 and iy-oku-(pdoFd-1)<(128-(frsize/2)-1) :pdoA=1
            if ins=0 and iwe=-1 and iy+pdoi-3-(pdoFd-1)<(128-(frsize/2)-1) :pdoA=1
            if ins=0 and iwe=1 and iy-pdoi+1-(pdoFd-1)<(128-(frsize/2)-1) :pdoA=1
            ;上端
            if ins=-1 and iwe=0 and iy+oku+(pdoFd-1)>(128+(frsize/2)) :pdoA=1
            if ins=0 and iwe=-1 and iy+pdoi-1+(pdoFd-1)>(128+(frsize/2)) :pdoA=1
            if ins=0 and iwe=1 and iy-pdoi+3+(pdoFd-1)>(128+(frsize/2)) :pdoA=1
            pdoMk(pdoi)=pdoM
            pdoA62(pdoi)=pdoA
        next
    }
return

*putdan
    if pdoDimmed=0 {
        dim pdoMk,8
        dim pdoA62,8
        dim putdmap,5
        putdmap(0)=0:putdmap(1)=4:putdmap(2)=1:putdmap(3)=3:putdmap(4)=2
        buffer 9,480,440,screen_offscreen    ;(高速化) 待機中の3D描画結果のキャッシュ用
        buffer 10,480,360,screen_offscreen   ;(高速化) ミニマップ枠のタイル画像のキャッシュ用
        gsel 0
        pdcValid=0
        pdoDimmed=1
    }

    ;(高速化) 待機中(移動・旋回していない)で位置・向き・階・マップ表示データ・空の位置が
    ;  前回描いたときと同じなら、3Dを描き直さず前回の絵をコピーするだけにする。
    ;  泉(アニメあり)が見えているときはキャッシュしない。mode=1000 以外ではキャッシュを捨てる。
    pdcEligible=0
    pdcSkyDone=0
    pdcHitNow=0    ;今フレームの3Dをキャッシュから出したか(ミニマップのキャッシュが参照する)
    if mode!1000:pdcValid=0
    if mode=1000 and idocnt=0 {
        ;空のスクロールは通常経路と同じ式で進める(通常経路側では二重に進めない)
        skypx=0.4+skypx
        if skypx>1024*8-1:skypx=skypx-1024*8
        pdcSkyDone=1
        pdcEligible=1
        pdcSky=0
        if pdcSkyUsedC=1:pdcSky=int(skypx/8)
        if pdcValid=1 and pdcVer=putdver and pdcFr=fr and pdcIx=ix and pdcIy=iy and pdcIns=ins and pdcIwe=iwe and pdcSkyK=pdcSky {
            ;カメラ状態は通常経路の待機時と同じにしておく(他の処理が d3getpos 等で参照するため)
            d3wincy=220
            d3setcam 0, setcomichi, 0,0,0,0,1.3
            camdirty=0
            gmode 0
            pos 0,0
            gcopy 9,0,0,480,440
            gmode 2
            color 0,0,0
            boxf 0,440,480,800
            pdcSkyDone=0
            pdcHitNow=1
            return
        }
    }
    pdcNoCache=0
    pdcSkyUsed=0

    idocntplus=250
    if idocntnext=2 or idocntnext=3:idocntplus=50
        
        
    if idocnt>0:idocnt=idocnt-idocntplus
    if idocnt<0:idocnt=0
        
    cammaeato=0
    cammlr=0
    camtakasa=0
    ;cammaeato=idocnt
    ;if idocnt>500:cammaeato=cammeto-1000

    ;前進
    if idocntnext=0 {
        cammaeato=idocnt
        if idocnt>500:cammaeato=cammaeato-1000
        if idocnt=500 {
            if ins=-1 and iwe=0:iy++
            if ins=1 and iwe=0:iy--
            if ins=0 and iwe=-1:ix--
            if ins=0 and iwe=1:ix++
            gosub *mappidset
            ;gosub *takaratrapcountdown
        }
    }
    ;後退
    if idocntnext=1 {
        cammaeato=-idocnt
        if idocnt>500:cammaeato=cammaeato+1000
        if idocnt=500 {
            if ins=-1 and iwe=0:iy--
            if ins=1 and iwe=0:iy++
            if ins=0 and iwe=-1:ix++
            if ins=0 and iwe=1:ix--
            gosub *mappidset
            ;gosub *takaratrapcountdown
        }
    }
    ;左を向く
    if idocntnext=2 {
        if idocnt=850 {
            idocnt=100
            if ins=-1 and iwe=0 { ins=0:iwe=-1:gosub *mappidset:btlstartonoff=1 } else {
                if ins=1 and iwe=0 { ins=0:iwe=1:gosub *mappidset:btlstartonoff=1 } else {
                    if ins=0 and iwe=-1 { ins=1:iwe=0:gosub *mappidset:btlstartonoff=1 } else {
                        if ins=0 and iwe=1 { ins=-1:iwe=0:gosub *mappidset:btlstartonoff=1 } else {
                        }
                    }
                }
            }
        }
        cammlr=idocnt
        if idocnt>500:cammlr=cammlr-1000
    }
    ;右を向く
    if idocntnext=3 {
        if idocnt=850 {
            idocnt=100
            if ins=-1 and iwe=0 { ins=0:iwe=1:gosub *mappidset:btlstartonoff=1 } else {
                if ins=1 and iwe=0 { ins=0:iwe=-1:gosub *mappidset:btlstartonoff=1 } else {
                    if ins=0 and iwe=-1 { ins=-1:iwe=0:gosub *mappidset:btlstartonoff=1 } else {
                        if ins=0 and iwe=1 { ins=1:iwe=0:gosub *mappidset:btlstartonoff=1 } else {
                        }
                    }
                }
            }
        }
        cammlr=-idocnt
        if idocnt>500:cammlr=cammlr+1000
    }
    ;のぼる
    if idocntnext=4 {
        camtakasa=-idocnt
        cammlr=0
    }
    ;おりる
    if idocntnext=5 {
        camtakasa=idocnt
        cammlr=0
    }
        
    d3wincy=220
    d3setcam 0, setcomichi-cammaeato, camtakasa,0+cammlr*2,0,camtakasa,1.3
    camdirty=0
    
        
    if pdcSkyDone=0:skypx=0.4+skypx    ;待機中の経路では冒頭で進め済み
