*evescreenlocateget
    
    evegono=111111
    repeat pmas*pmas
        epx=-1
        epy=-1
        evepidcnton=0
        mappset=0
        pcnt=cnt
        px=(pcnt\pmas)
        py=(pcnt/pmas)
        if evemapset(ix+px-8,iy+py-8,0)=1 {
            if evemapset(ix+px-8,iy+py-8,1)=evecheckno {
                evegono=evemapset(ix+px-8,iy+py-8,1)
                pid=pcnt
                epx=ix+px-8
                epy=iy+py-8
            }
        }
        if (epx!-1) and (epy!-1):break
    loop

return
    
*itemuseokngset

    ;0=使用可能 1=戦闘用です 2=移動用です 3=MPが足りません 4=常に効果があります
    ;5=すでに使っています 6=ここでは使えません 7=必要ありません
    ;8=キーアイテム 9=なし
    ;10=武器ではありません 11=防具ではありません 12=装具ではありません 13=装備できません
    ;11=すでに転職ができます
    ;19=すてることができません

    ;使えるかどうかをリセットする
    for nnnnnn,713,1225
        dt(10,nnnnnn)=0
    next        
    
    for nnnnnn,713,1225
    
        okngsortno=dt(11,nnnnnn)
    
        if okngsortno=1226 :okngsortno=nnnnnn
    
        okngitemno=dt(8,okngsortno)
    
        gosub *itemuseokngsetone
            

    
        dt(10,okngsortno)=okngsetno
    
    next

return
    
*itemuseokngsetone
    
    okngsetno=0
    
    ;キャンプアイテム　使用時期＝戦闘中or× or 使用効果１も２も無しの場合は選択・使用不可
    if (nextmode=1020 or nextmode=1021 or mode=1020) {
        ;戦闘用
        if itemd(okngitemno,9)=2 and useseitonsely=0 :okngsetno=1;dt(10,okngsortno)=1
        ;使用効果無し（装備品など）
        if itemd(okngitemno,3)=0 and useseitonsely=0 :okngsetno=9;dt(10,okngsortno)=1
        ;捨てられない
        if itemd(okngitemno,18)=1 and useseitonsely=3 :okngsetno=19;dt(10,okngsortno)=1
    }
    
    ;装備の可不可
    if (nextmode=1080 or nextmode=1180 or nextmode=1181 or nextmode=4080 or nextmode=4081) {
        if okngsortno!1225:if itemd(okngitemno,58+dt(chrno,10))=0:okngsetno=13;dt(10,okngsortno)=13
        ;はずす欄の場合
        if okngsortno=1225 {
            okngsetno=0;dt(10,okngsortno)=0
            if dt(chrno,133+eqipy)=512:okngsetno=-1;dt(10,okngsortno)=-1
        }
    }
    
    ;バトルアイテム
    if nextmode=4160 or nextmode=4161 or nextmode=4075 {
        ;移動用
        if itemd(okngitemno,9)=1:okngsetno=2;:dt(10,okngsortno)=1
    }
    
    ;キャンプ・バトル
    if (nextmode!1020) and (nextmode!1080) and (nextmode!1180) and (nextmode!1181) and (nextmode!4080) and (nextmode!4081) and okngitemno<512 {
        ;使用時期＝× or 使用効果１も２も無し
        if (itemd(okngitemno,9)=3) or (itemd(okngitemno,3)=0 and itemd(okngitemno,6)=0):okngsetno=9;dt(10,okngsortno)=9
        
        spitemno=okngitemno
        simode=1
        gosub *siduseset
        ;効果範囲が　全体または一体
        ;if itemd(okngitemno,8)<2:gosub *spitemuseokngget            
        ;効果範囲が　本人
        if itemd(okngitemno,8)=2 {
            ;バトル時
            if mode>3999 {
                spchrno_1=btlchrno
                spchrno_2=btlchrno
                gosub *spitemchrselokngget    
            }
            ;キャンプ時は使用できない
            if mode<4000 {
                dim koukaokng,7
                okngsetno=1
            }
        }
        
        ;if ((koukaokng(3)!0) or itemd(okngitemno,3)=0) and ((koukaokng(6)!0) or itemd(okngitemno,6)=0):okngsetno=7;dt(10,okngsortno)=7
    }

return

*spuseokngset

    for nnn,201,713
        ;0=使用可能 1=戦闘用です 2=移動用です 3=MPが足りません 4=常に効果があります
        ;5=すでに使っています 6=ここでは使えません 7=必要ありません
        ;8=キーアイテム 9=なし 10=今は使えません（ワープ禁止等のタイミング）
        ;11=すでに転職ができます 12=もちものがいっぱいです 13=のろわれています・・・
    
        dt(7,nnn)=0
        nn=dt(chrno,nnn)
        ;キャンプスキル
        if (nextmode=1030 or nextmode=1031) {
            ;戦闘用
            if spd(nn,9)=2:dt(7,nnn)=1
        }

        ;バトルスキル
        if (nextmode=4110 or nextmode=4111) {
            ;移動用
            if spd(nn,9)=1:dt(7,nnn)=2
        }
    
        ;キャンプ・バトル
        if (nextmode!1040) and (nextmode!1041) and nn<512 {
    
            ;使用時期＝× or 使用効果１も２も無し
            if (spd(nn,9)=3) or (spd(nn,3)=0 and spd(nn,6)=0):dt(7,nnn)=9
    
            ;MPが足りない
            if (spd(nn,0)>dt(chrno,111)):dt(7,nnn)=3
    
            ;使用時期＝× or 使用効果１も２も無し
            if (spd(nn,3)=44) or (spd(nn,6)=44):dt(7,nnn)=4
    
            spitemno=nn
            simode=0
            gosub *siduseset
            ;効果範囲が　全体または一体
            ;if spd(nn,8)<2:gosub *spitemuseokngget            
            ;効果範囲が　本人
            if spd(nn,8)=2 {
                ;バトル時
                if mode>3999 {
                    spchrno_1=btlchrno
                    spchrno_2=btlchrno
                    gosub *spitemchrselokngget    
                }
                ;キャンプ時は使用できない
                if mode<4000 {
                    dim koukaokng,7
                    dt(7,nnn)=1
                }
            }
    
            ;if (koukaokng(3)!0) and (koukaokng(6)!0):dt(7,nnn)=7
        }
        
    next

return
    
*spitemuseokngget

    ;各効果に対しての必要不要
    
    dim koukaokng,7
    
    for koukano,3,7,3

        ;敵味方全員HP全回復済み
        if siduse(koukano)=1 and siduse(8)=1 {
            useokngcheck=0
            for nnnn,0,12:useokngcheck=useokngcheck+(dt(nnnn,108)-dt(nnnn,110)):next
            if useokngcheck=0:koukaokng(koukano)=7
        }
    
        ;敵味方全員MP全回復済み
        if siduse(koukano)=2 and siduse(8)=1 {
            useokngcheck=0
            for nnnn,0,12:useokngcheck=useokngcheck+(dt(nnnn,109)-dt(nnnn,111)):next
            if useokngcheck=0:koukaokng(koukano)=7
        }
    
        ;敵味方誰もHPゼロではない
        if siduse(koukano)=20 and siduse(8)=1 {
            useokngcheck=0
            if mode>3999:for nnnn,0,monmax:useokngcheck=useokngcheck+(dt(nnnn,110)<1):next
            for nnnn,8,8+partymax:useokngcheck=useokngcheck+(dt(nnnn,110)<1):next
            if useokngcheck=0:koukaokng(koukano)=7
        }

        ;敵味方全員呪われている
        if (siduse(koukano)=1 or siduse(koukano)=2 or siduse(koukano)=20) and siduse(8)=1 {
            useokngcheck=0
            for nnnn,0,12:useokngcheck=useokngcheck+(dt(nnnn,140)>0):next
            if useokngcheck=monmax+partymax:koukaokng(koukano)=13
        }

        ;敵味方全員各状態異常無し
        if siduse(koukano)=3 and siduse(koukano-2)<7 and siduse(8)=1 {
            useokngcheck=0
            nnnnnnnn=siduse(koukano-2)
            if mode>3999:for nnnn,0,monmax:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnnnn)>0):next
            for nnnn,8,8+partymax:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnnnn)>0):next
            if useokngcheck=0:koukaokng(koukano)=7
        }
    
        ;敵味方全員全状態異常無し
        if siduse(koukano)=3 and siduse(koukano-2)=8 and siduse(8)=1 {
            useokngcheck=0
            for nnnnnn,0,7
                if mode>3999:for nnnn,0,monmax:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnn)>0):next
                for nnnn,8,partymax+8:useokngcheck=useokngcheck+(dt(nnnn,137+nnnnnn)>0):next
            next
            if useokngcheck=0:koukaokng(koukano)=7
        }
        ;効果無し
        if siduse(koukano)=0 {
            koukaokng(koukano)=99
        }
    next

return

