                ssfu=-1
                noteget str1,924+lung
                btlmsg(btlmsgmaxcnt)=str1
                btlmsgmaxcnt++
                nextmode=4040
                for nn,0,monmax
                    btlgauge(nn)=59999
                next
                for nn,8,partymax+8
                    btlgauge(nn)=0+rnd((dtspecial(nn,18)>0)*20000+1)
                next
            }
            
            ;味方の先制攻撃
            if nnnsf>(980-(dtspecial(8,2)*50)) and (evebtl=0)  {
                btlstartmode=0
                ssfu=1
                noteget str1,922+lung
                btlmsg(btlmsgmaxcnt)=str1
                btlmsgmaxcnt++
                nextmode=4040
                for nn,8,partymax+8
                    btlgauge(nn)=59999
                next
                for nn,0,monmax
                    btlgauge(nn)=0
                next
            }

        }
    }

