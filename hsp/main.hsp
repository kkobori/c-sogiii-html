                dt(nn,104)=mond(btlmon(nn),18);器用さ
                dt(nn,106)=mond(btlmon(nn),19);魔力
                dt(nn,108)=mond(btlmon(nn),13);MAXHP
                dt(nn,109)=mond(btlmon(nn),14);MAXMP
