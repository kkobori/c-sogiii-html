        chrno=chrsely+8
        for ndt,0,8,1
            subdt(ndt)=dt(chrselmtsorty+8,ndt)
            dt(chrselmtsorty+8,ndt)=dt(chrno,ndt)
            dt(chrno,ndt)=subdt(ndt)
        next
        for ndt,9,199,1
            subdt(ndt)=dt(chrselmtsorty+8,ndt)
            dt(chrselmtsorty+8,ndt)=dt(chrno,ndt)
