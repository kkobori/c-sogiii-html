        selchrboxmodecolor=127
    }
    if mode=1030 or mode=1032 or mode=1038 or mode=1039 or mode=1130 {
        ;selchrputy=384
        selchrboxmode=3
        selchrboxmodecolor=127
    }
    
    boli selchrboxmode,0+pxp,selchrputy-32*(partymax-1)+pyp,134+pxp,selchrputy+38+pyp
    
    for n,8,partymax+8,1
    
        npx=n-8
    
        pxx=32+pxp
        pyy=selchrputy+8-32*(partymax-1)+npx*32+pyp
        
        gmulcolor selchrboxmodecolor,selchrboxmodecolor,selchrboxmodecolor        
        
        if selchrboxmode!4 {
            
            ;カーソルの表示方法
            cslputmode=(chrsely=npx)
            ;カーソルを点滅させる
            if mode=1035 or mode=1040 or mode=1045 or mode=1050 or mode=1135 or mode=1185 or mode=2190 {
                ;cslputmode=((itemy=n) and (cslpcnt=1))
                cslputmode=((chrsely=npx) and (cslpcnt=1))
            }
            ;入れ替え時に一つ目のカーソルを表示させる
            if mode=1045 and chrselmtsorty=npx {
                cslputmode=cslputmode+2
            }
            /*
            ;カーソルの表示方法
            cslputmode=(itemy=n)
            ;カーソルを点滅させる
            if mode=1020 or mode=1028 or mode=1029 or mode=1180 or mode=4160 {
                cslputmode=((itemy=n) and (cslpcnt=1))
            }
            ;入れ替え時に一つ目のカーソルを表示させる
            if mode=1029 and itemselmtsortpage=itemsellpage and itemselmtsorty=n {
                cslputmode=cslputmode+2
            }
*/
            selbox cslputmode,0+pxp+4,pyy-4,134+pxp-3,pyy+28,mx*(selchrboxmode!3),my
        
            if rmx>0+pxp+4 and rmy>pyy-4 and rmx<134+pxp-3 and rmy<pyy+28 and (selchrboxmode!3) {
                if mode=1041:nextmode=1040
                if mode=1035:sppage=0:chrno=n:gosub *spuseokngset:gosub *sppagemaxget
                if chrsely=npx {
                    gosub *badan
                    if mode=2190:_break
                } else {
                    chrsely=npx
                    if mode=1040 or mode=1041:gosub *badan
                    if dt(8,1290)=1:gosub *badan:if nextmode!mode:_break;選択モード=同時
                }
            }
        }
        if selchrboxmode=4 and (chrsely=npx) {
            pos 0+pxp+4+6,pyy
            gzoom 16,24,1,1872,24,16,24
    
        }


        namechrno=n
        gosub *plnameget
        strp chrname,pxx,pyy,mbyte

    next
/*
    if mode=1040 {
