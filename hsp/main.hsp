*trapitemerase

    stealok=0
    iereasemax=0
    dim ierease,512
        
    for nnnnn,0,511,1
        n9=nnnnn
        ;破棄ができるか　0=できる
        n2=itemd(dt(8,713+nnnnn),18)
        ;アイテムを持っていてかつ破棄が可能である物を探す
        if dt(8,713+nnnnn)!512 and n2=0 {
            ;破棄可能なアイテムを登録する
            ierease(iereasemax)=nnnnn
            ;破棄可能なアイテムをいくつ持っているか
