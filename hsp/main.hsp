*putgamedata
        
    putgdx=0
    putgdy=320
        

    ;先頭者の名前を取得
    sdim slnm,20,6
    
    notesel q
    for nnsl,0,10
        for namen1,0,6,1
            a=slnmint(nnsl,namen1)+1
            noteget b,a
            if (a-1)!255:slnm(nnsl)=slnm(nnsl)+b
        next
    next

        
    color 255,255,255
        
    for nnsldata,0,10
        
        putgdnnx=putgdx+(nnsldata/5)*240
        putgdnny=putgdy+(nnsldata\5)*40

        selbox (((sldataselx*5+sldatasely)=nnsldata) and (cslpcnt=1)),putgdnnx,putgdnny,putgdnnx+239,putgdnny+39,mx,my
        
        
        if sllv(nnsldata)>0 {
        
            ;LVという文字
            pos putgdnnx+32,putgdnny+8
            if sllv(nnsldata)<1000 {
                gzoom 16,24,1,0,72,16,24
            }

            varp sllv(nnsldata),putgdnnx+40,putgdnny+8,4,1

            strp slnm(nnsldata),putgdnnx+112,putgdnny+8,mbyte
        } else {
            ;でーたなしという文字
            strpq 342+lung,putgdnnx+120-(16*5)/2,putgdnny+8,mbyte,q
        }
        
        if rmx>putgdnnx and rmy>putgdnny and rmx<putgdnnx+239 and rmy<putgdnny+39 {
            if sldataselx*5+sldatasely=nnsldata :gosub *badan
            sldataselx*5+sldatasely=nnsldata
        }

    next
        
return
        
*putizumi
    
    boli 1,0,pyp+(470-(izumimax-0)*32)-8-2,478,pyp+470-32-8+32

    
    for nnn,0,izumimax
    
        ppx=pxp+32
        ppy=pyp+(470-(izumimax-nnn)*32)
        
        selbox ((nnn=izumiy) and (cslpcnt=1)),0+2,ppy-8,479-2,ppy-8+32,mx,my
        
        gmulcolor 255,255,255
        if izumiselokng(nnn)=1:gmulcolor 127,127,127
        
        strpq 1576+nnn*2+lung,ppx,ppy-4,mbyte,q
        
        gmulcolor 255,255,255
                    
        if rmx>0 and rmy>ppy-8 and rmx<479 and rmy<ppy-8+32 {
            if nnn=izumiy {
                rmx=0
                gosub *badan
            } else {
                izumiy=nnn
            }
        }
    
    next

