*putsp
    
    sppmax=8
    spputy=480-8-32*(sppmax)
    
    ;shopputy=480-8-32*(putitemmax)
    motopxp=pxp
    pxp=50
    sppyset=476;548;476
    
    if mode=1030 or mode=1031 or mode=1032 or mode=1035 or mode=1038 or mode=1039 or mode=1040 or mode=1041 or mode=1045 or mode=1130 or mode=2225 or mode=4110 or mode=4111 or mode=4112 {
        pxp=480-224-2
        sppyset=sppyset+90
    }

    if ((mode=1040 or mode=1041 or mode=1045 or mode=2225) and (dt(chrno,201)!512)) or (mode=1030 or mode=1031 or mode=1032 or mode=1035 or mode=1038 or mode=1039 or mode=1130 or mode=4110 or mode=4111 or mode=4112) {
        boli 1+((mode=1031 or mode=1032 or mode=1035 or mode=1130 or mode=4112) or (mode=4111))*2+(mode=1040 or mode=1041 or mode=1045 or mode=2225)*3,pxp-3,(sppyset+pyp)-sppmax*36+pyp+1,224+pxp-1,(sppyset+pyp)+pyp
    }

    ;スキルをおぼえていません    
    if (dt(chrno,201)=512) and (mode=1030 or mode=1031 or mode=1032 or mode=1038 or mode=1039 or mode=1035 or mode=1130 or mode=4110 or mode=4111 or mode=4112) {
        strpq 680,pxp+16,sppyset-(sppmax-2)*36,mbyte,q
    }

    for n,0,sppmax,1

        if dt(chrno,201+n+spselpage*sppmax)!512 {

            gmulcolor 255,255,255
            if mode=1032 or mode=1035 or mode=1130 or mode=4112:gmulcolor 127,127,127
            px=0+pxp
            
            py=(sppyset+pyp)-sppmax*36+n*36+pyp+2
            if mode=1030 or mode=1031 or mode=1032 or mode=1038 or mode=1039 or mode=1035 or mode=1130 or mode=4110 or mode=4111 or mode=4112 {
                ;カーソルの表示方法
                cslputmode=((spy=n) and (cslpcnt=1))
                
                ;カーソルの表示方法
                cslputmode=(spy=n)
                ;カーソルを点滅させる
                if mode=1030 or mode=1038 or mode=1039 or mode=4110 {
                    cslputmode=((spy=n) and (cslpcnt=1))
                }
                ;入れ替え時に一つ目のカーソルを表示させる
                if mode=1039 and spselmtsortpage=spselpage and spselmtsorty=n {
                    cslputmode=cslputmode+2
                }
                
                
                selbox cslputmode,px,py,224+pxp,((sppyset+pyp)-(sppmax-1)*36)+n*36+pyp+(mode=1030 or mode=1031 or mode=1032 or mode=1035 or mode=1130 or mode=4110 or mode=4111)*2,mx*(mode!1130 and mode!1032),my
            }
            
            nn=dt(chrno,201+n+spselpage*sppmax)
            
            putspnm=spnm(nn,0+lung)
            
            notesel q
            noteget komestr,241

            ;選ぶことができない
            if (dt(7,201+n+spselpage*sppmax)!0) and (dt(7,201+n+spselpage*sppmax)!4):gmulcolor 127,127,127
            ;常に有効の場合　左右に※をつける
            if dt(7,201+n+spselpage*sppmax)=4:putspnm=komestr+spacestr+putspnm+spacestr+komestr
            
            strp putspnm,px+24-(mode=1040 or mode=1041 or mode=1045 or mode=2225)*16,py+6,mbyte

            gmulcolor 255,255,255        
        
            if (mode=1030 or mode=1031 or mode=1038 or mode=1039 or mode=4110 or mode=4111) and rmx>0+pxp+16 and rmy>((sppyset+pyp)-sppmax*36+n*36+pyp) and rmx<224+pxp and rmy<(((sppyset+pyp)-(sppmax-1)*36)-1+n*36+pyp) {
                if mode=1031:nextmode=1030
                if mode=1041:nextmode=1040
                if mode=4111:nextmode=4110
                if spy=n:cmx=0:spsely=n:gosub *badan
                if spy!n:spy=n
            }
        }
    next

    ;ページ数の表示
    gmulcolor 255,255,255
    if mode=1130:gmulcolor 127,127,127
    pagemaxstr=vzstr(sppagemax+1,mbyte)
    varp spselpage+1,pxp+208/2-8-24+2,sppyset+pyp+18,2,1
    strp pagemaxstr,pxp+208/2-16+32-2,sppyset+pyp+18,mbyte
    strpq 231,pxp+208/2,sppyset+pyp+18,mbyte,q

    ;ページ変更ボタン
    if sppagemax>0  and (mode=1030 or mode=1032  or mode=1035 or mode=1038 or mode=1039 or mode=1040 or mode=1045 or mode=2225 or mode=4110){
        
        for n,0,2
            if n=0:menubtnx=pxp-2
            if n=1:menubtnx=480-70-2
            menubtny=sppyset+pyp+2
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+70 and my<menubtny+60 :btnco=1
            if n=0 and btn(3)=1:btnco=1
            if n=1 and btn(1)=1:btnco=1
            if cmx>menubtnx and cmy>menubtny and cmx<menubtnx+70 and cmy<menubtny+60 {
                if n=0:gosub *bldan
                if n=1:gosub *brdan
            }

            boli btnco,menubtnx,menubtny,menubtnx+70-3,menubtny+60-3
            strpq 1164-n*2+lung,menubtnx+(70-16*3)/2,menubtny+(60-24)/2,mbyte,q            

        next
    }

