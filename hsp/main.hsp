            eveloc(evegono)=0
            henfr=(epf)-dmindanf
            henix=(epx)-dmindanx
            heniy=(epy)-dmindany
            poke mapd(henfr,henix,heniy),2,0
            evesymboldat(epf-dmindanf,epx-dmindanx,epy-dmindany)=0
            gosub *mappidset
                


        }
