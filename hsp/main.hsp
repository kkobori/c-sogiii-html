        if useseitonsely>nuseseitonmax-1:useseitonsely=0
    }
    if (mode=1030 or mode=1038 or mode=1039 or mode=4110) and cmx!-1 {
        spy++
        ;if spy>(sppmax-1):spy=0:spselpage++:if spselpage>sppagemax:spselpage=0
        if spy>(sppmax-1):spy=0;:spselpage++:if spselpage>sppagemax:spselpage=0
        if dt(chrno,201+spy+spselpage*sppmax)=512:spy=0;:spselpage++:if spselpage>sppagemax:spselpage=0
    }
    if (mode=1031 or mode=4111) and cmx!-1 {
        spselpage++:if spselpage>sppagemax:spselpage=0
        while dt(chrno,201+spy+spselpage*sppmax)=512 and spy>0
            spy--
        wend
    }
    if (mode=1035 or mode=1040 or mode=1045 or mode=1050 or mode=1105 or mode=1185 or mode=1320 or mode=2190 or mode=4120) and cmx!-1 {
        chrsely++
        if chrsely>(partymax-1):chrsely=0
        if mode=1035:sppage=0:spy=0:chrno=chrsely+8:gosub *sppagemaxget:gosub *spuseokngset
        if (mode=1045 or mode=1040):sppage=0:chrno=chrsely+8:gosub *sppagemaxget
        if mode=1185:chrno=chrsely+8
    }
    if (mode=1041 or mode=2225) and cmx!-1 {
        spselpage++
        if spselpage>sppagemax:spselpage=0
    }
    if (mode=1055 or mode=2205) and cmx!-1 {
        jobpageset=0
        jobselxset=0
        jobselyset=0
        if jobselx+jobsely*2+jobpage*8<jobmax-2 {
            if jobsely=3 {
                jobpage++
                jobselyset=-jobsely
            }
            if jobsely<3:jobselyset++
            if jobsely=3 and jobpage>jobpagemax:jobselyset=-jobsely:jobpageset=-jobpage    
            jobpage=jobpage+jobpageset
            jobselx=jobselx+jobselxset
            jobsely=jobsely+jobselyset
        } else {
            if jobsely=3 and jobpagemax=jobpage:jobpageset=-jobpagemax:jobselyset=-jobsely
            if jobsely=3 and jobpagemax>jobpage:jobpageset=1:jobselyset=-jobsely
            if jobselx=1 and jobsely<3 and (jobmax\2)=1:jobselyset=1:jobselxset=-1
            if jobselx=1 and jobsely<3 and (jobmax\2)=0:jobselyset=-jobsely:jobpageset=-jobpagemax
            if jobselx=0 and jobsely<3 :jobselyset=-jobsely:jobpageset=-jobpagemax
            jobpage=jobpage+jobpageset
            jobselx=jobselx+jobselxset
            jobsely=0;jobsely+jobselyset
            if jobpage*8+jobselx+jobsely*2>=jobmax and (jobmax\2)=1 and jobselx=1:jobselx=0
        }
    }
    ;if (mode=1055 or mode=2205) and cmx!-1 {
    ;    if jobsely=3:jobpage++
    ;    if jobsely<3:jobsely++
    ;    if jobsely=3 and jobpage>jobpagemax:jobsely=0:jobpage=0    
    ;}
    if (mode=1090 or mode=1190 or mode=4070) and cmx!-1:eqipy++:if eqipy>2:eqipy=0
    if mode=1600 and cmx!-1 {        
        warpself=warpfrselcslset(warpself,1)
    }
    if mode=1610 and cmx!-1 :warpsely++:if warpsely>15:warpsely=0 
    if (mode=1400 or mode=4400) and cmx!-1 :takaraselx++:if takaraselx>2:takaraselx=0
    if mode=2025 and cmx!-1 :evesely=evesely+1:if evesely>eveselmax-1:evesely=0
    if mode=2070 and cmx!-1 :shopinselx++:if shopinselx>2:shopinselx=0
    if (mode=2080 or mode=2300) and cmx!-1 :shopsely++:dim infoputcutcnt,5:if shopsely>shopitemmax-1:shopsely=0
    if mode=2090 and cmx!-1 :gosub *bldan
    if (mode=2120 or mode=2310) and cmx!-1 {
        itemselly++
        if itemselly>(itempmax-1):itemselly=0;:itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
        if dt(9,713+itemselly+itemsellpage*itempmax)=0:itemselly=0;:itemsellpage++:if itemsellpage>itempagemax:itemsellpage=0
    }
    if mode=2121 and cmx!-1 {
        itemsellpage++
        if itemsellpage>itempagemax:itemsellpage=0
        while dt(9,713+itemselly+itemsellpage*10)=0 and itemselly>0
            itemselly--
        wend
    }
    if mode=2130 and cmx!-1 :gosub *bldan
    if mode=2170 and cmx!-1 :tsumesyoy++:if tsumesyoy=tsumesyomax:tsumesyoy=0
    if (mode=2180 or mode=2210 or mode=2220 or mode=2230 or mode=2235 or mode=2240) and cmx!-1 :meiboy++:if meiboy=10:meiboy=0
    if (mode=2200 or mode=2245) and cmx!-1 and nameputx<5:nameputy++:if nameputy=12:nameputy=0
    if (mode=2200 or mode=2245) and cmx!-1 and nameputx=5 {
        nameputy++
        nameputx5y++
        if kanamode!2 and nameputx5y=5:nameputx5y=0:nameputy=7
        if kanamode=2 and nameputx5y=5:nameputx5y=3:nameputy=10
    }
    if mode=2400 and cmx!-1 :izumiy++:if izumiy=izumimax:izumiy=0
    if mode=4020 and cmx!-1 {
        campselyplus=0
        if (btlcomsely\2)=1:btlcomselyplus=-1
        if (btlcomsely\2)!1:btlcomselyplus=1
        if (btlcomsely+btlcomselyplus)>=btlcompmax:btlcomselyplus=-(campsely\2)
        btlcomsely=btlcomsely+btlcomselyplus
    }
    if (mode=4030 or mode=4120 or mode=4090 or mode=4165) and cmx!-1 {
        nextoneorall=oneorall
        if oneorall=0 :nextoneorall=10:motomonspchrno=spchrno_1:spchrno_1=motoispchrno:spchrno_2=spchrno_1
        if oneorall=10 :nextoneorall=0:motoispchrno=spchrno_1:spchrno_1=motomonspchrno:spchrno_2=spchrno_1
        if oneorall=11 :nextoneorall=1:spchrno_1=0:spchrno_2=monmax-1
        if oneorall=1 :nextoneorall=11:spchrno_1=8:spchrno_2=partymax+8-1
        oneorall=nextoneorall
        if oneorall=0 {;単体and敵
            for nn,7,-1,-1
                if spchrno_1<0:spchrno_1=monmax-1
                if dt(spchrno_1,110)>0:spchrno_2=spchrno_1:_break
                spchrno_1--
            next
        }
        if oneorall=10 {;単体and味方
            for nn,11,7,-1
                if spchrno_1<8:spchrno_1=partymax+8-1
                if dt(spchrno_1,110)>0:spchrno_2=spchrno_1:_break
                spchrno_1--
            next
        }
    }
    if (mode=4075) and (cmx!-1):useeqipy=1-useeqipy

return
                    
*bldan

    if (mode=10 or mode=200 or mode=530 or mode=540 or mode=570 or mode=600 or mode=1110 or mode=1200 or mode=2030 or mode=2050 or mode=2090 or mode=2130 or mode=2207 or mode=2215 or mode=3000) and cmx!-1 :yesnoselx=1-yesnoselx

    if mode=100 and cmx!-1 :sldataselx=1-sldataselx
    
    if mode=1010 and cmx!-1 {
        campselyplus=0
        if (campsely/3)=0:campselyplus=(camppmax/3)*3
        if (campsely/3)!0:campselyplus=-3
        if (campsely+campselyplus)>=camppmax:campselyplus=campselyplus-3
        campsely=campsely+campselyplus
    }
    if (mode=1020 or mode=1022 or mode=1028 or mode=1029 or mode=1080 or mode=1180 or mode=4080 or mode=4160) and cmx!-1 {
        itemsellpage--:if itemsellpage<0:itemsellpage=itempagemax
        while dt(11,713+itemy+itemsellpage*itempmax)=1226 and itemy>0
            itemy--
        wend
        if mode=1080 or mode=1180 or mode=4080 {
            a=dt(11,713+itemy+itemsellpage*itempmax)
            eqipitemno=dt(8,a)
            if a>1224:eqipitemno=0
            gosub *itemeqipinfoset
        }
    }
    ;if mode=1021 and (rmx!-1) and itempagemax>0:nextmode=1020
    if (mode=1030 or mode=1032 or mode=1035 or mode=1038 or mode=1039 or mode=4110) and cmx!-1 {
        spselpage--:if spselpage<0:spselpage=sppagemax
        while dt(chrno,201+spy+spselpage*sppmax)=512 and spy>0
            spy--
        wend
    }
    ;if (mode=1031) and (rmx!-1) and sppagemax>0:nextmode=1030
    if (mode=1040 or mode=1045 or mode=2225) and cmx!-1 {
        spselpage--
        if spselpage<0:spselpage=sppagemax
    }
    ;if mode=1041 and (rmx!-1) and sppagemax>0 :nextmode=1040
    if (mode=1055 or mode=2205) and cmx!-1 {
        if jobselx+jobsely*2+jobpage*8<jobmax-1 {
            jobselx=1-jobselx        
        } else {
            if jobselx=1:jobselx=0
            if jobselx=0 and (jobmax\2)=1 and jobsely>0:jobselx=1:jobsely--
        }
    }
    if mode=1181 and rmx!-1 and itempagemax>0:nextmode=1180
    if mode=1600 and cmx!-1 {        
        warpself=warpfrselcslset(warpself,2)
    }
    if mode=1610 and cmx!-1 :warpselx--:if warpselx<0:warpselx=15 
    if mode=2090 and cmx!-1 {
        buyselln--
        if buyselln<1 {
            buyselln=1
        }
        shopbuygoldmax=buygold*buyselln
        if dtspecial(8,20)>0 {
            ;(((個数+1)/10)x人数)%引き
            shopbuygoldmax=shopbuygoldmax-(shopbuygoldmax*(buyselln+1)/10*dtspecial(8,20)/100)
        }
        msg(2)=vzstr(buyselln,mbyte)+strget
    }
    if (mode=2120 or mode=2310) and cmx!-1 {
        itemsellpage--
        if itemsellpage<0:itemsellpage=itempagemax
        while dt(9,713+itemselly+itemsellpage*10)=0 and itemselly>0
            itemselly--
        wend
    }
/*
    if mode=2120 and itemd(dt(8,713+itemselly+itemsellpage*10),18)=0 {
        if itempagemax>0 and shopselln(713+itemselly+itemsellpage*10,0)=0 and cmx!-1 {
            nextmode=2121
        }
    }
*/
    if mode=2130 and itemd(dt(8,sellitemhaveno),18)=0 and cmx!-1 {
        buyselln--
        if buyselln<1 {
            buyselln=1
        }
        gosub *shopsellnset
        shopsellgoldmax=sellgold*buyselln
        msg(2)=vzstr(buyselln,mbyte)+strget
    }

    if (mode=2180 or mode=2210 or mode=2220 or mode=2230 or mode=2235 or mode=2240) and cmx!-1 :meibox=1-meibox
    if (mode=2200 or mode=2245) and cmx!-1 {
        nameputx--
        if nameputx=-1 and nameputy<7+lung*3:nameputx=4
        if nameputx=-1 and nameputy>6+lung*3:nameputx=5:nameputx5y=nameputy-7
        ;if nameputx=5:nameputy=nameputx5y+7
