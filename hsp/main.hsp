                lrpg=putdmap(lrp)
                lrpset=0+(lrpg-2)*1000
            
                

                
                putonoff=1
                ;(高速化) 奥の行(okug>=2)で、旋回・移動中でないときは、下の判定はどれも当てはまらないので飛ばす
                if okug<2 or idocnt>0 {
                if lrpg=0 and okug<2:putonoff=0
                if lrpg=4 and okug<2:putonoff=0
        
                ;前後に進む時
                if idocnt>0 and idocntnext<2 {
                    if okug<1:putonoff=0
                }
        
                ;右を向く時
                if idocnt>0 and idocntnext=3 {
                    if idocnt>500 {
                        if (lrpg=0 or lrpg=1 or lrpg=2) and (okug=0) :putonoff=0
                    }
                    if idocnt<501 {
                        if (lrpg=4 or lrpg=3 or lrpg=2) and (okug=0) :putonoff=0
                    }
                }
                ;左を向く時
                if idocnt>0 and idocntnext=2 {
                    if idocnt>500 {
                        if (lrpg=4 or lrpg=3 or lrpg=2) and (okug=0) :putonoff=0
                    }
                    if idocnt<501 {
                        if (lrpg=0 or lrpg=1 or lrpg=2) and (okug=0) :putonoff=0
                    }
                }
                ;上下
                if idocnt>0 and idocntnext=4 or idocntnext=5 {
                    if okug=0:putonoff=0
                }
                }

                a=(putd(takag,lrpg,okug,0)\1000)
                if pdoOn:gosub *putdanoutsidedelete

                ;天井が空モードの場合で一番奥の表示を処理している場合
                ;外モードをオンにする
                soto=0
                if a=1 and (putd(takag,lrpg,okug,4)\1000)=11 and okug=5 {
                    a=11
                    soto=1
                }
                ;フロア全体が外モードの場合
                if frskyd(fr+takag-2)/1000=1 and okug=5 {
                    ;a=11
                    soto=1
                }
