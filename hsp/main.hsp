        btnstr(2,0)=264
        btnstr(5,0)=260
        btnstr(0,1)=-16
        btnstr(2,1)=-16
    }
                    
    if btnr(0)>0:btnr(0)--
    if btnr(1)>0:btnr(1)--
    if btnr(2)>0:btnr(2)--
    if btnr(3)>0:btnr(3)--
    if btnr(4)>0:btnr(4)--
    if btnr(5)>0:btnr(5)--

            
    for n,abbtnoff,-1,-1
        if btnoff(n)=0 {
            btn(n)=0
            btnpx1=btnpos(n,0,btnposset)
            btnpx2=btnpos(n,2,btnposset)
            btnpy1=btnpos(n,1,btnposset)
            btnpy2=btnpos(n,3,btnposset)
            if btnmx>btnpx1 and btnmx<btnpx2 and btnmy>btnpy1 and btnmy<btnpy2 {
                btn(n)=1
                if (btnposset!0) and n=1:btn(4)=0
                if (btnposset!0) and n=1:btn(5)=0
            }
            if btnrmx>btnpx1 and btnrmx<btnpx2 and btnrmy>btnpy1 and btnrmy<btnpy2 {
                btnr(n)=1
            }
        }

    next

    for n,abbtnoff,-1,-1
        if btnoff(n)=0 {

            color 255,255,255    
            boli 1+(btn(n)=0)*4,btnpos(n,0,btnposset),btnpos(n,1,btnposset),btnpos(n,2,btnposset)-3,btnpos(n,3,btnposset)-3
                if n=0:strpq btnstr(0,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
                if n=1:strpq btnstr(1,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
                if n=2:strpq btnstr(2,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
                if n=3:strpq btnstr(3,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
                if n=4:strpq btnstr(4,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
                if n=5:strpq btnstr(5,0),pxp+btnpos(n,4,btnposset)+btnstr(n,1),pyp+btnpos(n,5,btnposset),mbyte,q
        }
    next
        
    gmode 2

return

