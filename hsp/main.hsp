            gmulcolor 255,255,255        
        
            if rmx>0+pxp+16 and rmy>((itempyset+pyp)-itempmax*36+n*36+pyp) and rmx<272+pxp and rmy<(((itempyset+pyp)-(itempmax-1)*36)-1+n*36+pyp) {
                if mode=1021:nextmode=1020
                if mode=1181:nextmode=1180
                if mode=4081:nextmode=4080
                if mode=4161:nextmode=4160
                if mode=1020 or mode=1028 or mode=1029 or mode=4160 {
                    if itemy=n {
                        cmx=0
                        itemselly=n
                        gosub *badan
                        ;お店
                        ;if mode=2120 or mode=2121 {gosub *brdan} else {gosub *badan}
                    }
                    if itemy!n {
                        itemy=n
                        a=dt(11,713+itemy+itemsellpage*itempmax)
                        eqipitemno=dt(8,a)
                        if a>1224:eqipitemno=0
                        gosub *itemeqipinfoset
                    }
                }
            }
        }
    next
    
    ;ページ数の表示
    gmulcolor 255,255,255
    if mode=1120:gmulcolor 127,127,127
    pagemaxstr=vzstr(itempagemax+1,mbyte)
    varp itemsellpage+1,pxp+270/2-8-32+2,itempyset+pyp+18,2,1
    strp pagemaxstr,pxp+270/2-16+24-2,itempyset+pyp+18,mbyte
    strpq 231,pxp+270/2-8,itempyset+pyp+18,mbyte,q

    ;ページ変更ボタン
    if itempagemax>0 and (mode=1020 or mode=1022 or mode=1028 or mode=1029 or mode=2120 or mode=4160) {
        
        for n,0,2
            if n=0:menubtnx=pxp-2
