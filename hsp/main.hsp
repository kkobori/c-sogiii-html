    }
*/

    ;boli 0+(mode=2121)*6,pxp-2,(itempyset+pyp)-shopitemmax*gyoukan+pyp-2-24+64,478-2,(itempyset+pyp)+pyp
    boli 0+(mode=2121)*6,pxp-2,(itempyset+pyp)-(itempmax+2)*gyoukan+pyp-22+64,478-2,(itempyset+pyp)+pyp
    
    pxp=motopxp
            
    ;アイテムの情報を表示
    itemselno=dt(8,713+itemselly+itemsellpage*itempmax)
    eqipitemselno=dt(8,713+itemselly+itemsellpage*itempmax)
    infoitemno=dt(8,713+itemselly+itemsellpage*itempmax)
    gosub *putiteminfo

/*
    gosub *shopbuynset
    shopputy=480-8-32*(shopitemmax)
    
    strpq 648,px+260,shopputy+12,mbyte,q
    strpq 644,px+324,shopputy+12,mbyte,q
    strpq 646,px+388,shopputy+12,mbyte,q
    
    for n,0,shopitemmax,1
        px=0+pxp
        py=(548+pyp)-shopitemmax*36+n*36+pyp
        selbox ((shopsely=n) and (cslpcnt=1)),px,py,375+pxp,((548+pyp)-(shopitemmax-1)*36)-1+n*36+pyp,mx,my
        nn=shopitem(n)
        
        gmulcolor 255,255,255
        if shopbuyn(n,2)=0:gmulcolor 127,127,127
        strp itemnm(nn,0+lung),px+24,py+6,mbyte
        varp itemd(nn,0),px+228,py-(lung*2)+6,5,1
        varp shopbuyn(n,0),px+320,py-(lung*2)+6,2,1
        varp shopbuyn(n,1),px+408,py-(lung*2)+6,2,1
        if lung=0:strpq 90,px+352,py+6,mbyte,q;--コ
        if lung=0:strpq 90,px+440,py+6,mbyte,q;--コ
        gmulcolor 255,255,255
        
        
        if rmx>0+pxp and rmy>((548+pyp)-shopitemmax*36+n*36+pyp) and rmx<480+pxp and rmy<(((548+pyp)-(shopitemmax-1)*36)-1+n*36+pyp) {
            if shopsely=n:cmx=0:shopsely=n:gosub *brdan
            if shopsely!n:shopsely=n
        }
    next
    

    itemselno=shopitem(shopsely)
    eqipitemselno=shopitem(shopsely)


    ;売品説明のウィンドウの大きさ
    ;装備品の場合は右側を空ける（装備可不可のウィンドウを表示するため）
    idpx=320+pxp+(itemd(shopitem(shopsely),16)=0)*158+(itemd(shopitem(shopsely),16)=7)*158
    idpy=shopputy;+pyp
    
    if itemd(shopitem(shopsely),3)=54 {
        itemselno=shopitem(shopsely)
        jobpage=itemd(itemselno,1)/8
        jobselx=itemd(itemselno,1)\2
        jobsely=(itemd(itemselno,1)/2)-(itemd(itemselno,1)>7)*8
    }
*/
return

*putshopbuycom

    ;数量変更ボタン
        
    for n,0,2
            
        if n=0:menubtnx=0
        if n=1:menubtnx=160
        menubtny=430
        btnco=5
        if mx>menubtnx and my>menubtny and mx<menubtnx+70 and my<menubtny+60 :btnco=1
        if n=0 and btn(3)=1:btnco=1
        if n=1 and btn(1)=1:btnco=1
        if cmx>menubtnx and cmy>menubtny and cmx<menubtnx+70 and cmy<menubtny+60 {
            if n=0:gosub *bldan
            if n=1:gosub *brdan
        }
        boli btnco,menubtnx,menubtny,menubtnx+70-3,menubtny+60-3
        strpq 238-n*77+lung,menubtnx+(70-16*1)/2,menubtny+(60-24)/2,mbyte,q            

    next

return
            
*putshopbuyok
    
    msg(0)=nostr
    msg(1)=nostr
    msg(2)=nostr
    gosub *putmes

    putxx=0
    px=8+pxp+lung*114-(mode=2160 and lung=1)*24
    py=326+pyp
    dstrp itemnm(buyitemno,0,lung),px,py,lung
    if lung=1:putxx=stat
    dstrp itemnm(buyitemno,1,lung),px+64+lung*8,py,lung
    if lung=1 and stat!0:putxx=6+stat
    
    if lung=1 {
        px=px+putxx*12
        strp q(481),px,py,mbyte,0
    }

    px=8+pxp+(lung=0)*128
    py=326+pyp
    strp q(168+(mode=2160)*9+lung),px,py,mbyte,lung


return

*putmapfrsel
    
    notesel frnm
            
    putfrmin=0
    putfrmax=warpfrmax
            
    if warpself>16:putfrmin=17
    if warpself<17 and warpfrmax>16:putfrmax=17
            
    for nn,putfrmin,putfrmax
        px=4;+(nn/17)*108
        py=40+(nn\17)*30
        selbox (warpself=nn) and (cslpcnt=1),px,py,px+108,py+30,mx,my
            
        noteget msgset1,warpfrokng(nn)
        strp msgset1,24+px,4+py,mbyte
            
        if rmx>px and rmy>py and rmx<px+108 and rmy<py+30 {
            if warpself=nn:rmx=0:gosub *badan
            if warpself!nn {
                warpself=nn
                if dt(8,1290)=1:rmx=0:gosub *badan
            }
        }
    next
            
    if warpfrmax>17 {
        px=132
        py=40+480
        ;if mx>px and my>py and mx<px+108 and my<py+30 :btnco=1
        btnco=5
        if btn(1)=1 or btn(3)=1:btnco=1
        if mx>px and my>py and mx<px+124 and my<py+30 :btnco=1
        boli btnco,px,py,px+124,py+30
        strpq 1642-(warpself>16)*2+lung,px+8,py+4,mbyte,q
        if rmx>px and rmy>py and rmx<px+124 and rmy<py+30 {
            cmx=0
            gosub *bldan
        }
    }
            
return
            
*putmap
    
    ;(診断) pmdiag=1 のとき、ミニマップの左下に四角を2つ出す(普段は薄く、該当フレームだけ明るい)。1つ目=描き直し、2つ目=12フレーム経過による描き直し。不要なら 0 に
    pmdiag=0
    ;(実験) 描き直しの間隔(フレーム数)。既定12。点滅との関係を調べるときだけ 100000 などにする(ミニマップが更新されなくなるので通常は12)
    pmagemax=12
    ;通常移動時
    putxymax=6
    mappcssize=24
    mapputposx=476-mappcssize*putxymax*2+1
    mapputposy=612-mappcssize*putxymax*2+1
    kosa=160
    pfr=fr
    pix=ix
    piy=iy
            
    ;ワープ先のフロアを選択
    if mode=1600 {
        putxymax=8
        kosa=255
        mapputposy=96
        mappcssize=21
        mapputposx=116
        ;if warpfrmax>17 {
        ;    mappcssize=14
        ;    mapputposx=224        
        ;}
        pfr=warpfrokng(warpself);mindanf+warpself;+warpselfmin
        pix=mindanx+putxymax
        piy=mindany+putxymax
    }
    ;ワープ先を選択
    if mode=1610 {
        putxymax=8
        mappcssize=27
        kosa=255
        mapputposx=32
        mapputposy=20
        pfr=warpfrokng(warpself);mindanf+warpself;+warpselfmin
        pix=mindanx+putxymax
        piy=mindany+putxymax
    }

    gmode 4,,,kosa
    ;pos mapputposx,mapputposy
    ;gzoom mappcssize*13,mappcssize*13,1,20,1074,1,1

    ;(滑らか化) 前進・後退の移動中は、3Dカメラの進み具合(cammaeato)に合わせてミニマップを端数ピクセルずらす
    ;cammaeato: 1000=1マス分。プラスが後ろ向き。カメラ位置=ix,iy+(-cammaeato/1000)*前方向 (前方向=(iwe,-ins))
    pmox=0:pmoy=0
    ;pmsmoothon=1 にすると有効。既定(0)は従来どおり1マス単位で切り替わる
    if pmsmoothon=1 and mode=1000 and pmsm=1 and idocnt>0 and idocntnext<2 {
        pmox=0-(0-cammaeato)*iwe*mappcssize/1000
        pmoy=(0-cammaeato)*(0-ins)*mappcssize/1000
    }
    ;ミニマップ枠(元の描画範囲)。ずらした分がここからはみ出さないように切り取る
    pmcx0=mapputposx-mappcssize/2
    pmcx1=mapputposx+(putxymax*2+1)*mappcssize+mappcssize/2+1
    pmcy0=mapputposy-mappcssize/2
    pmcy1=mapputposy+(putxymax*2+1)*mappcssize+mappcssize/2

    if pfr-dmindanf>-1 {

            
    ;(高速化) 通常表示のミニマップは、位置などが変わらない間は描画内容を記録して使い回す
    if pmDim=0 {
        dim pmlA,1600:dim pmlX,1600:dim pmlY,1600:dim pmlW,1600:dim pmlH,1600
        dim pmlSX,1600:dim pmlSY,1600:dim pmlSW,1600:dim pmlSH,1600
        pmDim=1
    }
    pmuse=0
    if mode<1600 or mode=2005 or mode=2420 :pmuse=1
    pmneed=1
    if pmuse=1 and pmvalid=1 and pmage<pmagemax and pmkfr=pfr and pmkix=pix and pmkiy=piy and pmkmode=mode and pmksz=mappcssize and pmkalp=kosa and pmkdf=dmindanf :pmneed=0
    pmageonly=0
    if pmneed=1 and pmuse=1 and pmvalid=1 and pmage>=pmagemax and pmkfr=pfr and pmkix=pix and pmkiy=piy and pmkmode=mode and pmksz=mappcssize and pmkalp=kosa and pmkdf=dmindanf :pmageonly=1
    if pmneed=1 {
        pmrec=pmuse
        pmn=0:pmovf=0:pmLastChk=-1:pmga=kosa:pmTouched=0:pmmi=-1
    for mappy,0,putxymax*2+1
        for mappx,0,putxymax*2+1
            
            ;ワープ選択時　マップを直接タップ
            if mode=1610 and rmx>mapputposx+mappx*mappcssize+1 and rmy>mapputposy+mappy*mappcssize+mappcssize/2 and rmx<mapputposx+(mappx+1)*mappcssize+1 and rmy<mapputposy+(mappy+1)*mappcssize+mappcssize/2 {
                if warpselx=mappx and warpsely=mappy:rmx=0:gosub *badan
                if mappx<putxymax*2:warpselx=mappx
                if mappy<putxymax*2:warpsely=mappy
                if dt(8,1290)=1:rmx=0:gosub *badan
            }
            
            henpfr=pfr-dmindanf
            henpix=(pix+mappx-putxymax)-dmindanx
            henpiy=(piy-mappy+putxymax)-dmindany
            
            ;if mapstepon(area,pfr,pix+mappx-putxymax,piy-mappy+putxymax)=1 and pix+mappx-putxymax>mindanx-1 and pix+mappx-putxymax<maxdanx+1 and piy-mappy+putxymax>mindany-1 and piy-mappy+putxymax<maxdany+1 {
            if mapstepon(area,henpfr,henpix,henpiy)=1 and pix+mappx-putxymax>mindanx-1 and pix+mappx-putxymax<maxdanx+1 and piy-mappy+putxymax>mindany-1 and piy-mappy+putxymax<maxdany+1 {

                
                henfr=(pfr)-dmindanf
                henix=(pix+mappx-putxymax)-dmindanx
                heniy=(piy-mappy+putxymax)-dmindany
                yukadat=peek(mapd(henfr+1,henix  ,heniy  ),2)
                 tendat=peek(mapd(henfr  ,henix  ,heniy  ),2)
                   ndat=peek(mapd(henfr  ,henix  ,heniy  ),0)
                   sdat=peek(mapd(henfr  ,henix  ,heniy-1),0)
                   wdat=peek(mapd(henfr  ,henix  ,heniy  ),1)
                   edat=peek(mapd(henfr  ,henix+1,heniy  ),1)
                
                ;スイッチ付きオブジェの場合は変換する
                if yukadat=63 {
                    hendrf=(pfr+1)-dmindanf
                    hendrx=(pix+mappx-putxymax)-dmindanx
                    hendry=(piy-mappy+putxymax)-dmindany
                    ;a=wpeek(keydoorswno(pfr+1,pix+mappx-putxymax,piy-mappy+putxymax,2),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,2),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;yukadat=peek(keydoorswno(pfr+1,pix+mappx-putxymax,piy-mappy+putxymax,2),2+b);sw on off objno
                    yukadat=peek(keydoorswno(hendrf,hendrx,hendry,2),2+b);sw on off objno
                }
                if tendat=63 {        
                    hendrf=(pfr)-dmindanf
                    hendrx=(pix+mappx-putxymax)-dmindanx
                    hendry=(piy-mappy+putxymax)-dmindany
                    ;a=wpeek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,2),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,2),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;tendat=peek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,2),2+b);sw on off objno
                    tendat=peek(keydoorswno(hendrf,hendrx,hendry,2),2+b);sw on off objno
                }                

                if (yukadat!0) or (tendat=2) or (ndat!0) or (sdat!0) or (wdat!0) or (edat!0) {

                if (ndat<7) or (sdat<7) or (wdat<7) or (edat<7) {

                    pmpx=mapputposx+mappx*mappcssize+1:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy

                    pmga=kosa+kosa/6:gmode 4,,,pmga

;-dmindanf
;-dmindanx
;-dmindany
                    evesymbolno=evesymboldat(pfr-dmindanf,pix+mappx-putxymax-dmindanx,piy-mappy+putxymax-dmindany)
                    
                    ;床あり
                    ;if yukadat=0 or yukadat=3 or yukadat=4 or yukadat=5:gzoom mappcssize,mappcssize,1,0,1152,16,16;grotate 1,0,1152,0,mappcssize,mappcssize
                    if yukadat=0 or yukadat=3 or yukadat=4 or yukadat=5 or yukadat=6 {
                        pmdw=mappcssize:pmdh=mappcssize:pmsx=20:pmsy=1074:pmsw=1:pmsh=1:gosub *pmz
                    }
                    if (yukadat=0 and (tendat!2)) and (yukadat!5) {
                        pmga=kosa:gmode 4,,,pmga
                        pmpx=mapputposx+mappx*mappcssize+1+mappcssize/2-mappcssize/16-1:pmpy=mapputposy+mappy*mappcssize+mappcssize/2-mappcssize/16-1:pos pmpx,pmpy
                        pmdw=mappcssize/8:pmdh=mappcssize/8:pmsx=0:pmsy=1024:pmsw=1:pmsh=1:gosub *pmz
                    }
                    pmpx=mapputposx+mappx*mappcssize+1:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    pmga=kosa/2:gmode 4,,,pmga
                    ;床なし
                    if yukadat=1 or yukadat=2 or (yukadat>13 and yukadat<25):pmdw=mappcssize:pmdh=mappcssize:pmsx=0:pmsy=1152:pmsw=1:pmsh=1:gosub *pmz;grotate 1,0,1152,0,mappcssize,mappcssize
                    pmga=kosa:gmode 4,,,pmga
                    ;はしご下
                    if yukadat=2:pmdw=mappcssize:pmdh=mappcssize:pmsx=32:pmsy=1152:pmsw=16:pmsh=16:gosub *pmz;grotate 1,32,1152,0,mappcssize,mappcssize
                    ;はしご天井
                    if tendat=2:pmdw=mappcssize:pmdh=mappcssize:pmsx=48:pmsy=1152:pmsw=16:pmsh=16:gosub *pmz;grotate 1,48,1152,0,mappcssize,mappcssize
                    ;宝箱
                    if yukadat=3:pmdw=mappcssize:pmdh=mappcssize:pmsx=32:pmsy=1200:pmsw=16:pmsh=16:gosub *pmz;grotate 1,32,1200,0,mappcssize,mappcssize
                    ;罠
                    if yukadat=4:pmdw=mappcssize:pmdh=mappcssize:pmsx=16*7:pmsy=1200:pmsw=16:pmsh=16:gosub *pmz;grotate 1,16,1200,0,mappcssize,mappcssize
                    ;EVENT
                    if yukadat=5 {
                        
                        ;イベントが消去状態にあるかどうか
                        checkeveno=eveloctoid(pfr-dmindanf,pix+mappx-putxymax-dmindanx,piy-mappy+putxymax-dmindany)-1
                        pmFinChk=checkeveno:pmTouched=1
                        if checkeveno>-1 {
                            gosub *evecheck
                            pmLastChk=checkeveno
                            evestartswokng=0
                            eveyuukouparameta=bbget(evepropaty(checkeveno,3),9,8);イベントが有効となるスイッチなどのパラメータ
                            eveyuukousyurui=bbget(evepropaty(checkeveno,3),17,3);イベントが有効となる条件の種類
                            evestartsw=bbget(dt(8,1225+eveyuukouparameta/32),(eveyuukouparameta\32),1)
                            if eveyuukousyurui=1 and evestartsw=1:evestartswokng=1
                            if eveyuukousyurui=2 and evestartsw=0:evestartswokng=1
                        }
                        if evesymbolno>0 and evestartswokng=1:evesymbolno=0
                        
                        if evesymbolno>0 {
                            pmdw=mappcssize:pmdh=mappcssize:pmsx=(evesymbolno-1)*16:pmsy=1200:pmsw=16:pmsh=16:gosub *pmz;grotate 1,0,1200,0,mappcssize,mappcssize
                        } else {
                            pmga=kosa:gmode 4,,,pmga
                            pmpx=mapputposx+mappx*mappcssize+1+mappcssize/2-mappcssize/16-1:pmpy=mapputposy+mappy*mappcssize+mappcssize/2-mappcssize/16-1:pos pmpx,pmpy
                            pmdw=mappcssize/8:pmdh=mappcssize/8:pmsx=0:pmsy=1024:pmsw=1:pmsh=1:gosub *pmz
                            
                        }
                    }
                    ;泉
                    if yukadat=6:pmdw=mappcssize:pmdh=mappcssize:pmsx=96:pmsy=1200:pmsw=16:pmsh=16:gosub *pmz;grotate 1,16,1200,0,mappcssize,mappcssize
                    ;綱
                    ;if yukadat=15 or yukadat=16:gzoom mappcssize,mappcssize,1,0,1168,16,16
                    ;if yukadat=14 or yukadat=16:gzoom mappcssize,mappcssize,1,16,1168,16,16
                    ;鉄鋼
                    if yukadat>13 and yukadat<25 {
                        pmpx=mapputposx+mappx*mappcssize+1:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                        pmdw=mappcssize:pmdh=mappcssize:pmsx=128+(yukadat-14)*16:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                            
                    }
                }                
                }

            }
                
            
            ;0-15の数字
            if mode=1610 {
                if mappx=0 and mappy>0 {
                    varp 16-mappy,0,mapputposy+mappy*mappcssize,2,1
                }
                if mappy=0 and mappx<16 {
                    varp mappx,mapputposx+mappx*mappcssize+8,mapputposy+(putxymax*2+1)*mappcssize,1,1
                    if mappx>9:varp 1,mapputposx+mappx*mappcssize+8-10,mapputposy+(putxymax*2+1)*mappcssize,1,1

                }
            }
        next
    next

    pmga=kosa-kosa/4:gmode 4,,,pmga

    dim putmapyonoff,putxymax*2+1
            
    for mappy,0,putxymax*2+1
        putmapxonoff=0
        for mappx,0,putxymax*2+1
                
            henpfr=pfr-dmindanf
            henpix=(pix+mappx-putxymax)-dmindanx
            henpiy=(piy-mappy+putxymax)-dmindany

            ;if mapstepon(area,pfr,pix+mappx-putxymax,piy-mappy+putxymax)=1 and pix+mappx-putxymax>mindanx-1 and pix+mappx-putxymax<maxdanx+1 and piy-mappy+putxymax>mindany-1 and piy-mappy+putxymax<maxdany+1 {
            ;if mapstepon(area,pfr,pix+mappx-putxymax,piy-mappy+putxymax)=1 and pix+mappx-putxymax>mindanx-1 and pix+mappx-putxymax<maxdanx+1 and piy-mappy+putxymax>mindany-1 and piy-mappy+putxymax<maxdany+1 {
            if mapstepon(area,henpfr,henpix,henpiy)=1 and pix+mappx-putxymax>mindanx-1 and pix+mappx-putxymax<maxdanx+1 and piy-mappy+putxymax>mindany-1 and piy-mappy+putxymax<maxdany+1 {

                henfr=(pfr)-dmindanf
                henix=(pix+mappx-putxymax)-dmindanx
                heniy=(piy-mappy+putxymax)-dmindany
                yukadat=peek(mapd(henfr+1,henix  ,heniy  ),2)
                 tendat=peek(mapd(henfr  ,henix  ,heniy  ),2)
                   ndat=peek(mapd(henfr  ,henix  ,heniy  ),0)
                   sdat=peek(mapd(henfr  ,henix  ,heniy-1),0)
                   wdat=peek(mapd(henfr  ,henix  ,heniy  ),1)
                   edat=peek(mapd(henfr  ,henix+1,heniy  ),1)

                ;yukadat=peek(mapd(pfr+1,pix+mappx-putxymax  ,piy-mappy+putxymax  ),2)
                ; tendat=peek(mapd(pfr  ,pix+mappx-putxymax  ,piy-mappy+putxymax  ),2)
                ;   ndat=peek(mapd(pfr  ,pix+mappx-putxymax  ,piy-mappy+putxymax  ),0)
                ;   sdat=peek(mapd(pfr  ,pix+mappx-putxymax  ,piy-mappy+putxymax-1),0)
                ;   wdat=peek(mapd(pfr  ,pix+mappx-putxymax  ,piy-mappy+putxymax  ),1)
                ;   edat=peek(mapd(pfr  ,pix+mappx-putxymax+1,piy-mappy+putxymax  ),1)
                
                ;スイッチ付きオブジェの場合は変換する
                hendrf=(pfr)-dmindanf
                if ndat=63 {
                    hendrx=(pix+mappx-putxymax)-dmindanx
                    hendry=(piy-mappy+putxymax)-dmindany
                    ;a=wpeek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,0),2+b);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,0),2+b);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;ndat=peek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,0),2+b);sw on off objno
                    ndat=peek(keydoorswno(hendrf,hendrx,hendry,0),2+b);sw on off objno
                }
                if sdat=63 {
                    hendrx=(pix+mappx-putxymax)-dmindanx
                    hendry=(piy-mappy+putxymax-1)-dmindany
                    ;a=wpeek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax-1,0),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,0),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;sdat=peek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax-1,0),2+b);sw on off objno
                    sdat=peek(keydoorswno(hendrf,hendrx,hendry,0),2+b);sw on off objno
                }
                if wdat=63 {
                    hendrx=(pix+mappx-putxymax)-dmindanx
                    hendry=(piy-mappy+putxymax)-dmindany
                    ;a=wpeek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,1),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,1),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;wdat=peek(keydoorswno(pfr,pix+mappx-putxymax,piy-mappy+putxymax,1),2+b);sw on off objno
                    wdat=peek(keydoorswno(hendrf,hendrx,hendry,1),2+b);sw on off objno
                }
                if edat=63 {
                    hendrx=(pix+mappx-putxymax+1)-dmindanx
                    hendry=(piy-mappy+putxymax)-dmindany
                    ;a=wpeek(keydoorswno(pfr,pix+mappx-putxymax+1,piy-mappy+putxymax,1),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,1),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;edat=peek(keydoorswno(pfr,pix+mappx-putxymax+1,piy-mappy+putxymax,1),2+b);sw on off objno
                    edat=peek(keydoorswno(hendrf,hendrx,hendry,1),2+b);sw on off objno
                }
                
                                
                if (yukadat!0) or (tendat!0) or (ndat!0) or (sdat!0) or (wdat!0) or (edat!0) {
                if (ndat<7) or (sdat<7) or (wdat<7) or (edat<7) {
                
                    ;壁・ドアN
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize-mappcssize/2:pos pmpx,pmpy
                    if (ndat=0 or ndat=7 or ndat=8 or ndat=9 or ndat=10) and putmapyonoff(mappx)=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=0:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    if (ndat=2 or ndat=5 or ndat=6) and putmapyonoff(mappx)=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=32:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    ;てすりN
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize-mappcssize+mappcssize/2:pos pmpx,pmpy
                    if (ndat=3 or ndat=12) and putmapyonoff(mappx)=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=64:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    ;格子N
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize-mappcssize+mappcssize/2:pos pmpx,pmpy
                    if (ndat=4 or ndat=13) and putmapyonoff(mappx)=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=96:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    
                    ;壁・ドアS
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize+mappcssize-mappcssize/2:pos pmpx,pmpy
                    if (sdat=0 or sdat=7 or sdat=8 or sdat=9 or sdat=10) :pmdw=mappcssize:pmdh=mappcssize:pmsx=0:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapyonoff(mappx)=1
                    if (sdat=2 or sdat=5 or sdat=6) :pmdw=mappcssize:pmdh=mappcssize:pmsx=32:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapyonoff(mappx)=1
                    ;てすりS
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize+mappcssize-mappcssize/2:pos pmpx,pmpy
                    if (sdat=3 or sdat=12) :pmdw=mappcssize:pmdh=mappcssize:pmsx=64:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapyonoff(mappx)=1
                    ;格子S
                    pmpx=mapputposx+mappx*mappcssize:pmpy=mapputposy+mappy*mappcssize+mappcssize-mappcssize/2:pos pmpx,pmpy
                    if (sdat=4 or sdat=13) :pmdw=mappcssize:pmdh=mappcssize:pmsx=96:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapyonoff(mappx)=1

                    ;壁・ドアW
                    pmpx=mapputposx+mappx*mappcssize-mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (wdat=0 or wdat=7 or wdat=8 or wdat=9 or wdat=10) and putmapxonoff=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=16:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    if (wdat=2 or wdat=5 or wdat=6) and putmapxonoff=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=48:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    ;てすりW
                    pmpx=mapputposx+mappx*mappcssize-mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (wdat=3 or wdat=12) and putmapxonoff=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=80:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    ;格子W
                    pmpx=mapputposx+mappx*mappcssize-mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (wdat=4 or wdat=13) and putmapxonoff=0 :pmdw=mappcssize:pmdh=mappcssize:pmsx=112:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz
                    
                    ;壁・ドアE                    
                    pmpx=mapputposx+mappx*mappcssize+mappcssize-mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (edat=0 or edat=7 or edat=8 or edat=9 or edat=10) :pmdw=mappcssize:pmdh=mappcssize:pmsx=16:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapxonoff=1
                    if (edat=2 or edat=5 or edat=6) :pmdw=mappcssize:pmdh=mappcssize:pmsx=48:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapxonoff=1
                    ;てすりE
                    pmpx=mapputposx+mappx*mappcssize+mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (edat=3 or edat=12) :pmdw=mappcssize:pmdh=mappcssize:pmsx=80:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapxonoff=1
                    ;格子E
                    pmpx=mapputposx+mappx*mappcssize+mappcssize/2:pmpy=mapputposy+mappy*mappcssize:pos pmpx,pmpy
                    if (edat=4 or edat=13) :pmdw=mappcssize:pmdh=mappcssize:pmsx=112:pmsy=1168:pmsw=16:pmsh=16:gosub *pmz:putmapxonoff=1
                    
                }
                } else {
                    putmapxonoff=0
                    putmapyonoff(mappx)=0
                }
            } else {
                putmapxonoff=0
                putmapyonoff(mappx)=0                
            }
        next
    next

            
        pmrec=0
        if pmuse=1 {
            pmvalid=1-pmovf
            pmkfr=pfr:pmkix=pix:pmkiy=piy:pmkmode=mode:pmksz=mappcssize:pmkalp=kosa:pmkdf=dmindanf
            pmage=0
            pmRecGen++    ;記録を作り直したので、タイル画像のキャッシュを無効にする
            gosub *pmreplaycached
        }
    } else {
        pmage++
        if pmLastChk>-1 {
            checkeveno=pmLastChk
            gosub *evecheck
        }
        if pmTouched :checkeveno=pmFinChk
        gosub *pmreplaycached
    }

    ;(診断) 描き直し/年齢更新の印
    if pmdiag=1 and pmuse=1 {
        ;常に薄く表示(描画できているかの確認用)。点灯は「そのフレームだけ」
        pmdga=70:if pmneed=1:pmdga=256
        gmode 4,,,pmdga
        pos mapputposx+4,mapputposy+13*mappcssize+6:gzoom 12,12,1,0,1024,1,1
        pmdga=70:if pmageonly=1:pmdga=256
        gmode 4,,,pmdga
        pos mapputposx+24,mapputposy+13*mappcssize+6:gzoom 12,12,1,0,1024,1,1
    }

    ;現在の場所を三角で表示
    gmode 4,,,kosa

    if mode<1600 or mode=2005 or mode=2420 {
        pos mapputposx+mappcssize*putxymax,mapputposy+mappcssize*putxymax
    }
    if mode>1599 and mode<1650 and fr=pfr {
        pos mapputposx+mappcssize*(ix-mindanx),mapputposy+mappcssize*(136-iy)
        ;pos mapputposx+mappcssize*(ix-mindanx),mapputposy+mappcssize*(maxdany-iy)
    }
            
    if fr=pfr and cslpcnt=1 {
        if iwe=0 and ins=-1:gzoom mappcssize,mappcssize,1,0,1184,16,16;grotate 1,0,1184,0,mappcssize,mappcssize
        if iwe=1 and ins=0:gzoom mappcssize,mappcssize,1,16,1184,16,16;grotate 1,16,1184,0,mappcssize,mappcssize
        if iwe=0 and ins=1:gzoom mappcssize,mappcssize,1,32,1184,16,16;grotate 1,32,1184,0,mappcssize,mappcssize
        if iwe=-1 and ins=0:gzoom mappcssize,mappcssize,1,48,1184,16,16;grotate 1,48,1184,0,mappcssize,mappcssize
    }
                

    
    ;ワープ先を選ぶ場合のカーソル
    if mode=1610 {
        boli 0,mapputposx+mappcssize*warpselx+mappcssize/4,mapputposy+mappcssize*(warpsely+1)+mappcssize/4,mapputposx+mappcssize*warpselx+mappcssize-2-mappcssize/4,mapputposy+mappcssize*(warpsely+1)+mappcssize-2-mappcssize/4
        ;boli 0,mapputposx,mapputposy+mappcssize*(warpsely+1)+mappcssize/4,mapputposx+mappcssize*15+mappcssize-2,mapputposy+mappcssize*(warpsely+1)+mappcssize/4
        ;boli 0,mapputposx,mapputposy+mappcssize*(warpsely+1)+mappcssize-2-mappcssize/4,mapputposx+mappcssize*15+mappcssize-2,mapputposy+mappcssize*(warpsely+1)+mappcssize-2-mappcssize/4
        ;boli 0,mapputposx+mappcssize*warpselx+mappcssize/4,mapputposy,mapputposx+mappcssize*warpselx+mappcssize/4,mapputposy+mappcssize*(15+1)+mappcssize-2-mappcssize/4
        ;boli 0,mapputposx+mappcssize*warpselx+mappcssize-2-mappcssize/4,mapputposy,mapputposx+mappcssize*warpselx+mappcssize-2-mappcssize/4,mapputposy+mappcssize*(15+1)+mappcssize-2-mappcssize/4
        boli 0,mapputposx,mapputposy+mappcssize*(warpsely+1)+mappcssize-2-mappcssize/2,mapputposx+mappcssize*15+mappcssize-2,mapputposy+mappcssize*(warpsely+1)+mappcssize-2-mappcssize/2
        boli 0,mapputposx+mappcssize*warpselx+mappcssize/2,mapputposy,mapputposx+mappcssize*warpselx+mappcssize/2,mapputposy+mappcssize*(15+1)+mappcssize-2-mappcssize/4
    }
            
    ;ワープ時のインフォメーション表示
    if mode=1600 :strpq 1550+lung,240-22*8,4,mbyte,q
    if mode=1610 {
        strpq 1552+lung,240-18*8,4,mbyte,q
        notesel frnm
        noteget msgset1,warpfrokng(warpself)
        px=240-5*8
        py=mapputposy+mappcssize*(15+1)+mappcssize+32
        strp msgset1,px,py,mbyte
        selbox 0,px-8,py-4,px+5*16+8,py+30,mx,my
        if rmx>px-8 and rmy>py-4 and rmx<px+5*16+8 and rmy<py+30 {
            rmx=0
            gosub *bbdan
        }
    }
                
    }        

            
return

*pmz
    ;(統一) 記録中は描かずに記録だけする。描画は *pmreplay で毎フレーム同じ方法で行う
    ;(描き直しフレームだけ見た目が違ってピクッとなるのを防ぐ)
    pmskip=0
    if pmrec=1 {
        if pmn<1600 {
            ;(高速化) 1×1の塗りつぶしタイル(1マス分の大きさ)が、同じ高さで直前のタイルのすぐ右に続くときは、
            ;新しく記録せず直前のタイルを横に伸ばす。各タイルは自分のマス内に収まり重ならないので、描画結果は同じ
            pmcand=0
            if pmsw=1 and pmsh=1 and pmdw=mappcssize and pmdh=mappcssize :pmcand=1
            pmmerged=0
            if pmcand=1 and pmmi>-1 {
                if pmlSX(pmmi)=pmsx and pmlSY(pmmi)=pmsy and pmlA(pmmi)=pmga and pmlY(pmmi)=pmpy and pmlH(pmmi)=pmdh and (pmlX(pmmi)+pmlW(pmmi))=pmpx {
                    pmlW(pmmi)=pmlW(pmmi)+pmdw
                    pmmerged=1
                }
            }
            if pmmerged=0 {
                pmlA(pmn)=pmga:pmlX(pmn)=pmpx:pmlY(pmn)=pmpy
                pmlW(pmn)=pmdw:pmlH(pmn)=pmdh
                pmlSX(pmn)=pmsx:pmlSY(pmn)=pmsy:pmlSW(pmn)=pmsw:pmlSH(pmn)=pmsh
                if pmcand=1:pmmi=pmn
                pmn++
            }
            pmskip=1
        } else {
            pmovf=1
        }
    }
    if pmskip=0 {
        if pmox=0 and pmoy=0 {
            gzoom pmdw,pmdh,1,pmsx,pmsy,pmsw,pmsh
        } else {
            gosub *pmdraw
        }
    }
return

;(高速化) 止まっていて3Dもキャッシュから出ているフレームでは、記録タイルの再生結果(ミニマップ枠の画像)を
;  コピーするだけにする。プレイヤー印(点滅)・診断表示はこの後で描くので、キャッシュには含まれない。
;  使える条件: mode=1000、移動中でない、ずらし量なし、putdan が今フレームキャッシュから描いた
;  (=ミニマップの下地が保存時と同じ)、記録(pmRecGen)と3Dキャッシュ(pdcGen)が保存時と同じ。
;  宝箱・ワナ・スイッチなどの変化は、従来どおり12フレームごとの再走査(pmRecGen加算)で反映される。
*pmreplaycached
    pmqOk=0
    if mode=1000 and pdcHitNow=1 and idocnt=0 and pmox=0 and pmoy=0 {
        pmqx0=pmcx0-2:if pmqx0<0:pmqx0=0
        pmqy0=pmcy0-2:if pmqy0<0:pmqy0=0
        pmqx1=pmcx1+2:if pmqx1>480:pmqx1=480
        pmqy1=pmcy1+2:if pmqy1>800:pmqy1=800
        pmqw=pmqx1-pmqx0:pmqh=pmqy1-pmqy0
        if pmqw>0 and pmqh>0 and pmqh<361:pmqOk=1
    }
    if pmqOk=1 {
        if pmqValid=1 and pmqkGen=pmRecGen and pmqkPdc=pdcGen and pmqkX=pmqx0 and pmqkY=pmqy0 and pmqkW=pmqw and pmqkH=pmqh {
            gmode 0
            pos pmqx0,pmqy0
            gcopy 10,0,0,pmqw,pmqh
            return
        }
    }
    gosub *pmreplay
    if pmqOk=1 {
        gsel 10
        gmode 0
        pos 0,0
        gcopy 0,pmqx0,pmqy0,pmqw,pmqh
        gsel 0
        pmqValid=1:pmqkGen=pmRecGen:pmqkPdc=pdcGen:pmqkX=pmqx0:pmqkY=pmqy0:pmqkW=pmqw:pmqkH=pmqh
    }
return

;記録した描画内容を順に描く(ずらし量 pmox,pmoy があれば反映)
*pmreplay
    ;(高速化) ずらし量の判定をループの外に出した
    if pmox=0 and pmoy=0 {
        for pmi,0,pmn
            gmode 4,,,pmlA(pmi)
            pos pmlX(pmi),pmlY(pmi):gzoom pmlW(pmi),pmlH(pmi),1,pmlSX(pmi),pmlSY(pmi),pmlSW(pmi),pmlSH(pmi)
        next
    } else {
        for pmi,0,pmn
            gmode 4,,,pmlA(pmi)
            pmpx=pmlX(pmi):pmpy=pmlY(pmi):pmdw=pmlW(pmi):pmdh=pmlH(pmi)
            pmsx=pmlSX(pmi):pmsy=pmlSY(pmi):pmsw=pmlSW(pmi):pmsh=pmlSH(pmi)
            gosub *pmdraw
        next
    }
return

;(滑らか化) ずらして描く。ミニマップ枠(pmcx0〜pmcx1, pmcy0〜pmcy1)からはみ出す部分は切り取る
;入力: pmpx,pmpy,pmdw,pmdh,pmsx,pmsy,pmsw,pmsh (元の位置)  pmox,pmoy (ずらし量)
*pmdraw
    qx=pmpx+pmox:qy=pmpy+pmoy:qw=pmdw:qh=pmdh
    qsx=pmsx:qsy=pmsy:qsw=pmsw:qsh=pmsh
    qskip=0
    ;左
    if qx<pmcx0 {
        qc=pmcx0-qx
        if qc>=qw {
            qskip=1
        } else {
            if qsw>1 {
                qk=qc*qsw/qw
                qd=(qk*qw+qsw/2)/qsw
                qsx+=qk:qsw-=qk:qx+=qd:qw-=qd
            } else {
                qx+=qc:qw-=qc
            }
        }
    }
    ;右
    if qskip=0 and qx+qw>pmcx1 {
        qc=qx+qw-pmcx1
        if qc>=qw {
            qskip=1
        } else {
            if qsw>1 {
                qk=qc*qsw/qw
                qd=(qk*qw+qsw/2)/qsw
                qsw-=qk:qw-=qd
            } else {
                qw-=qc
            }
        }
    }
    ;上
    if qskip=0 and qy<pmcy0 {
        qc=pmcy0-qy
        if qc>=qh {
            qskip=1
        } else {
            if qsh>1 {
                qk=qc*qsh/qh
                qd=(qk*qh+qsh/2)/qsh
                qsy+=qk:qsh-=qk:qy+=qd:qh-=qd
            } else {
                qy+=qc:qh-=qc
            }
        }
    }
    ;下
    if qskip=0 and qy+qh>pmcy1 {
        qc=qy+qh-pmcy1
        if qc>=qh {
            qskip=1
        } else {
            if qsh>1 {
                qk=qc*qsh/qh
                qd=(qk*qh+qsh/2)/qsh
                qsh-=qk:qh-=qd
            } else {
                qh-=qc
            }
        }
    }
    if qskip=0 and qw>0 and qh>0 and qsw>0 and qsh>0 {
        pos qx,qy
        gzoom qw,qh,1,qsx,qsy,qsw,qsh
    }
return

*putevechr

    if evechrno>0 {
        ppno=evechrno-1
        gx=(ppno\32)*64
        gy=(ppno/32)*64
        evechrbai=5

        pos 80,0
        gzoom 64*evechrbai,64*evechrbai,2,gx,gy,64,64
        
    }

return

*puttsumesyo
    
    boli 4,0+pxp,416-(tsumesyomax*32)+pyp,478+pxp,452-(tsumesyomax*32)+pyp
    strpq 320+lung,8+pxp,424-(tsumesyomax*32)+pyp,mbyte,q
    
    if partymax!4 {
        setumeino=0
        gosub *tsumesyowaitnget
        setumeino=2
        if waitplayern=0:setumeino=1
        if setumeino=1:strpq 300+lung,88+pxp,424-(tsumesyomax*32)+pyp,mbyte,q
        if setumeino=2:strpq 302+lung,88+pxp,424-(tsumesyomax*32)+pyp,mbyte,q
    }
    
    boli 1,0,pyp+(470-(tsumesyomax-0)*32)-8-2,478,pyp+470-32-8+32

    
    for nnn,0,tsumesyomax
    
        ppx=pxp+32
        ppy=pyp+(470-(tsumesyomax-nnn)*32)
        
        selbox ((nnn=tsumesyoy) and (cslpcnt=1)),0+2,ppy-8,479-2,ppy-8+32,mx,my
        strpq 304+tsumesyomenu(nnn)*2+lung,ppx,ppy-4,mbyte,q
                    
        if rmx>0 and rmy>ppy-8 and rmx<479 and rmy<ppy-8+32 {
            if nnn=tsumesyoy {
                rmx=0
                gosub *badan
            } else {
                tsumesyoy=nnn
            }
        }
    
    next
    
return

*putmeibo
    
    dim ijoun,32,32
    dim ijouon,32
