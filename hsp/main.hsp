*suck
            
    damage=0

    ;属性補正+3の場合の効く確率を補正（吸収するため）
    if zokusei=6:kakuritu=100

    if kakuritu>rnd(100) {
    
        ;ダメージ値の計算
        damage=siduse(n1*3+1);-(dt(spchrno,77)+dt(spchrno,150))/4
        ataiplus=76,77,102,103,104,105,106,108,109,110,111
        ;149-153
        taisyou=chrno_1
        if siduse(10+n1*2)=1:taisyou=spchrno
        damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)
        ;バトルステータスがUP or DOWNしている場合
        if siduse(11+n1*2)=0:damage=damage+(dt(taisyou,149)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=1:damage=damage+(dt(taisyou,150)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=3:damage=damage+(dt(taisyou,151)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=5:damage=damage+(dt(taisyou,152)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=6:damage=damage+(dt(taisyou,153)*(siduse(2+n1*3)*5)/100)
        
        ;属性相性による補正
        damage=(damage*zokuseiritu(zokusei))/100

        ;相手が防御状態の場合
        if dt(spchrno,146)>0:damage=damage/2
        ;相手の魔法ダメージ補正
        damage=damage+(damage*dt(spchrno,156))/100
    
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0
        
        ;値にランダム性をつける
        damagep=0
        damagem=0
        if damage>0:damagep=rnd(damage/5+2):damagem=rnd(damage/5+1)
        if damage<0:damagep=rnd(-damage/5+2):damagem=rnd(-damage/5+1)        
        
        ;値の調整
        damage=damage+damagep-damagem
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0
            
        ;相手の最大値より高くならないようにする
        if (damage>dt(spchrno,110+hpmp)) and (zokusei!6):damage=dt(spchrno,110+hpmp)
        if (damage<dt(spchrno,110+hpmp)) and (zokusei=6):damage=-dt(spchrno,110+hpmp)
        
        ;エフェクトのセット
        efectok=1

        ;効果予約をセット
        bdtkoukaonset(chrno_1,110+hpmp)=bdtkoukaonset(chrno_1,110+hpmp)+damage                
        bdtkoukaonset(spchrno,110+hpmp)=bdtkoukaonset(spchrno,110+hpmp)-damage                

        ;文字のセット
            
        ;耐性+3でダメージを吸収
        if (zokusei=6) and (damage!0) {
            noteget msgset1,712+lung
            noteget msgset2,880+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+spnm(usespno,0+lung)+msgset2
            btlmsgmaxcnt++
            btlmsgmaxcnt++
            noteget msgset1,712+lung
            noteget msgset2,878+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+btlchrnmstr(spchrno)+msgset2
            btlmsgmaxcnt++
            noteget msgset1,874+hpmp*2+lung
            btlmsg(btlmsgmaxcnt)=vzstr(-damage,mbyte)+msgset1
            btlmsgmaxcnt++
            
            ;ダメージアニメーションのセット
            btldmganm(chrno_1)=5
        }

        ;HP or MP 回復 & ダメージ
        if (zokusei!6) and (damage!0) {
            
            noteget msgset1,712+lung
            noteget msgset2,878+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+btlchrnmstr(spchrno)+msgset2
            btlmsgmaxcnt++
            noteget msgset1,870+hpmp*2+lung
            btlmsg(btlmsgmaxcnt)=vzstr(damage,mbyte)+msgset1
            btlmsgmaxcnt++
            
            ;ダメージアニメーションのセット
            btldmganm(spchrno)=5
        }
    }

    ;効かなかった時の文字セット
    if damage=0 {
        efectok=0
        missmsgno=siduse(14)
        gosub *missmsgget
        btlmsg(btlmsgmaxcnt)=missmsg
        btlmsgmaxcnt++
    }
        
return
            
*kill
            
    damage=0
                        
    if kakuritu>rnd(100) {
        ;エフェクトのセット
        efectok=1
        ;効果予約をセット
        bdtkoukaonset(spchrno,110+hpmp)=-dt(spchrno,110)                
        ;ダメージアニメーションのセット
        btldmganm(spchrno)=5
        killon(spchrno)=1
        
    } else {
            
        ;効かなかった時の文字セット
        efectok=0
        missmsgno=siduse(14)
        gosub *missmsgget
        btlmsg(btlmsgmaxcnt)=missmsg
        btlmsgmaxcnt++
    }

            
return
            
*hpautorevive
            
    ;1で自動復活状態
    dt(spchrno,147)=1
            
    ;エフェクトのセット
    efectok=1
            
    ;文字のセット
    noteget msgset1,882+lung
    btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
    btlmsgmaxcnt++

return
            
*steal
        
/*
    spzokusei=spid(14)
    if spzokusei>7:spzokusei=7
    abcdefg=bdt(spchrno,24+spzokusei)
    kikanaikakuritu=spid(7)*bdt(spchrno,24+spzokusei)/7
    kikanaikakuritu=kikanaikakuritu*10
*/    
    stealritu=kakuritu*10+((100-kakuritu)*5)*(dtspecial(chrno_1,9)>0)
    stealok=0        ;=1で成功 =2は何も持っていない　=3は自分で自分のものを盗む
    normalorrea=1    ;まずは通常品から盗む
            
    ;plormon1=使い手
    ;plormon2=受け手
    ;0=敵　1=味方 2=敵が自分で自分を盗む 3=味方が自分で自分を盗む
    plormon1=0+(chrno_1>7)
    plormon2=0+(spchrno>7)
            
    ;自分で自分のものを盗んだ場合
    if plormon1=1 and plormon2=1:plormon1=3:plormon2=3:stealok=3:stealritu=1000
    if plormon1=0 and chrno_1=spchrno:plormon1=2:plormon2=2:stealok=3:stealritu=1000

            
    ;受け手が敵の場合
    if plormon2=0 or plormon2=2 {
        
        ;通常またはレアのどちらかでも持っている場合
        if montrasure(spchrno,1)!0 or montrasure(spchrno,2)!0 {
            ;通常品を持っていない or 盗み済み の場合はレアを盗むので確率が下がる
            if montrasure(spchrno,1)=0:stealritu=stealritu/10:normalorrea=2
            
            ;成功した場合
            if stealritu>rnd(1000) {
                ;成功
                if stealok=0:stealok=1
                ;盗んだアイテムのNo.
                stealitemno=montrasure(spchrno,normalorrea)
                ;自分で自分ではない場合は敵の持ちものを減らす
                if plormon2=0:montrasure(spchrno,normalorrea)=0                
            }
        } else {
            stealok=2
        }
    }
            
    ;受け手が味方 or 自分で自分の場合
    if plormon2=1 or plormon2=3 {
        
        iereasemax=0
        dim ierease,512
        
        for nnnnn,0,511,1
            n9=nnnnn
            ;破棄ができるか　0=できる
            n2=itemd(dt(8,713+nnnnn),18)
            ;アイテムを持っていてかつ破棄が可能である物を探す
            if dt(8,713+nnnnn)!512 and n2=0 {
                ;破棄可能なアイテムを登録する
                ierease(iereasemax)=nnnnn
                ;破棄可能なアイテムをいくつ持っているか
                iereasemax++
            }
        next

        ;破棄が可能なアイテムがある場合
        if iereasemax!0 {
            
            ;成功した場合
            if stealritu>rnd(1000) {
                ;成功
                if stealok=0:stealok=1

                n=rnd(iereasemax)
                stealitemno=dt(8,713+ierease(n))

                ;自分で自分ではない場合はアイテムを減らす
                if plormon2=1 {

                    dt(9,713+ierease(n))--
                    
                    if dt(9,713+ierease(n))<1 {
                        dt(8,713+ierease(n))=512
                        dt(9,713+ierease(n))=0
                        gosub *itemautosortout
                        gosub *itempagemaxget
                    }
                }

            }
        } else {
            ;盗まれることが可能なアイテムを持っていない場合
            if n1=0:stealok=2
        }

    }
    
    ;使い手が味方の場合            
    if plormon1=1 {
        itemsetno=1000
        for nnnnn,0,512
            ;盗んだアイテムをすでに持っていた場合は持ち数を増やす
            if dt(8,713+nnnnn)=nameitemno and dt(9,713+nnnnn)>0 :itemsetno=nnnnn:_break
        next
        if itemsetno=1000 {
            ;盗んだアイテムをまだ持っていない場合は空いている欄を探す
            for nnnnn,0,512
                if dt(8,713+nnnnn)=512:itemsetno=nnnnn:_break
            next
        }
        dt(8,itemsetno)=stealitemno
        dt(9,itemsetno)++
    }
    ;使い手が敵の場合            
    if plormon1=0 {
        montrasure(chrno_1,0)=stealitemno
    }            
    
    ;成功した場合の文字のセット
    if stealok=1 {
        noteget msgset1,886+lung
        btlmsg(btlmsgmaxcnt)=itemnm(stealitemno,0+lung)+msgset1
        btlmsgmaxcnt++
    }

    ;失敗した場合の文字セット
    if stealok=0 {
        if n1=0 {
            efectok=0
            missmsgno=siduse(14)
            gosub *missmsgget
            btlmsg(btlmsgmaxcnt)=missmsg
            btlmsgmaxcnt++
        }
    }

    ;何も持っていないまたは全部盗み済みの場合の文字セット
    if stealok=2 {
        noteget msgset1,888+lung
        btlmsg(btlmsgmaxcnt)=msgset1
        btlmsgmaxcnt++
    }

    ;自分で自分のものを盗んだ場合の文字セット
    if stealok=3 {
        noteget msgset1,712+lung
        noteget msgset2,45
        noteget msgset3,890+lung
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+itemnm(stealitemno,0+lung)+msgset2
        btlmsgmaxcnt++
        btlmsg(btlmsgmaxcnt)=msgset3
        btlmsgmaxcnt++
    }

return
            
*statesseed
        
    if lung=0 {
        noteget msgset1,432+siduse(2)*2+lung
        noteget msgset5,1638+lung
        if siduse(2)>5:msgset1=msgset5+msgset1
        noteget msgset2,26    ;は
        noteget msgset3,56    ;が
        noteget msgset4,862    ;あがった！
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset2+spacestr+msgset1+msgset3
        btlmsg(btlmsgmaxcnt)=btlmsg(btlmsgmaxcnt)+spacestr+vzstr(siduse(1),mbyte)+spacestr+msgset4
        btlmsgmaxcnt++
    }
    
    ;永久ボーナスにプラスする
    dt(spchrno,94+siduse(2))=dt(spchrno,94+siduse(2))+siduse(1)
    chrno=spchrno
    gosub *statsset
            
            
return
            
*jobchangeok
            
    if lung=0 {
        noteget msgset1,360+siduse(1)*2+lung
        noteget msgset2,26    ;は
        noteget msgset3,22    ;に
        noteget msgset4,1368    ;てんしょくできるようになった！
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset2+spacestr+msgset1+msgset3
        btlmsgmaxcnt++
        btlmsg(btlmsgmaxcnt)=msgset4
        btlmsgmaxcnt++
    }
            
    dt(spchrno,43+siduse(1))=1
        
return

*sishop
            
    pickupitemlv=msetfrd(21),msetfrd(22),msetfrd(23)
    gosub *itemlvpickup

    dim getshop,10
    dim shopitem,10
    dim shopbuyn,10,3    ;0=買いたい数 1=既に持っている数 2=買える最大数
    dim shopselln,1225,3    ;0=売りたい数 1=持っている数
    shopputy=0
    shopsely=0
    shopinselx=0
    shopsellgold=0
            
    sishopitemno=0
    setcnt=0
    if itempickupmax>0 {
        while ((sishopitemno<10) and (sishopitemno<itempickupmax))
            getshopkari=pickupitemno(rnd(itempickupmax))
            shoparunai=0
            for nnshopcheck,0,sishopitemno
                if getshop(nnshopcheck)=getshopkari:shoparunai=1
            next
            if shoparunai=0:getshop(sishopitemno)=getshopkari:sishopitemno++
            setcnt++
            if setcnt>1000:sishopitemno=20
        wend
    }
    if sishopitemno<20:shopitemmax=sishopitemno
    if sishopitemno=20:shopitemmax=0
    for shopn,0,shopitemmax,1
        if getshop(shopn)!0:shopitem(shopn)=getshop(shopn);:shopitemmax++
    next
    if shopitemmax!0 {
        eveoff=1
        sinextmode=2070
        gosub *shopbuynset
        sishopon=1
    } 
            
return
            
*invention

    inventionitemlv1=siduse(4)
    inventionitemlv2=siduse(5)
    inventionitemlv3=siduse(7)
    if inventionitemlv1>31:inventionitemlv1=31
    if inventionitemlv2>31:inventionitemlv2=31
    if inventionitemlv3>31:inventionitemlv3=31
    pickupitemlv=inventionitemlv1,inventionitemlv2,inventionitemlv3
    gosub *itemlvpickup
            
    if itempickupmax>0 {
        inventionitemno=pickupitemno(rnd(itempickupmax))
        inventiongold=siduse(1)*100
        notesel q
        noteget msgset1,642+lung
        noteget msgset2,1518+lung    ;ひつようです。
        noteget msgset3,1520+lung    ;つづけますか？
        msg(0)=vzstr(inventiongold,mbyte)+msgset1+spacestr+msgset2
        msg(1)=msgset3
        msg(2)=nostr
        sinextmode=1200
        
    }

            
return
            
*warp
    
    mindanf=96
    maxdanf=159


    eveoff=1
    sinextmode=1600
            
    warpselfmin=-1

    ;ワープ可能なフロアを検索・セット
    ;fronoff
    dim warpfrokng,256
    warpfrmax=0
            
    for warpfck,mindanf,maxdanf+1
        imafrok=0        
        for warpyck,mindany,maxdany+1        
            for warpxck,mindanx,maxdanx+1
                henwarpfck=warpfck-dmindanf
                henwarpxck=warpxck-dmindanx
                henwarpyck=warpyck-dmindany
                if mapstepon(area,henwarpfck,henwarpxck,henwarpyck)=1 {
                    ;フロアが有効（何もないフロアでない）ことが条件
                    if fronoff(warpfck)=1 {
                        warpfrokng(warpfrmax)=warpfck
                        warpfrmax++
                        imafrok=1
                    }
                }
                if imafrok=1:_break
            next
            if imafrok=1 {
                if warpselfmin=-1 {
                    warpselfmin=warpfck-mindanf
                    _break
                } else {
                    _break
                }
            }
        next
    next

    warpself=fr-mindanf-warpselfmin
    warpselx=ix-mindanx
    ;warpsely=maxdany-iy
    warpsely=135-iy
    if (maxdany-mindany)>16:warpsely=maxdany-(maxdany-mindany-15)-iy

    ;フロア選択情報をセット
    dim warpfrselcslset,256,3    ;0=上を押したとき 1=下を押したとき 2=左右を押したとき
    for warpfck,0,warpfrmax
        warpfrselcslset(warpfck,0)=warpfck-1
        warpfrselcslset(warpfck,1)=warpfck+1
        ;左の列　一番上　上を押した
        if warpfck=0 {
            if warpfrmax<17:warpfrselcslset(0,0)=warpfrmax-1
            if warpfrmax>16:warpfrselcslset(0,0)=16
        }
        ;左の列　一番下　下を押した
        if warpfck=warpfrmax-1 and warpfrmax<18 {
            warpfrselcslset(warpfck,1)=0
        }
        if warpfck=16 and warpfrmax>17 {
            warpfrselcslset(warpfck,1)=0
        }
        ;右の列　一番上　上を押した
        if warpfck=17 {
            warpfrselcslset(17,0)=warpfrmax-1
        }
        ;右の列　一番下　下を押した
        if warpfck=warpfrmax-1 and warpfrmax>17 {
            warpfrselcslset(warpfck,1)=17
        }
        ;左右を押した
        warpfrselcslset(warpfck,2)=warpfck+17
            if warpfrselcslset(warpfck,2)>warpfrmax-1 {
                ;if warpfck<17:warpfrselcslset(warpfck,2)=warpfrselcslset(warpfck,2)-17
                if warpfck<17:warpfrselcslset(warpfck,2)=warpfrmax-1
                if warpfck>16:warpfrselcslset(warpfck,2)=warpfrselcslset(warpfck,2)-34
            }
    next
        

return
            
