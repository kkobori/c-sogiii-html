*putuseseiton
        
    useseitonpx=0
    useseitonmx=mx
    useseitonmy=my
    useseitonmodeon=0
    
    ;タッチ反応しなくする
    if mode!1022 and mode!1032 and mode!4162 and mode!4112 {
        useseitonmodeon=1
        useseitonmx=-10000
        useseitonmy=-10000
    }
        
    ;dim useseitonpxy,4,4
    ;移動時アイテム選択
    if mode=1020 or mode=1022 {
        useseitonpy=400
        nuseseitonmax=4
    }
    ;移動時スキル選択
    if mode=1030 or mode=1032 {
        useseitonpy=388-(partymax-1)*32
        nuseseitonmax=3
    }
    ;戦闘時アイテム選択
    if mode=4160 or mode=4162 {
        useseitonpy=400
        nuseseitonmax=4
        
    }
    ;戦闘時スキル選択
    if mode=4110 or mode=4112 {
        useseitonpy=436
        nuseseitonmax=3        
    }

    boli 1+(useseitonmodeon=1)*2 ,useseitonpx,useseitonpy-2,useseitonpx+160,useseitonpy+nuseseitonmax*36

    gmulcolor 255,255,255
    if mode!1022 and mode!1032 and mode!4162 and mode!4112 {
        gmulcolor 127,127,127
    }

        
    for nuseseiton,0,nuseseitonmax,1
        selbox ((useseitonsely=nuseseiton) and ((cslpcnt=1) or (useseitonmodeon=1))),useseitonpx+2,useseitonpy+nuseseiton*36,158+useseitonpx,useseitonpy+nuseseiton*36+36,useseitonmx,useseitonmy
        
        gmulcolor 255,255,255
        ;移動時スキル選択　倒れ　封じ　眠り　混乱の時は使えない
        if mode=1032 and nuseseiton=0 and ((dt(chrno,110)<1) or (dt(chrno,138)>0) or (dt(chrno,139)>0) or (dt(chrno,142)>0)) {
            gmulcolor 127,127,127
        }
        strpq 1626+nuseseiton*2+lung,32,useseitonpy+nuseseiton*36+6,mbyte,q
        gmulcolor 255,255,255
        
        if useseitonmodeon=0 and rmx>useseitonpx+2 and rmy>useseitonpy+nuseseiton*36 and rmx<158+useseitonpx and rmy<useseitonpy+nuseseiton*36+36 {
            if (useseitonsely=nuseseiton) or (dt(8,1290)=1) {
                rmx=0
                useseitonsely=nuseseiton
                gosub *badan
            }
            useseitonsely=nuseseiton
        }
    next
    
        
