        dt(chrno,201+spy+spselpage*sppmax)=dt(chrno,spselmtsort)
        dt(chrno,spselmtsort)=karispselmtsort
        nextmode=1038
        gosub *spuseokngset
    }
    
    if mode=1035 and (dt(chrsely+8,201)!512) and rmx!-1 :nextmode=1032:sppage=0:spy=0:chrno=chrsely+8:gosub *sppagemaxget:gosub *spuseokngset
            
    if (mode=1040 or mode=1041) and rmx!-1 :sppage=0:chrno=chrsely+8:gosub *sppagemaxget
    ;ステータス画面で並べ替えキャラ１人目選択
