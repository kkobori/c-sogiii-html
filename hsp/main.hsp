        if evemychrido(evemychrido(0))\10=1:ins=-1:iwe=0
        if evemychrido(evemychrido(0))\10=2:ins=0:iwe=1
        if evemychrido(evemychrido(0))\10=3:ins=1:iwe=0
        if evemychrido(evemychrido(0))\10=4:ins=0:iwe=-1
        ;上に昇る
