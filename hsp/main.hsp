*mappidset

    putdver++    ;(高速化) putd を作り直すたびに加算。putdan の待機中キャッシュを無効にする
    maekeydoorsw=-1

    ;(高速化) *nsweget のif連鎖とgosubを廃止。向きごとの係数を1回だけ決める(x=ix+ax*dpx+bx*dpy+c, y=iy+ay*dpx+by*dpy+c)
    ;  c: m=前 l=左 r=右 f=床/天井。*nsweget(他の呼び出し元用)と同じ値になる
    nwax=1:nwbx=0:nway=0:nwby=1:maeget=0:lrget=1
    nwmx=-2:nwmy=0:nwlx=-2:nwly=0:nwrx=-1:nwry=0:nwfx=-2:nwfy=0
    if ins=1 and iwe=0 {
        nwax=-1:nwbx=0:nway=0:nwby=-1:maeget=0:lrget=1
        nwmx=2:nwmy=-1:nwlx=3:nwly=0:nwrx=2:nwry=0:nwfx=2:nwfy=0
    }
    if ins=0 and iwe=1 {
        nwax=0:nwbx=1:nway=-1:nwby=0:maeget=1:lrget=0
        nwmx=1:nwmy=2:nwlx=0:nwly=2:nwrx=0:nwry=1:nwfx=0:nwfy=2
    }
    if ins=0 and iwe=-1 {
        nwax=0:nwbx=-1:nway=1:nwby=0:maeget=1:lrget=0
        nwmx=0:nwmy=-2:nwlx=0:nwly=-3:nwrx=0:nwry=-2:nwfx=0:nwfy=-2
    }

    for dpfr,0,5        ;高低
        getdpfr=fr+dpfr-2
        for dpy,-1,5        ;奥行
            for dpx,0,6    ;左右
                getmaedpx=ix+nwax*dpx+nwbx*dpy+nwmx:getmaedpy=iy+nway*dpx+nwby*dpy+nwmy
                getldpx=ix+nwax*dpx+nwbx*dpy+nwlx:getldpy=iy+nway*dpx+nwby*dpy+nwly
                getrdpx=ix+nwax*dpx+nwbx*dpy+nwrx:getrdpy=iy+nway*dpx+nwby*dpy+nwry
                getfrdpx=ix+nwax*dpx+nwbx*dpy+nwfx:getfrdpy=iy+nway*dpx+nwby*dpy+nwfy
                ;putd(dpfr,dpx,dpy+1,0)=peek(mapd(getdpfr  ,getmaedpx,getmaedpy),maeget);前
                ;putd(dpfr,dpx,dpy+1,1)=peek(mapd(getdpfr  ,getldpx  ,getldpy  ),lrget);左
                ;putd(dpfr,dpx,dpy+1,2)=peek(mapd(getdpfr  ,getrdpx  ,getrdpy  ),lrget);右
                ;putd(dpfr,dpx,dpy+1,3)=peek(mapd(getdpfr+1,getfrdpx ,getfrdpy ),2);床
                ;putd(dpfr,dpx,dpy+1,4)=peek(mapd(getdpfr  ,getfrdpx ,getfrdpy ),2);天井
                putd(dpfr,dpx,dpy+1,0)=peek(mapd(getdpfr-dmindanf  ,getmaedpx-dmindanx,getmaedpy-dmindany),maeget);前
                putd(dpfr,dpx,dpy+1,1)=peek(mapd(getdpfr-dmindanf  ,getldpx-dmindanx  ,getldpy-dmindany  ),lrget);左
                putd(dpfr,dpx,dpy+1,2)=peek(mapd(getdpfr-dmindanf  ,getrdpx-dmindanx  ,getrdpy-dmindany  ),lrget);右
                putd(dpfr,dpx,dpy+1,3)=peek(mapd(getdpfr+1-dmindanf,getfrdpx-dmindanx ,getfrdpy-dmindany ),2);床
                putd(dpfr,dpx,dpy+1,4)=peek(mapd(getdpfr-dmindanf  ,getfrdpx-dmindanx ,getfrdpy-dmindany ),2);天井
                putd(dpfr,dpx,dpy+1,5)=0

                ;イベントがあるならセットする
                if putd(dpfr,dpx,dpy+1,3)=5 {
                    if eveloctoid(getdpfr-dmindanf,getfrdpx-dmindanx,getfrdpy-dmindany)>0 {
                        checkeveno=eveloctoid(getdpfr-dmindanf,getfrdpx-dmindanx,getfrdpy-dmindany)-1
                        gosub *evecheck
                        evestartswokng=0
                        if checkeveno>-1 {
                            eveyuukouparameta=bbget(evepropaty(checkeveno,3),9,8);イベントが有効となるスイッチなどのパラメータ
                            eveyuukousyurui=bbget(evepropaty(checkeveno,3),17,3);イベントが有効となる条件の種類
                            evestartsw=bbget(dt(8,1225+eveyuukouparameta/32),(eveyuukouparameta\32),1)
                            if eveyuukousyurui=1 and evestartsw=1:evestartswokng=1
                            if eveyuukousyurui=2 and evestartsw=0:evestartswokng=1
                        }
                        if evechrno>0 and evestartswokng=0:putd(dpfr,dpx,dpy+1,5)=evechrno
                    }
                }
        

                    
                ;スイッチ付きオブジェの場合
                hendrf=getdpfr-dmindanf
                ;正面
                if putd(dpfr,dpx,dpy+1,0)=63 {
                    
                    hendrx=getmaedpx-dmindanx
                    hendry=getmaedpy-dmindany
                    
                    ;a=wpeek(keydoorswno(getdpfr,getmaedpx,getmaedpy,maeget),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,maeget),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;c=peek(keydoorswno(getdpfr,getmaedpx,getmaedpy,maeget),2+b);sw on off objno
                    c=peek(keydoorswno(hendrf,hendrx,hendry,maeget),2+b);sw on off objno
                                        
                    ;a=bbget(doordata(drswno,1),10,6)                        
                    if ins=-1 and (c=9 or c=10):c=0
                    if ins=1 and (c=7 or c=8):c=0
                    if iwe=-1 and (c=9 or c=10):c=0
                    if iwe=1 and (c=7 or c=8):c=0
                    
                    putd(dpfr,dpx,dpy+1,0)=1000+c
                        
                }
                ;左
                if putd(dpfr,dpx,dpy+1,1)=63 {
                    
                    hendrx=getldpx-dmindanx
                    hendry=getldpy-dmindany

                    ;a=wpeek(keydoorswno(getdpfr,getldpx,getldpy,lrget),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,lrget),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;c=peek(keydoorswno(getdpfr,getldpx,getldpy,lrget),2+b);sw on off objno
                    c=peek(keydoorswno(hendrf,hendrx,hendry,lrget),2+b);sw on off objno
                    
                    if ins=-1 and (c=9 or c=10):c=0
                    if ins=1 and (c=7 or c=8):c=0
                    if iwe=-1 and (c=7 or c=8):c=0
                    if iwe=1 and (c=9 or c=10):c=0
                        
                        putd(dpfr,dpx,dpy+1,1)=1000+c
                }
                ;右
                if putd(dpfr,dpx,dpy+1,2)=63 {
                    
                    hendrx=getrdpx-dmindanx
                    hendry=getrdpy-dmindany

                    ;a=wpeek(keydoorswno(getdpfr,getrdpx,getrdpy,lrget),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,lrget),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;c=peek(keydoorswno(getdpfr,getrdpx,getrdpy,lrget),2+b);sw on off objno
                    c=peek(keydoorswno(hendrf,hendrx,hendry,lrget),2+b);sw on off objno
                    
                    if ins=-1 and (c=7 or c=8):c=0
                    if ins=1 and (c=9 or c=10):c=0
                    if iwe=-1 and (c=9 or c=10):c=0
                    if iwe=1 and (c=7 or c=8):c=0

                    putd(dpfr,dpx,dpy+1,2)=1000+c
                }
                ;床
                if putd(dpfr,dpx,dpy+1,3)=63 {

                    hendrx=getfrdpx-dmindanx
                    hendry=getfrdpy-dmindany

                    ;a=wpeek(keydoorswno(getdpfr+1,getfrdpx,getfrdpy,2),0);swno.
                    a=wpeek(keydoorswno(hendrf+1,hendrx,hendry,2),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;c=peek(keydoorswno(getdpfr+1,getfrdpx,getfrdpy,2),2+b);sw on off objno
                    c=peek(keydoorswno(hendrf+1,hendrx,hendry,2),2+b);sw on off objno
                    
                    putd(dpfr,dpx,dpy+1,3)=1000+c
                }
        

        
        
                ;天井
                if putd(dpfr,dpx,dpy+1,4)=63 {

                    hendrx=getfrdpx-dmindanx
                    hendry=getfrdpy-dmindany

                    ;a=wpeek(keydoorswno(getdpfr,getfrdpx,getfrdpy,2),0);swno.
                    a=wpeek(keydoorswno(hendrf,hendrx,hendry,2),0);swno.
                    b=bbget(dt(8,1225+a/32),(a\32),1)
                    ;c=peek(keydoorswno(getdpfr,getfrdpx,getfrdpy,2),2+b);sw on off objno
                    c=peek(keydoorswno(hendrf,hendrx,hendry,2),2+b);sw on off objno
                    
                    putd(dpfr,dpx,dpy+1,4)=1000+c
                }
            next
        next
    next

return

