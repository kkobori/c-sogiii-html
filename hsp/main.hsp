*doorswichnoset
    
    ;fr,x,y,0=ns   swno. 1=ns   sw off objno. 2=ns   sw on objno.
    ;       3=we   swno. 4=we   sw off objno. 5=we   sw on objno.
    ;       6=yuka swno. 7=yuka sw off objno. 8=yuka sw on objno.

    ;dim mapstepon,1,dlendanf,dlendanx,dlendany;area,fr,x,y
    ;dim keydoorswno,256,256,256,3
    dim keydoorswno,dlendanf,dlendanx,dlendany,3
        
    ;データを格納する
    for drswnn,0,256
        
        if doordata(drswnn)!0 {
        
            getdrfr=bbget(doordata(drswnn,0),0,8)
            getdrx=bbget(doordata(drswnn,0),8,8)
            getdry=bbget(doordata(drswnn,0),16,8)
            getdrnswe=bbget(doordata(drswnn,0),24,2)
            
            hendrf=getdrfr-dmindanf
            hendrx=getdrx-dmindanx
            hendry=getdry-dmindany
            
            ;swno         wpoke
            wpoke keydoorswno(hendrf,hendrx,hendry,getdrnswe),0,bbget(doordata(drswnn,1),0,10)
            ;off objno    poke
            poke keydoorswno(hendrf,hendrx,hendry,getdrnswe),2,bbget(doordata(drswnn,1),10,6)
            ;on  objno    poke    
            poke keydoorswno(hendrf,hendrx,hendry,getdrnswe),3,bbget(doordata(drswnn,1),16,6)
/*
            ;swno         wpoke
            wpoke keydoorswno(getdrfr,getdrx,getdry,getdrnswe),0,bbget(doordata(drswnn,1),0,10)
            ;off objno    poke
            poke keydoorswno(getdrfr,getdrx,getdry,getdrnswe),2,bbget(doordata(drswnn,1),10,6)
            ;on  objno    poke    
            poke keydoorswno(getdrfr,getdrx,getdry,getdrnswe),3,bbget(doordata(drswnn,1),16,6)
*/
        }
                    
    next
    
return

;店で買える数がそれぞれのアイテムいくつなのかセットする
*shopbuynset

    shopbuygoldmax=0
    shopbuynmax=0
        
    ;shopbuyn(,0-2) 0=買いたい数 1=既に持っている数 2=買える最大数
    for nnnnnn,0,shopitemmax
        ;それぞれあといくつ買えるか　持っている数に対して
        shopbuyn(nnnnnn,1)=0
        shopbuyn(nnnnnn,2)=99
        for nnn,713,1225
            if shopitem(nnnnnn)=dt(8,nnn) {
                shopbuyn(nnnnnn,1)=dt(9,nnn)
                shopbuyn(nnnnnn,2)=99-dt(9,nnn)
            }
        next
        
        ;金額
        buygold=itemd(shopitem(nnnnnn),0)
        buygold=buygold-(buygold*dtspecial(8,4))/10
        if dtspecial(8,4)>0 and buygold=itemd(shopitem(nnnnnn),0) and buygold>1:buygold--

        ;全部買った場合にいくらかかるか
        shopbuygoldmax=shopbuygoldmax+buygold*shopbuyn(nnnnnn,0)
        ;全部買った場合にいくつになるか
        shopbuynmax=shopbuynmax+shopbuyn(nnnnnn,0)
    next
        
    ;買った場合にいくら残るか
    shopbuygoldnokori=dt(8,8)-shopbuygoldmax

    ;それぞれあといくつ買えるか　持っているお金に対して
    for nnnnnn,0,shopitemmax
        nnnnnnnnn=99
        if buygold>0 {
            nnnnnnnnn=(shopbuygoldnokori+buygold*shopbuyn(nnnnnn,0))/buygold
        }
        if nnnnnnnnn<shopbuyn(nnnnnn,2):shopbuyn(nnnnnn,2)=nnnnnnnnn
    next
        
return

;店で売る数がそれぞれのアイテムいくつなのかセットする
*shopsellnset
    
        
    shopsellnmax=0
    shopsellgold=0
        
    ;shopselln(,0-1) 0=売りたい数 1=持っている数
    for nnnnnn,713,1225
        ;それぞれあといくつ買えるか　持っている数に対して    
        shopselln(nnnnnn,1)=dt(9,nnnnnn)
        if dt(8,nnnnnn)<512 {
            ;全部売った場合にいくらになるか
            shopsellgold=shopsellgold+(itemd(dt(8,nnnnnn),0)/2)*shopselln(nnnnnn,0)
            ;全部売った場合にいくになるか
            shopsellnmax=shopsellnmax+shopselln(nnnnnn,0)
        }
    next
                
return

*itemidset
    dim itemsortset,65536
    dim itemsortid,itemmax
    dim itemsortid2,itemmax;ID→並び順
    for n,0,itemmax,1
        ;IDが０の場合はセットする
        if itemd(n,91)=0 {
            for idnnn,1,itemmax+1
                if itemidonoff(idnnn)=0:itemd(n,91)=idnnn:itemidonoff(idnnn)=1:idnnn=itemmax+10
            next
        }
        if itemd(n,91)!0:itemidonoff(itemd(n,91))=1
        ;並び順が０の場合はセットする
        if itemd(n,90)=0:itemd(n,90)=itemd(n,91)*100
        itemsortset(itemd(n,90))=itemd(n,91)
    next
        
    itemsortcnt=0
    for n,0,65536
        if itemsortset(n)!0 {
            ;並び順にIDをセットする
            itemsortid(itemsortcnt)=itemsortset(n)-1
            ;IDに並び順をセットする
            itemsortid2(itemsortset(n)-1)=itemsortcnt
            itemsortcnt++
        }
    next
    
    ;gosub *itemnmset
        
return

