*trapwarp
            
    warpyukadat=1
    warptendat=0
    warpndat=0
    warpsdat=0
    warpwdat=0
    warpedat=0
        
    warpcnt=0
            
    while (warpyukadat>0) or warptendat=2 or ((warpndat=0) and (warpsdat=0) and (warpwdat=0) and (warpedat=0))
        
        warpcnt++
        
        warpx=rnd(16)
        warpy=rnd(16)

        ;henfr=()-dmindanf
        ;henix=()-dmindanx
        ;heniy=()-dmindany
        warpyukadat=peek(mapd(fr+1-dmindanf,mindanx+warpx-dmindanx  ,mindany+warpy-dmindany  ),2)
         warptendat=peek(mapd(fr-dmindanf  ,mindanx+warpx-dmindanx  ,mindany+warpy-dmindany  ),2)
           warpndat=peek(mapd(fr-dmindanf  ,mindanx+warpx-dmindanx  ,mindany+warpy-dmindany  ),0)
           warpsdat=peek(mapd(fr-dmindanf  ,mindanx+warpx-dmindanx  ,mindany+warpy-1-dmindany),0)
           warpwdat=peek(mapd(fr-dmindanf  ,mindanx+warpx-dmindanx  ,mindany+warpy-dmindany  ),1)
           warpedat=peek(mapd(fr-dmindanf  ,mindanx+warpx+1-dmindanx,mindany+warpy-dmindany  ),1)

    wend

    gosub *trapnoget
    poke dt(13,713+trapsetno),1,30+rnd(150)
    henfr=(fr+1)-dmindanf
    henix=(ix)-dmindanx
    heniy=(iy)-dmindany
    poke mapd(henfr,henix,heniy),2,0
            
    warptrapon=1

    ix=mindanx+warpx
    iy=mindany+warpy
        
    gosub *mappidset
            
return

