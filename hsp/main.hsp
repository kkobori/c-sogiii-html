*mongpload
    pdcValid=0    ;(高速化) putdan キャッシュ無効化(キャラ画像バッファ再読込のため)
                
    ;dim mgpexy,64,64
    ;mongpxmax=32
    ;mongpymax=32
    ;monpud=0
                
    ;if mode=7000:mgploadseln=mgpseln
    ;if (mode/1000)=4:mgploadseln=mond(monsel,0)
    ;if mode=1010:mgploadseln=evechrno-1
    dim chrgpxsize,mgpnomax
    dim chrgpysize,mgpnomax
    dim chrpudpos,mgpnomax
    
    for mgploadseln,0,mgpnomax
            
        setfolder=folder+"mgp/"
        exist setfolder+"mgsog"+str(mgploadseln)+".mgd"

        siz=strsize
                
        dim sdata,siz/4
                
        if siz!-1 {
        
            bload setfolder+"mgsog"+str(mgploadseln)+".mgd",sdata
        
            mgpbitmode=bbget(sdata(0),0,3)
            mongpxmax=bbget(sdata(0),3,8)
            mongpymax=bbget(sdata(0),11,8)
            monpud=bbget(sdata(0),19,2)
            
            chrgpxsize(mgploadseln)=mongpxmax
            chrgpysize(mgploadseln)=mongpymax
            chrpudpos(mgploadseln)=monpud
        
            ;sogiiiでは　mgpbitmodeは1(2bit)で固定
            if mgpbitmode=0:datann=mongpxmax*mongpymax/32
            if mgpbitmode=1:datann=mongpxmax*mongpymax/16
            if mgpbitmode=2:datann=mongpxmax*mongpymax/8
            if mgpbitmode=3:datann=mongpxmax*mongpymax/4

            sdatacnt=1
            sdatabitcnt=0
        
            for py,0,mongpymax
                for px,0,mongpxmax
            
                    bbd=bbget(sdata(sdatacnt),sdatabitcnt,mgpbitmode+1)
                    ;黒
                    colornoa=255
                    colornor=0;monrgb(btlmon(nn),co,0)*36
                    colornog=0;monrgb(btlmon(nn),co,1)*36
                    colornob=0;monrgb(btlmon(nn),co,2)*36
                    ;1bitデータの場合
                    if mgpbitmode=0 {
                        ;白
                        if bbd=1 {
                            colornor=255;monrgb(btlmon(nn),co,0)*36
                            colornog=255;monrgb(btlmon(nn),co,1)*36
                            colornob=255;monrgb(btlmon(nn),co,2)*36
                        }
                    }
                    ;2bitデータの場合
                    if mgpbitmode=1 {
                        ;透明
                        if bbd=0 {
                            colornoa=0
                        }
                        ;白
                        if bbd=1 {
                            ;color 255,255,255
                            colornor=255;monrgb(btlmon(nn),co,0)*36
                            colornog=255;monrgb(btlmon(nn),co,1)*36
                            colornob=255;monrgb(btlmon(nn),co,2)*36
                        }
                        ;グレー
                        if bbd=2 {
                            ;color 224,224,224
                            colornor=224;monrgb(btlmon(nn),co,0)*36
                            colornog=224;monrgb(btlmon(nn),co,1)*36
                            colornob=224;monrgb(btlmon(nn),co,2)*36
                        }
                    }
                            
            
                    co=int("$"+strf("%02x",colornoa)+strf("%02x",colornob)+strf("%02x",colornog)+strf("%02x",colornor))
            
                    chrgpbfpx=px+((mgploadseln\32)*64)+((64-mongpxmax)/2)
                    chrgpbfpy=py+((mgploadseln/32)*64)
                    if monpud=0:chrgpbfpy=chrgpbfpy+(64-mongpymax)
                    if monpud=1:chrgpbfpy=chrgpbfpy+((64-mongpymax)/2)
                    chrgpbf(chrgpbfpx+chrgpbfpy*2048)=co
            
                    sdatabitcnt=sdatabitcnt+mgpbitmode+1
                    if sdatabitcnt+mgpbitmode+1>32:sdatacnt++:sdatabitcnt=0
        
                next
            next

            mgpediton=0

        }
        
    next
        
    buffer 2,2048,512,screen_offscreen
    gsel 0
    celbitmap 2,chrgpbf,0
        
    ;if mode=1010 and evechrno=0:siz=1

                
return

*vartostr
                
    getg=""

    qwer=8

    notesel mojiq

    for mojisuuuuu,0,4,1
        asdf=mojisuuuuu*8
        aaaaaaaaa=bbget(setgint,asdf,qwer)
        noteget atatatata,aaaaaaaaa
        if aaaaaaaaa!0:getg=getg+atatatata
    next

return

*vartostre

    jj5="　ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ"
        
    getg=""
    
    for mojisuu,0,6,1
        xxxx=mojisuu*5
        aaa=bbget(setgint,xxxx,5)
        xxxx=aaa*mbyte
        if aaa!31:getg=getg+strmid(jj5,xxxx,mbyte)            
    next

return

*evecheck

    eveundertop=bbget(evepropaty(checkeveno,1),28,2)    ;*乗れるか
    evehassei(0)=bbget(evepropaty(checkeveno,2),0,1)    ;*発生方法＝乗る
    evehassei(1)=bbget(evepropaty(checkeveno,2),1,1)    ;*発生方法＝触れる
    evehassei(2)=bbget(evepropaty(checkeveno,2),2,1)    ;発生方法＝ボタン
    evehassei(3)=bbget(evepropaty(checkeveno,2),3,1)    ;発生方法＝自動
    evehassei(4)=bbget(evepropaty(checkeveno,2),12,1)    ;*ボタン表示をオンのままにする
    evehassei(5)=bbget(evepropaty(checkeveno,2),4,8)    ;*ボタンで発生の場合の表示テキストNo.
    evechrno=bbget(evepropaty(checkeveno,2),13,9)        ;*表示キャラNo.
    evechrmuki=bbget(evepropaty(checkeveno,2),22,4)    ;*表示キャラ向き
    evechridou=bbget(evepropaty(checkeveno,2),26,4)    ;*表示キャラ移動速度
    evechrashi=bbget(evepropaty(checkeveno,2),30,1)    ;*表示キャラ足踏み
    evechrmukuka=bbget(evepropaty(checkeveno,2),31,1)    ;*表示キャラ向くかどうか
    evehassei(6)=bbget(evepropaty(checkeveno,3),0,1)    ;発生可能向き＝北 *0の場合は発生する
    evehassei(7)=bbget(evepropaty(checkeveno,3),1,1)    ;発生可能向き＝南 *0の場合は発生する
    evehassei(8)=bbget(evepropaty(checkeveno,3),2,1)    ;発生可能向き＝東 *0の場合は発生する
    evehassei(9)=bbget(evepropaty(checkeveno,3),3,1)    ;発生可能向き＝西 *0の場合は発生する

return


*eve
;eveloc(a) a=8,8,8,8 fr,x,y,イベントのラインの数
;eved(a,b,c)
;        a=イベント№
;        b=イベントライン
;        c=イベントの各パラメータ

    if eveline=0 {
        ;eveno=evenoset(ix,iy,fr)
        l=bbget(eveloc(eveno),24,8)
    }
    
*evelinejump
                
    
    if eveline<evelimax and ((finout=0) or (eveautoonoffset=1)) {

        
        
        evesyurui=bbget(eved(eveno,eveline,0),0,5)

        ;データ無し（イベント終了）
        if evesyurui=0 {
            nextmode=1000
            eveautoonoffset=0
            ;evebtl=0
            evestartonoff=0
            evemsgon=0
            eveoff=1
            gosub *mappidset
        }
        ;処理なし
        if evesyurui=1:eveline++:goto *evelinejump
        ;文章表示
        if evesyurui=2 {

            eveselmodeputx=0
            n2=bbget(eved(eveno,eveline,0),8,1)
            chrnmtxtno=bbget(eved(eveno,eveline,3),16,8)

            eveoff=1
            gosub *getevemsg
            evemsgon=1

            if n2=0:nextmode=2020:meswaitput=0;:msgwindowclosecnt=10
            if n2=1:meswaitput=1
            
            ;if (nextmode=2020 or meswaitput=1) and (mode!2020) {
            ;    if reputmsgmax=255:reputmsgmax=0
            ;    reputmsg(reputmsgmax,0)=eveline
            ;    reputmsg(reputmsgmax,1)=chrnmtxtno
            ;    reputmsgmax++
            ;}
            if n2=1:eveline++:goto *evelinejump
        }
        ;ラベル設定
        if evesyurui=3:eveline++:goto *evelinejump
        ;ラベルジャンプ
        if evesyurui=4:ojline=bbget(eved(eveno,eveline,0),8,8):gosub *evelinejumpset

        ;YES　or NO
        if evesyurui=5:nextmode=2050:yesnoselx=0:eveoff=1
        ;2or3択
        if evesyurui=6 {

            evesely=0
            eveselmodeputx=1
            dim eveseljumpline,4
            eveselmax=bbget(eved(eveno,eveline,0),8,1)+2
            eveseljumpline(0)=bbget(eved(eveno,eveline,1),0,8)
            eveseljumpline(1)=bbget(eved(eveno,eveline,1),8,8)
            eveseljumpline(2)=bbget(eved(eveno,eveline,1),16,8)
            eveseljumpline(3)=bbget(eved(eveno,eveline,1),24,8)

            eveoff=1
            gosub *getevemsg
            evemsgon=1

            nextmode=2025
        }
        
;1225=イベントスイッチ   0- 31
;1226=イベントスイッチ  32- 63
;1227=イベントスイッチ  64- 95
;1228=イベントスイッチ  96-127
;1229=イベントスイッチ 128-159
;1230=イベントスイッチ 160-191
;1231=イベントスイッチ 192-223
;1232=イベントスイッチ 224-255

        ;イベントスイッチのセット
        if evesyurui=7 {
            n2=bbget(eved(eveno,eveline,0),8,10);スイッチNo.
            n3=bbget(eved(eveno,eveline,0),18,2);処理方法
            n4=dt(8,1225+n2/32);dtからデータを取り出す
            ;n5=bbget(n4,,1)
            
;bbins(挿入する数値,セットする数値のbit桁,変換前数値,挿入bitインデックス)

            ;入れ替える
            if n3=2 {
                n5=bbget(n4,(n2\32),1)
                n3=n5
            }
            ;オンにする
            if n3=0 {
                dt(8,1225+n2/32)=bbins(1,1,n4,(n2\32))
                ;dt(0,1024+n2)=1
            }
            ;オフにする
            if n3=1 {
                dt(8,1225+n2/32)=bbins(0,1,n4,(n2\32))
                ;dt(0,1024+n2)=0
            }
            gosub *mappidset
        }

        ;変数のセット
        if evesyurui=8 {
            n2=bbget(eved(eveno,eveline,0),8,12);変数ナンバー
            n3=bbget(eved(eveno,eveline,0),20,4);処理方法
            n4=bbget(eved(eveno,eveline,1),0,24);値
            n5=bbget(eved(eveno,eveline,1),24,4);要素
            ;if n5>11:n5=11
            if n3=0:dt(n5,n2)=n4
            if n3=1:dt(n5,n2)=dt(n5,n2)+n4
            if n3=2:dt(n5,n2)=dt(n5,n2)-n4
            if n3=3:dt(n5,n2)=dt(n5,n2)*n4
            if n3=4 and n4!0:dt(n5,n2)=dt(n5,n2)/n4
            if n3=5 {
                if n4>2047:n4=2047
                dt(n5,n2)=dt(n5,n4)
            }
            if n3=6:dt(n5,n2)=rnd(n4+1)
            if n3=7:dt(n5,n2)=(dt(n5,n2)\n4)
            if n3=8 {
                if n4>1023:n4=1023
                dt(n5,n2)=dt(n5,n2)+dt(n5,n4)
            }
            if n3=9 {
                if n4>1023:n4=1023
                dt(n5,n2)=dt(n5,n2)-dt(n5,n4)
            }
            if n3=10 {
                if n4>1023:n4=1023
                dt(n5,n2)=dt(n5,n2)*dt(n5,n4)
            }
            if n3=11 {
                if n4>1023:n4=1023
                dt(n5,n2)=dt(n5,n2)/dt(n5,n4)
            }
            if n3=12 {
                if n4>1023:n4=1023
                dt(n5,n2)=rnd(dt(n5,n4)+1)
            }
            if n3=13 {
                if n4>1023:n4=1023
                dt(n5,n2)=(dt(n5,n2))\(dt(n5,n4))
            }
        }

        ;条件分岐
        if evesyurui=9 {
            ;条件の種類
            n2=bbget(eved(eveno,eveline,0),8,4)
            ;スイッチオン
            if n2=0 {
                n3=bbget(eved(eveno,eveline,0),12,10)
                n4=bbget(dt(8,1225+n3/32),(n3\32),1)
                ojline=bbget(eved(eveno,eveline,0),22,8)
                if n4=1:gosub *evelinejumpset
            }
            ;変数
            if n2=1 {
                ;                    変数No.左  =+-<>    変数No.右 飛ぶラベル  要素左    要素右
                ;evinp(9)=evinp(9)+"i000121000c100220302i401001000i041100800i021180400i421220400e000000000"

                n3=bbget(eved(eveno,eveline,0),12,12);変数左
                n4=bbget(eved(eveno,eveline,0),24,3);=+-<>
                n5=bbget(eved(eveno,eveline,1),0,12);変数右
                n6=bbget(eved(eveno,eveline,1),20,4)+8;要素左
                n7=bbget(eved(eveno,eveline,1),24,4)+8;要素右
                if n6>3:n6=3
                if n7>3:n7=3
                ojline=bbget(eved(eveno,eveline,1),12,8)
                if n4=0 and dt(n6,n3)==dt(n7,n5):gosub *evelinejumpset
                if n4=1 and dt(n6,n3)>=dt(n7,n5):gosub *evelinejumpset
                if n4=2 and dt(n6,n3)<=dt(n7,n5):gosub *evelinejumpset
                if n4=3 and dt(n6,n3)>dt(n7,n5):gosub *evelinejumpset
                if n4=4 and dt(n6,n3)<dt(n7,n5):gosub *evelinejumpset
                if n4=5 and (dt(n6,n3))!(dt(n7,n5)):gosub *evelinejumpset
            }
            ;*お金ある
            if n2=2 {
                n3=bbget(eved(eveno,eveline,0),12,20)
                ojline=bbget(eved(eveno,eveline,1),0,8)
                if dt(8,8)>=n3:gosub *evelinejumpset
            }
            ;アイテム持っている
            if n2=3 {
                n3=bbget(eved(eveno,eveline,0),12,9)
                ojline=bbget(eved(eveno,eveline,0),21,8)
                ;hitem,2,256,2
                for nnnnn,713,1225,1
                    ;if dt(0,101+nnnnn)=n3:gosub *evelinejumpset:_break
                    if dt(8,nnnnn)=n3 and dt(9,nnnnn)>0:gosub *evelinejumpset:_break
                next    
            }
            ;*256面サイコロ 値以上
            if n2=4 {
                n3=bbget(eved(eveno,eveline,0),12,8)
                ojline=bbget(eved(eveno,eveline,0),20,8)
                if rnd(256)>n3:gosub *evelinejumpset
            }
            ;*キャラの向き
            if n2=6 {
                n3=bbget(eved(eveno,eveline,0),12,2)
                ojline=bbget(eved(eveno,eveline,0),14,8)
                if n3=0 and imuki=1:gosub *evelinejumpset
                if n3=1 and imuki=3:gosub *evelinejumpset
                if n3=2 and imuki=0:gosub *evelinejumpset
                if n3=3 and imuki=2:gosub *evelinejumpset
            }
            ;*キャラがパーティにいる
            if n2=7 {
                n3=bbget(eved(eveno,eveline,0),12,4)
                ojline=bbget(eved(eveno,eveline,0),16,8)
                for nnn,8,partymax+8
                    if dt(nnn,6)=n3:gosub *evelinejumpset
                next
            }
            ;*キャラの職業
            if n2=8 {
                n6=0
                ;n3=bbget(eved(eveno,eveline,0),12,4)
                ;if n3>3:n3=3
                n4=bbget(eved(eveno,eveline,0),16,4)
                ojline=bbget(eved(eveno,eveline,0),20,8)
                ;if dt(n3,10)=n4:gosub *evelinejumpset
                for n5,8,partymax+8,1
                    if dt(n5,10)=n4:n6=1
                next
                if n6=1:gosub *evelinejumpset
            }
            ;*ステータスの数値
            if n2=9 {
                n3=bbget(eved(eveno,eveline,0),12,4)+8
                n4=bbget(eved(eveno,eveline,0),16,4)
                n5=bbget(eved(eveno,eveline,0),20,10)
                if n3>3:n3=3
                ojline=bbget(eved(eveno,eveline,1),0,8)
                if n4=0 and dt(n3,9)>n5:gosub *evelinejumpset;LV
                if n4=1 and dt(n3,dt(n3,10)+11)>n5:gosub *evelinejumpset;EX
                if n4>1 and dt(n3,43+(n4-2))>n5:gosub *evelinejumpset
            }
            
            ;マップチップ    12    -8,8l8,8,5|10,10   38;x,y|No.,一致する場合に飛ぶ行,xとyに入れる値（実数,変数（0-1023）,現在地（128が±0））|変数・現在地の場合の値x,y
            ;bbget(mapset(((x/4),y)),((2+x)\4)*8,8)
            ;*マップチップ
            if n2=11 {
                ojline=bbget(eved(eveno,eveline,1),8,8);飛ぶ行
                n3=bbget(eved(eveno,eveline,1),16,5);0=定数 1=変数 2=現在地)
                n6=bbget(eved(eveno,eveline,1),0,8);マップチップNo.
                if n3=0 {
                    n10=bbget(eved(eveno,eveline,0),12,8);x
                    n11=bbget(eved(eveno,eveline,0),20,8);y
                }
                if n3=1 {
                    n10=dt(8,bbget(eved(eveno,eveline,2),0,10));x
                    n11=dt(8,bbget(eved(eveno,eveline,2),10,10));y
                }
                if n3=2 {
                    n4=bbget(eved(eveno,eveline,2),0,10);x
                    n5=bbget(eved(eveno,eveline,2),10,10);y
                    if n4>255:n4=255                    
                    if n5>255:n5=255
                    n4=n4-128
                    n5=n5-128
                    n10=ix+n4
                    n11=iy+n5
                }
                n7=mapset((n10/4),n11)
                n8=((2+n10)\4)*8
                n9=bbget(n7,n8,8)
                if n9=n6:gosub *evelinejumpset
            }
            ;*アイテム満タン
            if n2=12 {
                ojline=bbget(eved(eveno,eveline,0),12,8)
                ;gosub *itemoffncnt
                if itemoffn=0:gosub *evelinejumpset
            }
            ;*イベントの状態
            if n2=13 {
;イベント            -10,10|2,2,10,2,10,4|8;場所 X,Y|定数か変数か指定無しか,絵 定数か変数か指定無しか,No,イベント番号 定数か変数か指定無しか,No,向き |条件一致の場合の飛ぶ行

                ;eveoff=1
                ojline=bbget(eved(eveno,eveline,2),0,8)
                n3=bbget(eved(eveno,eveline,1),0,2);位置の指定方法
                n4=bbget(eved(eveno,eveline,1),2,2);絵の指定方法
                n5=bbget(eved(eveno,eveline,1),14,2);イベントNo.の指定方法
                n6=bbget(eved(eveno,eveline,1),26,4);向き
                n7=0    ;指定のイベント位置X
                n8=0    ;指定のイベント位置Y
                n9=0    ;指定のイベントNo.
                n10=0    ;n9のイベントNo.の位置X
                n11=0    ;n9のイベントNo.の位置Y
                n12=0    ;n9のイベントNo.の絵
                n13=0    ;n9のイベントNo.の向き
                n14=0    ;指定の絵No.
                n15=0    ;n7,8のイベントNo.
                n16=0    ;n7,8のイベントの絵
                n17=0    ;n7,8のイベントの向き
                n30=0    ;1=条件一致
                n31=0    ;パラメータ代入用１
                n32=0    ;パラメータ代入用２

                ;イベント位置が指定されている場合
                if n!0 {
                    if n3=1 {
                        n7=bbget(eved(eveno,eveline,0),12,10)
                        n8=bbget(eved(eveno,eveline,0),22,10)
                    }
                    if n3=2 {
                        n31=bbget(eved(eveno,eveline,0),12,10)
                        n32=bbget(eved(eveno,eveline,0),22,10)
                        n7=dt(8,n31)
                        n8=dt(8,n32)
                    }
                    if evemapset(n7,n8,0)=1 {
                        n15=evemapset(n7,n8,1)    ;n7,8のイベントNo.
                        n16=evemapset(n7,n8,8)    ;n7,8のイベントの絵
                        n17=evemapset(n7,n8,9)    ;n7,8のイベントの向き
                    }
                }

                
                ;イベントNo.が指定されている場合
                if (n5!0) {
                    ;イベントNo.をn9にセット
                    if n5=1 {
                        n9=bbget(eved(eveno,eveline,1),16,10)
                    }
                    if n5=2 {
                        n31=bbget(eved(eveno,eveline,1),16,10)
                        n9=dt(8,n31)
                    }

                    evecheckno=n9
                    gosub *evemaplocateget
                    ;epx epyに位置が返る

                    ;n9のイベントNo.が存在する場合
                    if evegono!111111 {
                        n10=epx
                        n11=epy
                        n12=evemapset(n10,n11,8)    ;n9のイベントNo.の絵
                        n13=evemapset(n10,n11,9)    ;n9のイベントNo.の向き
                    }
                }

                ;指定の絵No.
                if n4=1 {
                    n14=bbget(eved(eveno,eveline,1),4,10)
                }
                if n4=2 {
                    n31=bbget(eved(eveno,eveline,1),4,10)
                    n14=dt(8,n31)
                }

                if n3!0 and n4=0 and n5=0 and n6=0 {    ;位置のみ　その位置にイベントが存在するか
                    if evemapset(n7,n8,0)=1:n30=1
                }
                if n3!0 and n4!0 and n5=0 and n6=0 {    ;位置と絵　その位置にイベントがあった場合に絵がパラメータと一致するか
                    if evemapset(n7,n8,0)=1 {
                        if n16=n14:n30=1
                    }
                }
                if n3!0 and n4=0 and n5!0 and n6=0 {    ;位置とイベントNo.　その位置にイベントがあった場合にイベントNo.がパラメータと一致するか

                }
                if n3!0 and n4=0 and n5=0 and n6!0 {    ;位置と向き　その位置にイベントがあった場合にその方向を向いているか

                }
                if n3=0 and n4!0 and n5!0 and n6=0 {    ;イベントNo.と絵　そのイベントNo.があった場合に絵がパラメータと一致するか

                }
                if n3=0 and n4=0 and n5!0 and n6!0 {    ;イベントNo.と向き　そのイベントNo.があった場合にその方向をむいているか

                }
                if n3!0 and n4!0 and n5!0 and n6!0 {    ;全てのパラメータが一致しているか

                }
                if n30=1:gosub *evelinejumpset
            }
            ;*パーティの人数
            if n2=14 {
                if partymax=1:ojline=bbget(eved(eveno,eveline,0),12,8)
                if partymax=2:ojline=bbget(eved(eveno,eveline,0),20,8)
                if partymax=3:ojline=bbget(eved(eveno,eveline,1),0,8)
                if partymax=4:ojline=bbget(eved(eveno,eveline,1),8,8)
                gosub *evelinejumpset
    
            }
            ;*自分の位置
            if n2=15 {
                n3=bbget(eved(eveno,eveline,0),12,8)
                n4=bbget(eved(eveno,eveline,0),20,8)
                ojline=bbget(eved(eveno,eveline,1),0,8)
                if ix=n3 and iy=n4:gosub *evelinejumpset
            }

        }

        ;場所移動
        if evesyurui=10 {
            ;eveoff=1
            ;finout=1

            fr=bbget(eved(eveno,eveline,0),8,8)
            ix=bbget(eved(eveno,eveline,0),16,8)
            iy=bbget(eved(eveno,eveline,0),24,8)
            n2=bbget(eved(eveno,eveline,1),0,3)
            nextbgm=bbget(eved(eveno,eveline,1),3,1)
            if n2=1:ins=1:iwe=0
            if n2=2:ins=0:iwe=-1
            if n2=3:ins=-1:iwe=0
            if n2=4:ins=0:iwe=1
            gosub *mappidset
            
        }

        ;キャラ動き
        ;案　前進　後退　右を向く　左を向く　昇る　降りる
        ;　　北へ進む　南へ進む　東へ進む　西へ進む
        ;　　北を向く　南を向く　東を向く　西を向く
