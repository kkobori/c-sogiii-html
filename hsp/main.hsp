*keywait

    if rmx!-1 {
        ;if mode=1005:nextmode=1000
        ;スキル選択時　何も覚えていない
        if mode=1030 and (dt(chrno,201)=512):nextmode=1035
        if mode=1065 :nextmode=1090:eqipy=0
        if mode=1210 and simode=1 :nextmode=1020
        if mode=1210 and simode=0 :nextmode=1030
        if mode=1300 or mode=1310 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                if mode=1300:nextmode=1020
                if mode=1310:nextmode=1030
                if sinextmode>999:nextmode=sinextmode
                gosub *bdtonset
            }
        }
        if mode=1415 :nextmode=1417
        if mode=1515 :nextmode=1517
        if mode=4415 :nextmode=4417
        if mode=1417 or mode=1517 or mode=4417 {
            if (trapoff(trapoffcsl)=1 or trapoff(trapoffcsl+1)=1) and (mode=1417 or mode=4417):nextmode=mode+13;1430
            ;ワナの処理が完了
            if (trapoff(trapoffcsl)=1 or trapoff(trapoffcsl+1)=1) and mode=1517 {
                nextmode=1000
                tgetfr=fr
                tgetix=ix
                tgetiy=iy
                gosub *trapnoget
                poke dt(13,713+trapsetno),1,30+rnd(150)
                henfr=(fr+1)-dmindanf
                henix=(ix)-dmindanx
                heniy=(iy)-dmindany
                poke mapd(henfr,henix,heniy),2,0
            }
            if trapoff(trapoffcsl)=0 and trapoff(trapoffcsl+1)=0 {
                gosub *btlchrnmstrset
                if mode=1417:nextmode=1420
                if mode=1517:nextmode=1520
                if mode=4417:nextmode=4420
                simode=1
                spitemno=trapno
                gosub *siduseset
                
                ;対象の設定
                k1=siduse(3)
                k2=siduse(6)
                hanni=siduse(8)
                selmode=0    ;0=モンスター単体 1=プレイヤー単体 2=モンスター全体 3=プレイヤー全体 4=本人
                if hanni<2 and (k1=10 or k1=11 or k1=12 or k1=19 or k1=21 or k1=22 or k1=23 or k1=28 or k1=32 or k1=36 or k1=39 or k1=45 or k1=56 or k1=57 or k1=58 or k2=10 or k2=11 or k2=12 or k2=19 or k2=21 or k2=22 or k2=23 or k2=28 or k2=32 or k2=36 or k2=39 or k2=45 or k2=56 or k2=57 or k2=58) {
                    ;全体                
                    if hanni=1:selmode=3
                    ;単体
                    if hanni=0:selmode=1
                }
                ;選択モードによる選択先の設定
                ;プレイヤー単体
                if selmode=1 {
                    if partymax>0 {
                        spchrno_1=rnd(partymax)+8
                        while dt(spchrno_1,110)<1
                            spchrno_1=rnd(partymax)+8    
                        wend
                    }
                    spchrno_2=spchrno_1                
                }
                ;プレイヤー全体
                if selmode=3:spchrno_1=8:spchrno_2=8+partymax-1

                usespno=trapno
                gosub *btlchrnmstrset
                gosub *btlkoukaset
                gosub *bdtonset
            }
        }
        if mode=1420 or mode=1520 or mode=4420 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                if mode=1420:nextmode=1430
                if mode=4420:nextmode=4430
                ;ワナの処理が完了
                if mode=1520 {
                    nextmode=1000
                    if warptrapon=0 {
                        tgetfr=fr
                        tgetix=ix
                        tgetiy=iy
                        gosub *trapnoget
                        poke dt(13,713+trapsetno),1,30+rnd(150)
                        henfr=(fr+1)-dmindanf
                        henix=(ix)-dmindanx
                        heniy=(iy)-dmindany
                        poke mapd(henfr,henix,heniy),2,0
                        ;poke mapd(fr+1,ix,iy),2,0
                    }
                    warptrapon=0
                }
                if takaragetok=0:nextmode=1000
                gosub *btlmsgreset
                dim hpzero,12
            }
        }
        ;宝箱から宝入手
        if mode=1430 or mode=4430 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                nextmode=1000
            }
        }
        ;ワナがしかけられていた！
        if mode=1500:eveline++:nextmode=1505
        if mode=1505:eveline++:nextmode=1510
        ;if mode=2020:eveline++:nextmode=2000
        
        ;マイショップ　〇〇goldうれました！
        if mode=2305 {
            nextmode=2300
            dt(8,8)=dt(8,8)+getmyshopgold
        }
        
        if mode=4040 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                nextmode=4010
                gosub *bdtonset
                ;誰かがHPゼロになったときはnextmode=4050
                ;ここでは*btlkoukasetの時点で誰かがHPゼロになった場合で
                ;バトルが終了するチェックを行う
                if nextmode=4010:updownijouoffon=0:gosub *btlendcheck
            }
        }
        if mode=4050 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                nextmode=4010
                gosub *hpautorevivecheck
                if hpautoreviveon=0:gosub *btlendcheck
            }
        }
        if mode=4060 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                
                nextmode=1000
                if btlend=1:takaracheckon=1
                
                ;EX獲得とレベルが上がるかどうか
                gosub *btlmsgreset                
                notesel q
                dim motolv,12
                dim spgetparty,12
                for nn,8,partymax+8
                
                    ;生きている
                    if dt(nn,110)>0 {
                        
                        ;EX獲得
                        ;dt(nn,11+job)=dt(nn,11+job)+getex
                        ;if dt(nn,11+job)>999999999:dt(nn,11+job)=999999999
                        
                        motolv(nn)=dt(nn,9)
                        job=dt(nn,10)
                        
                        ;LVUPのチェック
                        exn=-1
                        while dt(nn,11+job)>=exn
                        
                            lv=dt(nn,9)
                            gosub *lvupex
                        
                            ;LVUPの場合の値セットとスキルを覚えるかチェック
                            if dt(nn,11+job)>=exn {
                                nextmode=4061
                                takaracheckon=0
                                dt(nn,9)++
                                dt(nn,43+job)=dt(nn,9)
                                chrno=nn
                                gosub *statsset
                                gosub *spgetcheck
                                spgetparty(nn)=spgetparty(nn)+spget
                            }
                        wend
                        
                        ;レベルが上がったメッセージセット
                        if motolv(nn)<dt(nn,9) {
                            noteget msgset1,916+lung
                            btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1
                            btlmsgmaxcnt++
                            
                            ;スキルを覚えたメッセージセット
                            if spgetparty(nn)>0 {
                                noteget msgset1,918+lung
                                noteget msgset2,920+lung
                                 btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1+vzstr(spgetparty(nn),mbyte)+msgset2
                            
                            }
                            btlmsgmaxcnt++
                            btlmsgmaxcnt++
                        }
                    }
                next
            }
        }
        if mode=4061 {
            if btlmsgcnt+3<btlmsgmaxcnt {
                btlmsgcnt=btlmsgcnt+3
            } else {
                nextmode=1000
                if btlend=1:takaracheckon=1
            }
        }
        if mode=4062 {
            nextmode=4400
        }
        ;逃げるコマンドを選んだ結果
        if mode=4100 {
            nextmode=4010
            if plescape=1:gosub *btlendcheck:nextmode=1000
        }
        ;スキル選択時　何も覚えていない
        if mode=4110 {
            if (dt(btlchrno,201)=512):nextmode=4020
        }
    }
        
return

