    ;調査員を外す
    if partymax!0:tsumesyomenu(tsumesyomax)=1:tsumesyomax++
    ;調査員の登録
    if waitplayern<(20-partymax):tsumesyomenu(tsumesyomax)=2:tsumesyomax++
    ;調査員の登録抹消
    if waitplayern!0:tsumesyomenu(tsumesyomax)=3:tsumesyomax++
    ;ステータス
    if waitplayern!0:tsumesyomenu(tsumesyomax)=4:tsumesyomax++
    ;調査員の名前変更
    if waitplayern!0:tsumesyomenu(tsumesyomax)=5:tsumesyomax++
    ;名簿順入れ替え
    if waitplayern>1:tsumesyomenu(tsumesyomax)=6:tsumesyomax++
    
    ;調査にでる人がHP１以上あるかどうか
    for nn,8,partymax+8,1
        if dt(nn,110)!0:nnn=1
    next
    
    ;調査開始
