    btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+spacestr+msgset2+msgset3+spacestr+vzstr(downex,mbyte)+spacestr+msgset4
    btlmsgmaxcnt++
    
