    if (chrsely!selxy) and (mode=1045 or mode=1040):sppage=0:chrno=selxy:gosub *sppagemaxget
    selyon=selon:chrsely=selxy
    if mode=1045 or mode=1040:chrno=chrsely:gosub *sppagemaxget

    if selyon=1:tmx=0:gosub *badan

    if mode!2190:tctcc=tsc(mx,my,motomx,motomy,btnonoff,0+pxp,440-32*(partymax-1)+pyp,134+pxp,478+pyp)
    if mode=2190:tctcc=tsc(mx,my,motomx,motomy,btnonoff,0+pxp,440-32*(partymax-1)+pyp-32,134+pxp,478+pyp)
