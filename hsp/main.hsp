*btnposini

    for btnn,0,5
        btnpos(3,0,btnn)=0
        btnpos(3,1,btnn)=640-ios*80
        btnpos(1,0,btnn)=100
        btnpos(1,1,btnn)=640-ios*80
        btnpos(0,0,btnn)=50
        btnpos(0,1,btnn)=560-ios*80
        btnpos(2,0,btnn)=50
        btnpos(2,1,btnn)=720-ios*80
    next

    btnpos(4,0,0)=380
    btnpos(4,1,0)=640-ios*80
    btnpos(5,0,0)=280
    btnpos(5,1,0)=640-ios*80

    btnpos(4,0,1)=150
    btnpos(4,1,1)=720-ios*80
    btnpos(5,0,1)=200
    btnpos(5,1,1)=640-ios*80

    btnpos(4,0,2)=150
    btnpos(4,1,2)=720-ios*80
    btnpos(5,0,2)=200
    btnpos(5,1,2)=640-ios*80

    btnpos(4,0,3)=240
    btnpos(4,1,3)=720-ios*80
    btnpos(5,0,3)=180
    btnpos(5,1,3)=640-ios*80

    btnpos(5,0,4)=240
    btnpos(5,1,4)=720-ios*80
    btnpos(4,0,4)=180
    btnpos(4,1,4)=640-ios*80

    btnpos(3,0,3)=0+280
    btnpos(1,0,3)=100+280
    btnpos(0,0,3)=50+280
    btnpos(2,0,3)=50+280

    btnpos(3,0,4)=0+280
    btnpos(1,0,4)=100+280
    btnpos(0,0,4)=50+280
    btnpos(2,0,4)=50+280

    for btnn,0,5
        for n,0,6,1
            btnpos(n,2,btnn)=btnpos(n,0,btnn)+100
            btnpos(n,3,btnn)=btnpos(n,1,btnn)+80
            btnpos(n,4,btnn)=btnpos(n,0,btnn)+42
            btnpos(n,5,btnn)=btnpos(n,1,btnn)+28
        next
    next
        

        
return

*admobisset

    ;表示するサイクル
    admobontime=1;5
            
    getreq lookimaadmobtime,SYSREQ_timer

    ;windows
    ;疑似的な処理のみ
    if ((admobiscnt=0) or (lookimaadmobtime>looklastadmobtime+(1000*5))) and (mbyte=2) {
        admobiscnt++
        getreq looklastadmobtime,SYSREQ_timer
    }
            
    ;android
    ;前回表示から５分たっていれば表示できる・初回表示の場合は無条件で表示
    if ((admobiscnt=0) or (lookimaadmobtime>looklastadmobtime+(1000*60*3))) and (mbyte=3) {
    
    
        ;表示する直前
        if (admobiscnt\admobontime)=(admobontime-1) {
            devcontrol "AdMob",17
            admobiscnt++
        }
        ;表示する
        if (admobiscnt\admobontime)=0 {
            admobres=-1
            admobwaitcnt=0
            while admobres=-1
                devcontrol "AdMob",18
                admobres=stat
                if (admobres>0 and admobiscnt=0) or (admobwaitcnt>1 and admobres>0 and admobiscnt>0) {
                    mmvol 1,-1000;ボリュームをいったん下げる
                    admobisvolcnt=90;ボリュームをいったん下げる
                    await 100
                    admobiscnt++
                    devcontrol "AdMob",16
                    getreq looklastadmobtime,SYSREQ_timer
                } else {
                    admobres=-1
                }
                admobwaitcnt++
                await 100
            
                ;表示できなかった？
                if admobres=-1 and admobwaitcnt=35 {
                    admobres=-2
                    ;mmvol 1,-1000;ボリュームをいったん下げる
                    ;admobisvolcnt=90;ボリュームをいったん下げる
                }
            wend
        }
        
        ;表示しないタイミング
        ;if ((admobiscnt\admobontime)!0) and ((admobiscnt\admobontime)!(admobontime-1)) {
        ;    admobiscnt++
        ;}
    }
    
return


