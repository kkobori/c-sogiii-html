    eqipputxwidth=215
    if mode=1080 or mode=1090 or mode=1180 or mode=1185 or mode=1190 or mode=4070 or mode=4080 {
        eqipputxwidth=295
    }
    
    motopxp=pxp
    pxp=0
    
    eqippyset=387+(mode=4070)*160+(mode=4075)*72    
    
    eqipboxco=4
    if mode=1090 or mode=1190 or mode=4070:eqipboxco=1
    
    boli eqipboxco,pxp,(eqippyset+pyp)-eqippmax*36+pyp,eqipputxwidth+pxp,(eqippyset+pyp)+pyp

    notesel q

    gmulcolor 255,255,255
    if mode=1180:gmulcolor 127,127,127
            
    for eqipn,0,3
        px=8+pxp
        py=(eqippyset+pyp)-eqippmax*36+eqipn*36+pyp+6
        
        if mode=1080 or mode=1090 or mode=1180 or mode=1185 or mode=1190 or mode=4070 or mode=4080 {
            strpq 682+eqipn*2+lung,px+24,py,mbyte,q
            px=px+88
        }
        
        if mode=1090 or mode=1190 or mode=4070 {
            selbox ((eqipy=eqipn) and (cslpcnt=1)),pxp+2,py-6+2,eqipputxwidth+pxp,py-6+36,mx,my
        }

        eqipputnm=itemnm(dt(chrno,133+eqipn),0+lung)
        if dt(chrno,133+eqipn)=512:eqipputnm=nostr
        strp eqipputnm,px,py,mbyte
        
        if (mode=1090 or mode=1190 or mode=4070) and rmx>pxp+2 and rmy>py-6+2 and rmx<eqipputxwidth+pxp and rmy<py-6+36 {
            if eqipy=eqipn:cmx=0:eqipy=eqipn:gosub *badan
            if eqipy!eqipn:eqipy=eqipn
        }
        
        
    next
            
    gmulcolor 255,255,255    

return
    
*puteqipinfo
    
    if infoputcnt>0:boli 4,0,224-infoputcnt*22-4,478,224
    infoputyn=0
    
        if (eqipinfo(0,0)!-16777214) and infoputcnt>0 {
        ;各ステータス
        for nnn,0,8
            if eqipinfo(nnn,2)!0 {
                py=224-infoputcnt*22+infoputyn*22
                strpq setstatsputqno(nnn)+lung,8,py,mbyte,q
                nnnnnn=eqipinfo(nnn,1)
                if nnn=7:nnnnnn=100-nnnnnn
                varp nnnnnn,144,py,4,1
                nnnnnnnn=eqipinfo(nnn,0)
                if nnn=7:nnnnnnnn=100-nnnnnnnn
                if nnnnnnnn<nnnnnn:gmulcolor 127,127,127
                varp nnnnnnnn,224,py,4,1
                gmulcolor 255,255,255
                strpq 246,208,py,mbyte,q
                infoputyn++
            }
        next
        
        ;攻撃属性
        notesel q
        infoputx=8
        infoheadputon=0
        
        for nnn,8,24
            if eqipinfo(nnn,2)!0 {
                py=224-infoputcnt*22+infoputyn*22
                if infoheadputon=0 {
                    noteget infoputstr,564
                    strp infoputstr,infoputx,py,mbyte
                    infoheadputon=1
                    infoputx=infoputx+16*9
                }
                noteget infoputstr,532+((nnn-8)\16)*2+lung
                if eqipinfo(nnn,0)<eqipinfo(nnn,1):gmulcolor 127,127,127
                strp infoputstr,infoputx,py,mbyte
                gmulcolor 255,255,255
                infoputx=infoputx+16*5
                if infoputx>400:infoputx=8+16*9:infoputyn++
            }
        next
        if infoputx>8+16*9:infoputyn++
        
        ;防御属性
        infoputx=8
        infoheadputon=0
        
        for nnn,24,40
            if eqipinfo(nnn,2)!0 {
                py=224-infoputcnt*22+infoputyn*22
                if infoheadputon=0 {
                    noteget infoputstr,566
                    strp infoputstr,infoputx,py,mbyte
                    infoheadputon=1
                    infoputx=infoputx+16*9
                }
                noteget infoputstr,532+((nnn-24)\16)*2+lung
                if eqipinfo(nnn,0)<eqipinfo(nnn,1):gmulcolor 127,127,127
                plusputstr=nostr
                if eqipinfo(nnn,0)>-1:plusputstr=plusstr
                infoputstr=infoputstr+plusputstr+vzstr(eqipinfo(nnn,0),mbyte)
                strp infoputstr,infoputx,py,mbyte
                gmulcolor 255,255,255
                infoputx=infoputx+16*7
                if infoputx>400:infoputx=8+16*9:infoputyn++
            }
        next
    } else {
        ;装備できません
        if infoputcnt>0:strpq 690+lung,8,224-22,mbyte,q
    }
    
return
            
*putiteminfo
    
            
    itemsyurui=itemd(infoitemno,16)
    if simode=0:itemsyurui=10
    sdim infostr,30,5
    dim bouinfo,16
    nousestr=nostr
    infostrnn=0
    infostrmax=0
    kouzokuseion=0
    bouzokuseion=0
            
    ;各装備品に関わるステータス値の変数配列格納場所
    setstatsno=76,77,103,104,106,112,113,114
    setstatsputqno=452,454,434,436,440,456,458,460

    notesel q


            
    ;装備品
    if (itemsyurui>0) and (itemsyurui!10) {
        ;値
        for nnn,0,3
            infoset1=itemd(infoitemno,19+nnn*2)
            infoset2=itemd(infoitemno,20+nnn*2)
            if infoset2>0 {
                if infoset1=7:infoset2=-infoset2
                noteget infostrset,setstatsputqno(infoset1)+lung
                infostr(infostrnn)=infostr(infostrnn)+infostrset
                if infoset2>-1:infostr(infostrnn)=infostr(infostrnn)+plusstr
                infostr(infostrnn)=infostr(infostrnn)+vzstr(infoset2,mbyte)+spacestr
            }
        next
        ;攻撃属性
        kouzokuseion=0
        for kouzokunn,0,16
            if itemd(infoitemno,25+kouzokunn)=1 {
                if kouzokuseion=0:infostrnn++:kouzokuseion=infostrnn
                noteget infostrset,532+kouzokunn*2+lung
                infostr(infostrnn)=infostr(infostrnn)+infostrset+spacestr
            }
        next
        ;防御属性をセット        
        for bouzokunn,0,8
            bouzokusetn=itemd(infoitemno,42+bouzokunn)
            ;○
            if bouzokusetn>0 and bouzokusetn<17:bouinfo(bouzokusetn-1)++
            ;×
            if bouzokusetn>17 and bouzokusetn<34:bouinfo(bouzokusetn-18)--
            ;○すべて
            if bouzokusetn=17 {
                for nnnnnn,0,16
                    bouinfo(nnnnnn)++
                next
            }
            ;×すべて
            if bouzokusetn=34 {
                for nnnnnn,0,16
                    bouinfo(nnnnnn)--
                next
            }
        next
        bouzokuseion=0
        for bouzokunn,0,16
            if bouinfo(bouzokunn)!0 and bouinfoonoff(bouzokunn)=1 {
                if bouzokuseion=0:infostrnn++:bouzokuseion=1+kouzokuseion
                noteget infostrset,532+bouzokunn*2+lung
                plusputstr=nostr
                if bouinfo(bouzokunn)>-1:plusputstr=plusstr
                infostr(infostrnn)=infostr(infostrnn)+infostrset+plusputstr+vzstr(bouinfo(bouzokunn),mbyte)+spacestr
            }
        next
        
    }


    ;使用した場合 または　スキル
    if infoitemno<512 {
        dim siduse,92        
        siduse(0)=sid(infoitemno,0,simode)    ;消費MP
        siduse(1)=sid(infoitemno,1,simode)    ;パラメータ1
        siduse(2)=sid(infoitemno,2,simode)    ;たねの場合の上がるステータスの種類
        siduse(3)=sid(infoitemno,3,simode)    ;効果1
        siduse(4)=sid(infoitemno,4,simode)    ;パラメータ2
        siduse(6)=sid(infoitemno,6,simode)    ;効果2
        siduse(8)=sid(infoitemno,8,simode)    ;効果の範囲
        itemkouka=siduse(3)
        itemkouka2=siduse(6)
        if (itemsyurui=0) or (itemsyurui>0 and itemkouka>0) {
            infostrset2=nostr
            infostrset3=nostr
            infostrset4=nostr
            infostrset5=nostr
            infostrset6=nostr
            infostrset7=nostr
            qstrget=nostr
            if infostrnn>0:infostrnn++
            if itemsyurui>0 and infostrnn=0:infostrnn++
            noteget infostrset,926+(itemkouka*2)+lung

            ;ダメージスキル　+アルファ効果がある場合
            if itemkouka2>0 and (itemkouka=10 or itemkouka=11 or itemkouka=14 or itemkouka=15 or itemkouka=16) {
                ;状態異常
                if itemkouka2=12 {
                    noteget infostrset4,470+siduse(4)*2+lung
                    infostrset=infostrset4+infostrset
                }
                ;間合いを外す・即死・有利な補助効果無効・盗む
                if itemkouka2=19 or itemkouka2=32 or itemkouka2=36 or itemkouka2=39 {
                    noteget infostrset4,926+(itemkouka2*2)+lung
                    infostrset=infostrset+plusstr+infostrset4
                }
            }
            ;状態異常
            if itemkouka=3 or itemkouka=12 {
                noteget infostrset2,470+siduse(1)*2+lung
            }
            ;ステータスUP・DOWN
            if itemkouka=24 or itemkouka=28 {
                noteget infostrset,1050+(itemkouka=28)*32+siduse(1)*2+lung
            }
            ;攻撃+ステータスDOWN
            if itemkouka=29 {
                noteget infostrset4,1050+(itemkouka=29)*32+siduse(1)*2+lung
                infostrset=infostrset+plusstr+infostrset4
            }
            ;たね
            if itemkouka=57 {
                noteget infostrset5,432+siduse(2)*2+lung
                noteget infostrset6,56
                infostrset2=infostrset5+infostrset6+spacestr+vzstr(siduse(1),mbyte)
            }
            ;ダメージスキル　３か４連続 *効果１を連続攻撃にしないと表示されない
            if (itemkouka=14 or itemkouka=15) {
                ;３連続
                if itemkouka2=10 or itemkouka2=11 or itemkouka2=13 {
                    infostrset="３"+infostrset
                }
                ;４連続
                if itemkouka2=14 or itemkouka2=15 {
                    infostrset="４"+infostrset                    
                }
            }
            ;ダメージスキル　攻撃属性
            if itemkouka=10 or itemkouka=11 or itemkouka=13 or itemkouka=14 or itemkouka=15 or itemkouka=29 {
                ;kouzokuseion=0
                for kouzokunn,0,8
                    if sid(infoitemno,25+kouzokunn,simode)=1 {
                        noteget qstrget,532+kouzokunn*2+lung
                        infostrset=qstrget+infostrset
                    }
                next
            }
            ;１たい　ぜんたい　ほんにん
            if itemkouka<40 and itemkouka>0 {
                noteget qstrget,1114+siduse(8)*2+lung
                infostrset3=infostrset3+qstrget
            }
            ;常に有効なスキル            
            if itemkouka=44 {
                noteget qstrget,1386+siduse(1)*2+lung
                infostrset3=infostrset3+qstrget
            }
            ;転職可能
            if itemkouka=60 {
                if (mode!2080) and (mode!2120):gosub *putjobtext
                noteget infostrset4,360+siduse(1)*2+lung
                noteget infostrset5,22
                infostrset=infostrset4+infostrset5+spacestr+infostrset
                
                
            }
            infostr(infostrnn)=infostrset2+infostrset+infostrset3
            if mode=2300 and infoitemno=0:infostr(0)=nostr
        }
        ;使うことができない
        if (simode=0 and dt(7,201+spy+spselpage*sppmax)!0) or (simode=1 and dt(10,713+itemy+itemsellpage*itempmax)!0) {            
            ;お店では表示しない
            if (mode!2080) and (mode!2120) and (mode!2121) {
                ;infostrnn++
                ;infostr(infostrnn)=infostr(infostrnn-1)
                if simode=0:noteget nousestr,1120+dt(7,201+spy+spselpage*sppmax)*2+lung
                if simode=1:noteget nousestr,1120+dt(10,713+itemy+itemsellpage*itempmax)*2+lung
                ;nousestr=infostrset
                ;infostr(infostrnn-1)=infostrset
            }
        }
    }

    for nn,0,5
        if infostr(nn)!nostr:infostrmax=nn
    next

    if mode=1020 or mode=1021 or mode=1028 or mode=1029 or mode=1120 or mode=4160 or mode=4161:py=273
    if mode=1030 or mode=1031 or mode=1038 or mode=1039 or mode=1130 or mode=4110 or mode=4111:py=273
    if mode=2080 or mode=2300:py=(548+pyp)-shopitemmax*gyoukan+pyp-2-24-4
    if mode=2120 or mode=2121 or mode=2310:py=(548+pyp)-10*gyoukan+pyp-2-24-4
    
    if mode=1030 or mode=1038 or mode=1039 or mode=1130 or mode=4110:infostrmax--
    boli 4,0,py-(infostrmax+1)*22-4,478,py
    if mode=1030 or mode=1038 or mode=1039 or mode=1130 or mode=4110:infostrmax++
    
    infoputwait=5
    for nn,0,infostrmax+1
        pxplus=0
        infostrset=nostr
        if itemsyurui>0 and (itemsyurui!10) {
            ;武器　防具　装具
            if nn=0                                   :pxplus=4:noteget infostrset,682+(itemsyurui-1)*2+lung:infostrlen=strlen(infostr(nn))/mbyte
            ;攻撃属性
            if (nn!0) and kouzokuseion=nn            :pxplus=9:noteget infostrset,564+lung:infostrlen=strlen(infostr(nn))/mbyte
            ;防御属性
            if (nn!0) and bouzokuseion=nn            :pxplus=9:noteget infostrset,566+lung:infostrlen=strlen(infostr(nn))/mbyte
            if nn=3                                          :infostrlen=strlen(infostr(nn))/mbyte
        }
            
        ;各行の文字の長さを取得        
        infostrlen=strlen(infostr(nn))/mbyte
        ;文字を区切って表示するかもしれないので専用の変数にコピーする
        infostrcut=infostr(nn)
        ;何文字まで表示できるか　それ以上はスクロール表示する
        strover=29
        if nn=0 and itemsyurui>0:strover=25
        if kouzokuseion=nn and kouzokuseion>0:strover=20
        if bouzokuseion=nn and bouzokuseion>0:strover=20
        ;スクロールさせる必要がある長さの文字は所定の位置から所定の長さだけカットする
        if infostrlen>strover {
            cuthead=0
            if infoputcutcnt(nn)>75:cuthead=(infoputcutcnt(nn)-75)
            infostrcut=strmid(infostr(nn),cuthead/infoputwait*mbyte,strover*mbyte)
        }
            
        ;各情報の表示
        strp infostrcut,8+pxplus*16,py-(infostrmax+1)*22+nn*22,mbyte
        
        ;武器　防具　装具　攻撃属性　防御属性の文字表示
        if infostrset!nostr:strp infostrset,8,py-(infostrmax+1)*22+nn*22,mbyte
            
        infoputcutcnt(nn)++
            
        ;もし表示カットが必要な行で表示位置が右まで充分進んだ場合は表示位置を左端に戻す
        if infoputcutcnt(nn)>(infostrlen-strover)*infoputwait+(10+(nn=0)*5)*infoputwait+75:infoputcutcnt(nn)=0

        ;消費MP
        if (itemsyurui=10) and (siduse(0)>0) and (nn=infostrmax) {
            downmp=siduse(0)
            if dtspecial(chrno,8)>0:downmp=downmp/2
            strpq 446,412,py-(infostrmax+1)*22+nn*22,mbyte,q
            varp downmp,440,py-(infostrmax+1)*22+nn*22,2,1        
        }
    next
        
    nostrpy=py-(infostrmax+1)*22-10-partymax*22+4+partymax*22
    ;各キャラのインフォメーション
    if mode=2080 and itemsyurui>0 {
        pytop=py-(infostrmax+1)*22-10-partymax*22
        boli 4,0,pytop,478,pytop+4+partymax*22
        nostrpy=py-(infostrmax+1)*22-10-partymax*22
        for chrno,8,partymax+8
            npy=chrno-8

            namechrno=chrno
            gosub *plnameget
            pxx=8
            pyy=pytop+2+npy*22
            strp chrname,pxx,pyy,mbyte

            eqipy=itemsyurui-1
            eqipitemno=infoitemno
            gosub *itemeqipinfoset
            if eqipinfo(0,0)!-16777214 {
                ;ステータスの種類
                noteget infostrset,setstatsputqno(itemd(infoitemno,19))
                ;元の値
                nnn=eqipinfo(itemd(infoitemno,19),1)
                ;めいちゅうりつの場合は100-値
                if itemd(infoitemno,19)=7:nnn=100-nnn
                infostrset=infostrset+spacestr+vzstr(nnn,mbyte)
                ;装備した場合の値
                nnn=eqipinfo(itemd(infoitemno,19),0)
                ;めいちゅうりつの場合は100-値
                if itemd(infoitemno,19)=7:nnn=100-nnn
                infostrset=infostrset+spacestr+rightstr+spacestr+vzstr(nnn,mbyte)

                strp infostrset,pxx+7*16,pyy,mbyte
            } else {
                ;そうびできません
                strpq 690+lung,pxx+7*16,pyy,mbyte,q
            }
        
        next
    }
    ;使うことができないインフォメーション
    if nousestr!nostr {
        if mode=1030 or mode=1130 or mode=4110:nostrpy=nostrpy+22
        boli 4,0,nostrpy-4-24,478,nostrpy-4
        if (tenpcnt=1):strp nousestr,8,nostrpy+3-4-24,mbyte
    }

            
return

*putshopin

    notesel q
    noteget msg(0),620+lung
    noteget msg(1),622+lung
    msg(2)=nostr
    
    gosub *putmes
    
    for n,0,3
        selbox ((shopinselx=n) and (cslpcnt=1)),0+pxp,440+n*36+pyp,479+pxp,440+35+n*36+pyp,mx,my
        if rmx>0+pxp and rmy>(440+n*36+pyp) and rmx<480+pxp and rmy<(440+35+n*36+pyp) {
            if shopinselx=n or dt(8,1290)=1:tmx=0:shopinselx=n:gosub *badan
            if shopinselx!n:shopinselx=n
        }
        gmulcolor 255,255,255
        if itemhavemax=0 and n=1:gmulcolor 127,127,127
        strpq 612+n*2+lung,32+pxp,(440+n*36+pyp)+6,mbyte,q

    next

return
            
*putmyshop 
                
    ;gosub *shopbuynset
    ;一行の幅
    gyoukan=34
    shopitemmax=10
            
    shopputy=480-8-(gyoukan-4)*(shopitemmax)
            
    
    pxp=2;48
    
    notesel q
    strpq 648,pxp+364,(548+pyp)-shopitemmax*gyoukan+pyp-22,mbyte,q
    strpq 646,pxp+420,(548+pyp)-shopitemmax*gyoukan+pyp-22,mbyte,q
                
    strpq 1562,pxp+240-(8*21),32,mbyte,q
    
    for n,0,shopitemmax,1
            
        px=0+pxp
        py=(548+pyp)-shopitemmax*gyoukan+n*gyoukan+pyp
        selbox ((shopsely=n) and (cslpcnt=1)),px,py,415+pxp,((548+pyp)-(shopitemmax-1)*gyoukan)-1+n*gyoukan+pyp,mx,my
        nn=dt(15,713+n)
        
        ;金額
        ;通常価格
        buygold=itemd(nn,0)
        if nn>0:varp buygold,px+332,py-(lung*2)+5,5,1
            
        putitemnm=itemnm(nn,0+lung)
        
        ;何もない場合
        if nn=0 {
            noteget putitemnm,1560+lung
        }
            
        gmulcolor 255,255,255
        strp putitemnm,px+24,py+5,mbyte
        if dt(15,713+n)>0:varp myshopitemhave(n),px+432,py-(lung*2)+5,2,1
        
        if rmx>px and rmy>py and rmx<367+pxp and rmy<(((548+pyp)-(shopitemmax-1)*gyoukan)-1+n*gyoukan+pyp) {
            if shopsely=n:rmx=0:shopsely=n:gosub *badan
            if shopsely!n:shopsely=n
        }
    next
    
    boli 0,pxp-2,(548+pyp)-shopitemmax*gyoukan+pyp-2-24,478-2,(548+pyp)+pyp

    ;アイテムの情報を表示
    ;itemselno=dt(15,713+shopsely)
    ;eqipitemselno=dt(15,713+shopsely)
    ;infoitemno=dt(15,713+shopsely)
    ;itemselno=shopitem(shopsely)
    ;eqipitemselno=shopitem(shopsely)
    ;infoitemno=shopitem(shopsely)
    ;gosub *putiteminfo

return


*putshop 
                
    ;一行の幅
    gyoukan=34
            
    gosub *shopbuynset
    shopputy=480-8-(gyoukan-4)*(shopitemmax)
            
    
    pxp=2;48
    
    strpq 624,pxp+364,(548+pyp)-shopitemmax*gyoukan+pyp-22,mbyte,q
    strpq 646,pxp+420,(548+pyp)-shopitemmax*gyoukan+pyp-22,mbyte,q
    
    for n,0,shopitemmax,1
        px=0+pxp
        py=(548+pyp)-shopitemmax*gyoukan+n*gyoukan+pyp
        selbox ((shopsely=n) and (cslpcnt=1)),px,py,415+pxp,((548+pyp)-(shopitemmax-1)*gyoukan)-1+n*gyoukan+pyp,mx,my
        nn=shopitem(n)
        
        ;金額
        ;通常価格
        buygold=itemd(nn,0)
        ;取引有利価格
        buygold=buygold-(buygold*dtspecial(8,4))/10
        if dtspecial(8,4)>0 and buygold=itemd(nn,0) and buygold>1:buygold--
        ;特価価格
        if specialplice(n)<100 {
            buymotogold=buygold
            buygold=buygold*specialplice(n)/100
            if dtspecial(8,19)>0 and buygold=itemd(nn,0) and buygold>1:buygold--
        }

            
        gmulcolor 255,255,255
        if itemd(shopitem(n),0)>dt(8,8) or shopbuyn(n,1)>98 :gmulcolor 127,127,127

        ;if shopbuyn(n,2)=0:gmulcolor 127,127,127
        strp itemnm(nn,0+lung),px+24,py+5,mbyte
        ;通常価格
        if specialplice(n)=100 {
            varp buygold,px+332,py-(lung*2)+5,5,1
        }
        ;特価価格
        if specialplice(n)<100 {
            varp buymotogold,px+332,py-(lung*2)+5,5,1
            
            bolilong=0
            if buymotogold<10000:bolilong=16
            if buymotogold<1000:bolilong=32
            if buymotogold<100:bolilong=48
            if buymotogold<10:bolilong=64
            boli 0,px+332+bolilong,py-(lung*2)+5+12,px+332+80,py-(lung*2)+5+12
            
            varp buygold,px+332-92+bolilong,py-(lung*2)+5,5,1

        }
        ;gmulcolor 255,255,255

        ;if shopbuyn(n,0)=0:gmulcolor 127,127,127
        ;varp shopbuyn(n,0),px+328,py-(lung*2)+5,2,1
        ;gmulcolor 255,255,255
        ;if shopbuyn(n,1)=0:gmulcolor 127,127,127
        varp shopbuyn(n,1),px+432,py-(lung*2)+5,2,1
        gmulcolor 255,255,255
        
        ;if rmx>0+pxp and rmy>((548+pyp)-shopitemmax*36+n*gyoukan+pyp) and rmx<367+pxp and rmy<(((548+pyp)-(shopitemmax-1)*gyoukan)-1+n*gyoukan+pyp) {
        if rmx>px and rmy>py and rmx<367+pxp and rmy<(((548+pyp)-(shopitemmax-1)*gyoukan)-1+n*gyoukan+pyp) {
            if shopsely=n:rmx=0:shopsely=n:gosub *badan:n=shopitemmax+1
            if shopsely!n and n<shopitemmax:shopsely=n
        }
    next
    
    boli 0,pxp-2,(548+pyp)-shopitemmax*gyoukan+pyp-2-24,478-2,(548+pyp)+pyp

    ;アイテムの情報を表示
    itemselno=shopitem(shopsely)
    eqipitemselno=shopitem(shopsely)
    infoitemno=shopitem(shopsely)
    gosub *putiteminfo

/*
    ;売品説明のウィンドウの大きさ
    ;装備品の場合は右側を空ける（装備可不可のウィンドウを表示するため）
    idpx=320+pxp+(itemd(shopitem(shopsely),16)=0)*158+(itemd(shopitem(shopsely),16)=7)*158
    idpy=shopputy;+pyp
    
    if itemd(shopitem(shopsely),3)=54 {
        itemselno=shopitem(shopsely)
        jobpage=itemd(itemselno,1)/8
        jobselx=itemd(itemselno,1)\2
        jobsely=(itemd(itemselno,1)/2)-(itemd(itemselno,1)>7)*8
    }
*/
return

*putshopsell
            
    itempmax=8

    ;一行の幅
    gyoukan=34

    gosub *shopsellnset
    itemputy=480-8-(gyoukan-4)*(itempmax)
    
    shopputy=480-8-(gyoukan-4)*(shopitemmax)
    motopxp=pxp
    pxp=2;48
    itempyset=484;548;476
    
    ;うりね
    strpq 648,pxp+292,itemputy-42,mbyte,q
    ;しょじ
    strpq 646,pxp+372,itemputy-42,mbyte,q

    for n,0,itempmax,1

        if dt(9,713+n+itemsellpage*itempmax)>0 {

            px=0+pxp
            py=(itempyset+pyp)-itempmax*gyoukan+n*gyoukan+pyp
            selbox ((itemselly=n) and (cslpcnt=1)),px,py,367+pxp,((itempyset+pyp)-(itempmax-1)*gyoukan)-1+n*gyoukan+pyp,mx,my
            nn=dt(8,713+n+itemsellpage*itempmax)

            ;金額
            sellgold=(itemd(nn,0)*4)/10
            sellgold=sellgold+(itemd(nn,0)*5*dtspecial(8,4))/100
            if mode=2310:sellgold=itemd(nn,0)

            gmulcolor 255,255,255
            if itemd(nn,18)=1:gmulcolor 127,127,127
            strp itemnm(nn,0+lung),px+24,py+6,mbyte
            varp sellgold,px+272,py-(lung*2)+6,5,1
            ;varp shopselln(713+n+itemsellpage*itempmax),px+328,py+6,2,1
            gmulcolor 255,255,255
            varp dt(9,713+n+itemsellpage*itempmax),px+384,py+6,2,1
        
        
            ;if rmx>0+pxp+16 and rmy>((itempyset+pyp)-itempmax*gyoukan+n*gyoukan+pyp) and rmx<367+pxp and rmy<(((itempyset+pyp)-(itempmax-1)*gyoukan)-1+n*gyoukan+pyp) {
            if rmx>px and rmy>py and rmx<367+pxp and rmy<(((itempyset+pyp)-(itempmax-1)*gyoukan)-1+n*gyoukan+pyp) {
                if mode=2121:nextmode=2120
                if itemselly=n:rmx=0:itemselly=n:gosub *badan
                if itemselly!n:itemselly=n
            }
        }
    next

    ;ページ数の表示
    pxppp=480-272-51+47-2
    pagemaxstr=vzstr(itempagemax+1,mbyte)
    varp itemsellpage+1,pxppp+270/2-8-32+2,itempyset+pyp+18,2,1
    strp pagemaxstr,pxppp+270/2-16+24-2,itempyset+pyp+18,mbyte
    strpq 231,pxppp+270/2-8,itempyset+pyp+18,mbyte,q

    ;ページ変更ボタン
    if itempagemax>0 {
        ;pxp=480-272-51+47
        
        for n,0,2
            if n=0:menubtnx=pxppp-2
            if n=1:menubtnx=480-70-2
            menubtny=itempyset+pyp+2
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+70 and my<menubtny+60 :btnco=1
            if n=0 and btn(3)=1:btnco=1
            if n=1 and btn(1)=1:btnco=1
            if cmx>menubtnx and cmy>menubtny and cmx<menubtnx+70 and cmy<menubtny+60 {
                if n=0:gosub *bldan
                if n=1:gosub *brdan
            }
 
            boli btnco,menubtnx,menubtny,menubtnx+70-3,menubtny+60-3
            strpq 1164-n*2+lung,menubtnx+(70-16*3)/2,menubtny+(60-24)/2,mbyte,q            

        next
    }

