    ;全員の早さの平均値
    heikinnchi=btlspdmoto/(partymax+monmax)
                
    ;btlspdbouns=一番早さが高い人の早さ/2+50

    ;(全員の早さの平均値+(一番早さが高い人の早さ/2+50))*5000/(600-(0-19)*20)
    ;
    btlspd=((heikinnchi+btlspdbouns)*5000)/(600-btlspdplset*20);200
    
    ;if partymax>0:plspd=plspd/partymax
    ;if monmax>0:monspd=monspd/monmax
        
    plspd=partymax
    for nn,8,8+partymax
        plspd=plspd+dt(nn,103)
    next
    plspd=plspd/partymax

    monspd=monmax
    for nn,0,monmax
        monspd=monspd+dt(nn,103)
    next
    monspd=monspd/monmax

return
            
*btlautoset
            
    chrno_1=btlchrno
    simode=0
            
        
    dim koukaokng,7
    koukaokng(3)=-1
    koukaokng(6)=-1

    ;敵がどのような行動を行うか
    if chrno_1<8 {
        
        nnn=rnd(8)
        spitemnoset=mond(btlmon(chrno_1),44+nnn)
        if spitemnoset<4:koukaokng(3)=0:koukaokng(6)=0
        
        selcnt=0
        
        while (koukaokng(3)!0) and (koukaokng(6)!0) and (selcnt<100)
        
            spitemnoset=mond(btlmon(chrno_1),44+nnn)
            
            if spitemnoset>3 and dt(chrno_1,138)=0 {
                spitemno=spitemnoset-4
                simode=0
                gosub *siduseset
                gosub *spitemchrselokngget
                usespno=spitemno
            }
                
            selcnt++
            if selcnt>98 {
                spitemnoset=0
            }
            
            nnn=rnd(8)
                
        wend
        
        ;条件行動の情報 209=開始時 210=攻撃反撃 211=スキル反撃 212=HP1/2時 213=HP1/2 100% 214=HP1/2 50 215=HP1/2 25%
        ;doflag            0=特になし 1=打撃攻撃をうけた 2=スキルダメージをうけた 3=HPが半分状態

        ;バトル開始時の行動
        if (dt(chrno_1,209)!512) and chrno_1<8 {
            spitemnoset=dt(chrno_1,209)
            dt(chrno_1,209)=512
        }

        ;敵の行動者がHPが半分以下になっている場合 (反撃状態ではない)
        if chrmo_1<8 {
            if doflag(chrno_1)=0 and (dt(chrno_1,110)<(dt(chrno_1,108)/2)) and dt(chrno_1,110)>0 and dt(chrno_1,108)>0 {
                nnn=rnd(100)
                ;HP1/2 100%
                if dt(chrno_1,213)!512:spitemnoset=dt(chrno_1,213)
                ;HP1/2 50%
                if dt(chrno_1,214)!512 and nnn<50:spitemnoset=dt(chrno_1,214)
                ;HP1/2 25%
                if dt(chrno_1,215)!512 and nnn<25:spitemnoset=dt(chrno_1,215)
                ;HP1/2 を初めて切った
                if dt(chrno_1,212)!512 :spitemnoset=dt(chrno_1,212):dt(chrno_1,212)=512
            }
        }

        ;反撃時の行動
        if doflag(chrno_1)>0 and doflag(chrno_1)<3 {
            spitemnoset=dt(chrno_1,209+doflag(chrno_1))
        }
        
    }
            
    ;混乱したプレイヤーがどのような行動を行うか
    if chrno_1>7 and dt(chrno_1,142)>0 {
        nnn=rnd(8)
        ;基本は攻撃
        spitemnoset=0
        ;1/8の確率で防御
        if nnn=0:spitemnoset=2
        ;5/8の確率でスキル使用を試みる
        if (nnn>2) and (dt(chrno_1,201)!512) {
            dim koukaokng,7
            koukaokng(3)=-1
            koukaokng(6)=-1
            simode=0
            chrno=chrno_1
            gosub *sppagemaxget
            spnnn=rnd(spusemax)
            selcnt=0
        
            while (koukaokng(3)!0) and (koukaokng(6)!0) and (selcnt<1000)
        
                spitemno=dt(chrno_1,201+spnnn)
            
                if dt(chrno_1,138)=0 {
                    simode=0
                    gosub *siduseset
                    gosub *spitemchrselokngget
                    usespno=spitemno
                    spitemnoset=spitemno+4
                }
                
                selcnt++
                if selcnt>998 {
                    spitemnoset=0
                }
            
                spnnn=rnd(spusemax)
                
            wend

        }
    }
        
    ;逃げる
    if spitemnoset=1 and chrno_1<8 {
        if plavelv>mond(btlmon(chrno_1),39) {
            monrannaway(chrno_1)=1
            dt(chrno_1,110)=0
            gosub *btlmsgreset
            notesel q
            noteget msgset1,902+lung
            btlgauge(chrno_1)=0+rnd((dtspecial(chrno_1,18)>0)*20000+1)
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1
            btlmsgmaxcnt++
        } else {
            spitemnoset=0
        }
    }

    ;防御
    if spitemnoset=2 {
        damage=0
        dt(chrno_1,146)=1+(dtspecial(chrno_1,16)>0)*4
        gosub *btlmsgreset
        notesel q
        noteget msgset1,904+lung
        btlgauge(chrno_1)=0+rnd((dtspecial(chrno_1,18)>0)*20000+1)
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1
        btlmsgmaxcnt++
    }

    ;攻撃
    if spitemnoset=0 {
        usespno=1000
        siduse(3)=10
        siduse(6)=0
        siduse(8)=0
        hanni=0
    }
        
    ;スキル使用
    if spitemnoset>3 {
        spitemno=spitemnoset-4
        usespno=spitemno
        simode=0
        gosub *siduseset
        spkouka(0)=siduse(3)
        spkouka(1)=siduse(6)
    }
                    
    ;対象の設定
    k1=siduse(3)
    k2=siduse(6)
    hanni=siduse(8)
    selmode=0    ;0=モンスター単体 1=プレイヤー単体 2=モンスター全体 3=プレイヤー全体 4=本人
        
    ;味方に使うスキル
    if hanni<2 and (k1=1 or k1=2 or k1=3 or k1=20 or k1=24 or k1=33 or k1=34 or k2=1 or k2=2 or k2=3 or k2=20 or k2=24 or k2=33 or k2=34) {
        ;全体
        if hanni=1 {
            if chrno_1<8 {
                if dt(chrno_1,142)=0:selmode=2    ;モンスター通常
                if dt(chrno_1,142)>0:selmode=3    ;モンスター混乱
            }
            if chrno_1>7 and dt(chrno_1,142)>0:selmode=2    ;プレイヤー混乱
        }
        ;単体
        if hanni=0 {
            if chrno_1<8 {
                if dt(chrno_1,142)=0:selmode=0    ;モンスター通常
                if dt(chrno_1,142)>0:selmode=1    ;モンスター混乱
            }
            if chrno_1>7 and dt(chrno_1,142)>0:selmode=0    ;プレイヤー混乱
        }
    }
        
    ;敵に使うスキル
    if hanni<2 and (k1=10 or k1=11 or k1=12 or k1=13 or k1=14 or k1=15 or k1=19 or k1=21 or k1=22 or k1=23 or k1=28 or k1=29 or k1=32 or k1=36 or k1=39 or k1=56 or k1=57 or k1=58 or k2=10 or k2=11 or k2=12 or k2=13 or k2=14 or k2=15 or k2=19 or k2=21 or k2=22 or k2=23 or k2=28 or k2=29 or k2=32 or k2=36 or k2=39 or k2=56 or k2=57 or k2=58) {
        ;全体                
        if hanni=1 {
            if chrno_1<8 {
                if dt(chrno_1,142)=0:selmode=3    ;モンスター通常
                if dt(chrno_1,142)>0:selmode=2    ;モンスター混乱
            }
            if chrno_1>7 and dt(chrno_1,142)>0:selmode=3    ;プレイヤー混乱
        }
        ;単体
        if hanni=0 {
            if chrno_1<8 {
                if dt(chrno_1,142)=0:selmode=1    ;モンスター通常
                if dt(chrno_1,142)>0:selmode=0    ;モンスター混乱
            }
            if chrno_1>7 and dt(chrno_1,142)>0:selmode=1    ;プレイヤー混乱
        }
    }
        
    ;自分に使うスキル
    if hanni=2 :selmode=4
    
    ;敵が逃げるときはselmode=10
    ;こうしないと最後の一匹が逃げた時にselmode=0で下のところで無限ループする
    if spitemnoset=1 and chrno_1<8:selmode=10

    
    ;選択モードによる選択先の設定
    ;モンスター単体
    if selmode=0 {
        spchrno_1=rnd(monmax)
        while dt(spchrno_1,110)<1
            spchrno_1=rnd(monmax)    
        wend
        spchrno_2=spchrno_1
    }
    ;プレイヤー単体
    if selmode=1 {
        spchrno_1=rnd(partymax)+8
        while dt(spchrno_1,110)<1
            spchrno_1=rnd(partymax)+8    
        wend
        spchrno_2=spchrno_1                
    }
    ;モンスター全体
    if selmode=2:spchrno_1=0:spchrno_2=monmax-1
    ;プレイヤー全体
    if selmode=3:spchrno_1=8:spchrno_2=8+partymax-1
    ;本人
    if selmode=4:spchrno_1=chrno_1:spchrno_2=chrno_1
    
    nextmode=4040
    ;逃げる・防御の場合は*btlkoukasetへ行かない
    if spitemnoset<1 or spitemnoset>2:gosub *btlkoukaset
                
return
            
*bdtonset
            
    if mode>3999 and mode<4400 {
        gosub *btlmsgreset
    }
    dim hpzero,12
            
            
    notesel q

    for nn,0,12
        ;処理前にHPが残っているか
        if (nn<monmax) or ((nn>7) and (nn<partymax+8)) {
            if dt(nn,110)>0:hpzero(nn)=1
        }
        for nnnn,110,165
            
            dt(nn,nnnn)=dt(nn,nnnn)+bdtkoukaonset(nn,nnnn)
                        
            if nnnn=110 and dt(nn,nnnn)<1:dt(nn,nnnn)=0 {
                ;処理後にHPがゼロになった場合
                if hpzero(nn)=1 {
                    if mode>3999 {
                        hpzero(nn)=0
                        nextmode=4050
                        if nn<8:noteget msgset1,726+lung
                        if nn>7:noteget msgset1,728+lung
                        btlmsg(btlmsgmaxcnt)=btlchrnmstr(nn)+msgset1
                        btlmsgmaxcnt++
                    }
                    if mode<4000:dt(nn,nnnn)=1
                }
            }
            ;各値がゼロ以下にならない or MAX値を超えない
            if nnnn=110 and dt(nn,nnnn)>dt(nn,108):dt(nn,nnnn)=dt(nn,108)
            if nnnn=111 and dt(nn,nnnn)<1:dt(nn,nnnn)=0
            if nnnn=111 and dt(nn,nnnn)>dt(nn,109):dt(nn,nnnn)=dt(nn,109)
        next
    next
            
    dim bdtkoukaonset,12,165
    damage=0
            
return
            
*hpautorevivecheck
    
    hpautoreviveon=0
            
    gosub *btlmsgreset
            
    for revivechrno,0,12
        if dt(revivechrno,110)=0 and dt(revivechrno,147)=1 {
            nextmode=4050
            hpautoreviveon=1
            ;HP回復
            dt(revivechrno,110)=dt(revivechrno,108)
            ;自動復活を解除
            dt(revivechrno,147)=0
            ;文字セット
            noteget msgset1,884+lung
            noteget msgset2,866+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(revivechrno)+msgset1
            btlmsgmaxcnt++
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(revivechrno)+msgset2
            btlmsgmaxcnt++
            btlmsgmaxcnt++
        }
    next
            
    ;回復する場合のエフェクト
    if hpautoreviveon=1 {
        ;setseno=0    ;効果音No.のセット
        ;sevolset=-1000
        siefectno1=4
        siefectno2=0
    
        gosub *siefect
    }

            
return
            
*btlendcheck
    
    btlend=0
            
    notesel q
            
    ;敵が全滅したかどうか
    btlendcheckcnt=0
    for nn,0,monmax
        if (dt(nn,110)<1) or (monrannaway(nn)=1):btlendcheckcnt++
    next
    if btlendcheckcnt=monmax:btlend=1
                        
    ;味方が全滅したかどうか
    btlendcheckcnt=0
    for nn,8,8+partymax
        if dt(nn,110)<1:btlendcheckcnt++
    next
    if btlendcheckcnt=partymax:btlend=2
            
    ;戦況に変化なし
    if btlend=0 and plescape=0:nextmode=4010
            
    ;敵が全滅した
    if btlend=1 {
        gaugefull=0
        btlchrno=20
        gosub *btlmsgreset
        noteget msgset1,730+lung
        btlmsg(btlmsgmaxcnt)=msgset1
        btlmsgmaxcnt++
        nextmode=4060
        getex=0
        getgold=0
        ;得るEXと金を合計する
        for nn,0,monmax
            if monrannaway(nn)=0 {
                
                setex=mond(btlmon(nn),8)
                if setex>65000:setex=(setex-65000)*1000
                getex=getex+setex
                
                setgold=mond(btlmon(nn),10)
                if setgold>1000:setgold=(setgold-1000)*1000
                getgold=getgold+setgold
            }
        next
        ;生きているメンバー人数
        arivecheck=0
        for nn,8,partymax+8
            if dt(nn,110)>0:arivecheck++
        next
        if arivecheck>0:getex=getex/arivecheck
        ;UPスキルを持っている場合
        getex=getex+(getex*dtspecial(8,6)*25)/100
        getgold=getgold+(getgold*dtspecial(8,5)*25)/100
        ;EX獲得メッセージのセット
        if getex>0 {
            noteget msgset1,448+lung
            btlmsg(btlmsgmaxcnt)=vzstr(getex,mbyte)+spacestr+msgset1
            btlmsgmaxcnt++
        }
        ;金獲得メッセージのセット
        if getgold>0 {
            noteget msgset1,642+lung
            btlmsg(btlmsgmaxcnt)=vzstr(getgold,mbyte)+spacestr+msgset1
        }
        ;～を　かくとく！
        if getex>0 or getgold>0 {
            noteget msgset1,914+lung
            btlmsg(btlmsgmaxcnt)=btlmsg(btlmsgmaxcnt)+spacestr+msgset1
        }
        btlmsgmaxcnt++
        ;金獲得 　EXは*keywaitで
        dt(8,8)=dt(8,8)+getgold
        if dt(8,8)>999999999:dt(8,8)=999999999
        ;EX獲得
        for nn,8,partymax+8
            if dt(nn,110)>0 {
                motolv(nn)=dt(nn,9)
                job=dt(nn,10)
                dt(nn,11+job)=dt(nn,11+job)+getex
                if dt(nn,11+job)>999999999:dt(nn,11+job)=999999999
            }
        next
    }

    ;味方が全滅した
    if btlend=2 {
        gosub *btlmsgreset
        noteget msgset1,732+lung
        btlmsg(btlmsgmaxcnt)=msgset1
        btlmsgmaxcnt++
        nextmode=4060
    }
    ;味方がうまく逃げ出した
    if plescape=1:btlend=3
            
    if btlend!0 {
        ;出現カウンターをリセット
        if dt(8,1292)<3000:dt(8,1292)=msetfrd(17)
        ;敵の変数をクリーンにする
        for nn,0,8
            for nnnn,76,713
                dt(nn,nnnn)=0
                if nnnn>200:dt(nn,nnnn)=512
            next
        next
        ;味方のバトル専用変数をクリーンにする
        for nn,8,8+partymax
            for nnnn,146,165
                dt(nn,nnnn)=0
            next
        next
        if btlend!2:gosub *takaratrapcountdown
    }

            
return
            
*btlmsgreset
            
    btlmsgmaxcnt=0
    btlmsgcnt=0
    sdim btlmsg,100,100

return
            
*missmsgget
        
    notesel q
    noteget missmsg,770+missmsgno*2+lung
    if missmsgno<3:missmsg=btlchrnmstr(spchrno)+missmsg
            
return

*btlkoukaset

    gosub *btlmsgreset
    dim bdtkoukaonset,12,165
    dim killon,12
            
    setseno=0    ;効果音No.のセット
    ;sevolset=-1000
    siefectno1=0    ;エフェクトNo.のセット
    siefectno2=0    ;揺れNo.のセット
    efectok=0        ;これを1にするとエフェクトが有効になる
    damage=0
    damagecnt=0
    sinextmode=0
            
    notesel q
            
    ;敵が反撃する時のメッセージをセット
    if chrno_1>-1 and chrno_1<20 {
        if doflag(chrno_1)>0 and doflag(chrno_1)<3 and chrno_1<8 {
            noteget msgset1,912+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1
            btlmsgmaxcnt++    
            doflag(chrno_1)=0
        }
    }
            
    ;特技 or アイテム
    if usespno<1000 {    
        spkouka(0)=siduse(3)
        spkouka(1)=siduse(6)
        usespitemnm=spnm(usespno,0+lung)
        noteget msgset1,712+(siduse(15)=4)*24+lung
        noteget msgset2,738+siduse(15)*2+lung
        
        ;アイテム
        if simode=1 and (mode<1400 or mode>1600) {
            noteget msgset2,760+lung:usespitemnm=itemnm(usespno,0+lung)
        }
        
        ;移動中にアイテムを使った場合は使い手の名前を表示しない
        if nextmode!1300 and (mode<1400 or mode>1600) {
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+usespitemnm+msgset2
            btlmsgmaxcnt++
        }
        ;移動中にアイテムを使った場合は使い手の名前を表示しない
        if nextmode=1300 and (mode<1400 or mode>1600) {
            btlmsg(btlmsgmaxcnt)=usespitemnm+msgset2
            btlmsgmaxcnt++
        }
        ;ワナ発動
        if (mode>1399 and mode<1600) or (mode>4399 and mode<4600) {
            if (mode>4399 and mode<4600):btlmsgmaxcnt=0
            noteget msgset2,1538+lung
            usespitemnm=itemnm(trapno,0+lung)
            btlmsg(btlmsgmaxcnt)=usespitemnm+msgset2
            btlmsgmaxcnt++
            motosimode=simode
            simode=2
        }
    }
            
    ;通常攻撃の場合
    if usespno=1000 {
        simode=0
        dim siduse,92
        chrno_1=btlchrno
        siduse(1)=(dt(chrno_1,76)+dt(chrno_1,149))/2
        siduse(4)=(dt(chrno_1,76)+dt(chrno_1,149))/2
        
        spkouka(0)=10
        spkouka(1)=0
        noteget msgset1,734+lung
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1
        btlmsgmaxcnt++
    }

    ;アイテム効果UPスキルを持っている場合
    if simode=1 {
        if dtspecial(8,7)>0 {
            k=spkouka(0)
            if k=1 or k=2 or k=11 or k=13 or k=14 or k=15 or k=22 or k=23 or k=24 or k=28 or k=29 or k=39 {
                siduse(1)=siduse(1)+(siduse(1)*dtspecial(8,7)*25)/100
            }
            k=spkouka(1)
            if k=1 or k=2 or k=11 or k=13 or k=14 or k=15 or k=22 or k=23 or k=24 or k=28 or k=29 or k=39 {
                siduse(4)=siduse(4)+(siduse(4)*dtspecial(8,7)*25)/100
            }
        }
    }
            

    
    for spchrno,spchrno_1,spchrno_2+1

        kakuritu=siduse(7)
        ;攻撃+バトルステータスDOWNの場合は確率指定ができないので75%固定で
        if spkouka(0)=29 or spkouka(1)=29:kakuritu=75

        ;属性による＋ーと倍率セット
        zokuseiritu=200,150,125,100,50,0,-100
        zokusei=0
        for nnn,25,41
            if siduse(nnn)=1:zokusei=zokusei+dt(spchrno,nnn+156)
        next
        zokusei=zokusei+3
        if zokusei>6:zokusei=6
        if zokusei<0:zokusei=0
            
        ;属性による効く確率の補正
        if zokusei=0:kakuritu=100
        if zokusei=1:kakuritu=kakuritu+(100-kakuritu)/3*2
        if zokusei=2:kakuritu=kakuritu+(100-kakuritu)/3
        if zokusei=4:kakuritu=kakuritu/2
        if zokusei=5:kakuritu=kakuritu/4
        if zokusei=6:kakuritu=0

        ;0=通常 1=クリティカル 2=当たらない 3=よけられた
        spsetmode=0

        nn1plus=0
        ;1 2 11 13 14 15 22 23 24 28 39
        ;二回行動スキルを持っている場合
        if simode=0 {
            if dtspecial(chrno_1,0)>0 {
                k=spkouka(0)
                if k=1 or k=2 or k=11 or k=13 or k=14 or k=15 or k=22 or k=23 or k=24 or k=28 or k=29 or k=39 {
                    nn1plus++
                }
                k=spkouka(1)
                if k=1 or k=2 or k=11 or k=13 or k=14 or k=15 or k=22 or k=23 or k=24 or k=28 or k=29 or k=39 {
                    nn1plus++
                }
            }
        }
            

                        
                        
        for nn1,0,2+nn1plus
            
            n1=(nn1\2)
            


            //ＨＰ・ＭＰ回復
            if spkouka(n1)=1 or spkouka(n1)=2 {
                if spkouka(n1)=1:hpmp=0
                if spkouka(n1)=2:hpmp=1
                if dt(spchrno,110)>0:damagecnt=nn1:gosub *hpkaifuku
            }

            //通常攻撃・２回攻撃
            if spkouka(n1)=10 or spkouka(n1)=15 {
                hpmp=0
                if dt(spchrno,110)>0 {
                    gosub *kougeki
                    damagecnt++
                    if spkouka(n1)=15:gosub *kougeki:damagecnt++
                }
            }

            //ダメージをあたえる・自爆・変数ダメージ
            if spkouka(n1)=11 or spkouka(n1)=13 or spkouka(n1)=14 or spkouka(n1)=21 {
                hpmp=0
                if spkouka(n1)=11 or spkouka(n1)=21:hpmp=0
                if dt(spchrno,110)>0 {
                    gosub *damagekougeki
                    damagecnt++
                }
                ;自爆の場合はHPゼロにしてメッセージ追加
                if (spkouka(n1)=21) and (spchrno=spchrno_2) {
                    dt(chrno_1,110)=0
                    noteget msgset1,892+lung
                    btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1
                    btlmsgmaxcnt++
                }
            }
            //状態異常回復
            if spkouka(n1)=3 {
                if dt(spchrno,110)>0:gosub *ijouoff
            }
            //状態異常 or 間合いを外す
            if spkouka(n1)=12 or spkouka(n1)=19 {
                if dt(spchrno,110)>0:gosub *ijouset
            }
            //バトルステータスUP
            if spkouka(n1)=24 {
                if dt(spchrno,110)>0:gosub *btlstatsup
            }
            //バトルステータスDOWN
            if spkouka(n1)=28 {
                if dt(spchrno,110)>0:gosub *btlstatsdown
            }
            //攻撃+バトルステータスDOWN
            if spkouka(n1)=29 {
                if dt(spchrno,110)>0 {
                    subsiduse1=siduse(1)
                    subsiduse4=siduse(4)
                    siduse(1)=(dt(chrno_1,76)+dt(chrno_1,149))
                    siduse(4)=(dt(chrno_1,76)+dt(chrno_1,149))
                    gosub *kougeki
                    siduse(1)=subsiduse1
                    siduse(4)=subsiduse4
                    gosub *btlstatsdown
                }
            }
            //生き返らせる
            if (spkouka(n1)=20) and (nn1=0) {
                if dt(spchrno,110)<1 and monrannaway(spchrno)=0:gosub *hpkaifuku
            }
            //凍てつく波動・暖かい波動
            if spkouka(n1)=36 or spkouka(n1)=37 {
                if dt(spchrno,110)>0:gosub *btlupdownstrereace
            }
            //ＨＰ・ＭＰ吸取り
            if spkouka(n1)=22 or spkouka(n1)=23 {
                hpmp=0
                if spkouka(n1)=23:hpmp=1
                if dt(spchrno,110)>0:damagecnt=nn1:gosub *suck
            }
            //即倒
            if spkouka(n1)=32 {
                if (dt(spchrno,110)>0) and (killon(spchrno)=0):gosub *kill
            }
            //倒れ自動復活
            if (spkouka(n1)=34) and (nn1=0) {
                if dt(spchrno,110)>0:gosub *hpautorevive
            }
            //盗む
            if spkouka(n1)=39 {
                if dt(spchrno,110)>0:gosub *steal
            }
            //ワナ
            if spkouka(n1)=45 {
                if spchrno=spchrno_1 {
                    ;回転
                    if (n1=0 and siduse(1)=0) or (n1=1 and siduse(4)=0):gosub *traprotate
                    ;滑る床
                    if (n1=0 and siduse(1)=1) or (n1=1 and siduse(4)=1):
                    ;爆発
                    if (n1=0 and siduse(1)=2) or (n1=1 and siduse(4)=2):gosub *trapexplosion
                    ;アイテム消える
                    if (n1=0 and siduse(1)=3) or (n1=1 and siduse(4)=3):gosub *trapitemerase
                    ;アラーム
                    if (n1=0 and siduse(1)=4) or (n1=1 and siduse(4)=4):
                    ;ワープ
                    if (n1=0 and siduse(1)=5) or (n1=1 and siduse(4)=5):gosub *trapwarp
                }
                ;EX減る
                if (n1=0 and siduse(1)=6) or (n1=1 and siduse(4)=6):gosub *trapexdown
            }
            //自分の店
            if (spkouka(n1)=52) and (nn1=0) {
                sinextmode=2300
            }
            //出現率ダウン
            if spkouka(n1)=53 {
                dt(8,199)=500+rnd(50)
                dt(8,200)=0
                noteget msgset1,1380+lung
                btlmsg(btlmsgmaxcnt)=msgset1
                btlmsgmaxcnt++
            }
            //出現率アップ
            if spkouka(n1)=54 {
                dt(8,199)=0                
                dt(8,200)=500+rnd(50)
                noteget msgset1,1382+lung
                btlmsg(btlmsgmaxcnt)=msgset1
                btlmsgmaxcnt++
            }
            //発明
            if (spkouka(n1)=56) and (nn1=0) {
                gosub *invention
            }
            //たね
            if (spkouka(n1)=57) and (nn1=0) {
                gosub *statesseed
            }
            //店
            if (spkouka(n1)=58) and (nn1=0) {
                gosub *sishop
            }
/*            //スキルを覚える
            if (spkouka(n1)=54) and (nn1=0) {
                gosub *splearn
            }            
*/
            //転職
            if spkouka(n1)=60 {
                gosub *jobchangeok
            }
            //ワープ
            if spkouka(n1)=61 {
                gosub *warp
            }
            
        next
    

    next
            
    ;バトル中に限りオート回復のチェックと実行をする
    if mode>3999 and mode<4400:gosub *autoheal
            
    ;スキルの場合はMPを減らす
    if simode=0 {
        downmp=siduse(0)
        if dtspecial(chrno_1,8)>0:downmp=downmp/2
        dt(chrno_1,111)=dt(chrno_1,111)-downmp
        if dt(chrno_1,111)<0:dt(chrno_1,111)=0
    }
            
    ;アイテムの場合で使用回数１回の場合は減らす
    if simode=1 { 
        if itemd(usespno,17)=0 {
            dt(9,713+itemy+itemsellpage*itempmax)--
            if dt(9,713+itemy+itemsellpage*itempmax)<1:dt(8,713+itemy+itemsellpage*itempmax)=512
            gosub *itempagemaxget
            gosub *itemautosortout
        }
    }
            
    if simode=2:simode=motosimode
            
    if efectok=1 {
        ;エフェクトのセット
        ;setseno=0    ;効果音No.のセット
        ;sevolset=-1000
        setseno=siduse(50)
        sevolset=siduse(57)
        siefectno1=siduse(52)
        siefectno2=siduse(53)
    
        gosub *siefect
    }
            
;dtの内容 dt(8,---)が一人目
;0-5=名前 6=キャラNo. 8=GOLD 9=LV 10=現在の職業
;11-42=EX(各職業ごと) 43-75=LV(各職業ごと)*ゼロだと転職不可
;76=攻 77=防
;(基本値)                         78=力  79=早  80=技  81=業  82=魔  83=予備  84=MAXHP  85=MAXMP
;(基本値への補正% 100=1%)     86=力  87=早  88=技  89=業  90=魔  91=予備  92=MAXHP  93=MAXMP
;(永久BNS)                         94=力  95=早  96=技  97=業  98=魔  99=予備 100=MAXHP 101=MAXMP
;上３つと下３つを加味した   102=力 103=早 104=技 105=業 106=魔 107=予備 108=MAXHP 109=MAXMP
;(武器による補正)                115=up1種類 116=up1値 117=up2種類 118=up2値 119=up3種類 120=up3値
;(防具による補正)                121=up1種類 122=up1値 123=up2種類 124=up2値 125=up3種類 126=up3値
;(装具による補正)                127=up1種類 128=up1値 129=up2種類 130=up2値 131=up3種類 132=up3値
;110=HP 111=MP
;112=回避 113=クリティ 114=命中減
;133=武器 134=防具 135=装具 136=空き
;137=毒 138=封じ 139=眠り 140=呪い
;141=暗闇　142=混乱 143=とりつかれ 144-145=空き
;146=防御状態        0-off 1-on
;147-HP0自動復活    0-off 1-on
;148-かばう or ねらわれ        0=off 1=かばう -1=ねらわれ
;149-攻撃力UPorDOWN     値
;150-防御力UPorDOWN     値
;151-早さUPorDOWN     値
;152-カルマUPorDOWN     値
;153-魔力UPorDOWN     値
;154-物理攻撃回避率UPorDOWN    値
;155-クリティカル率UPorDOWN    値
;156-魔法ダメージUPorDOWN        値
;157=攻撃力UPorDOWN    継続カウンター
;158=防御力UPorDOWN    継続カウンター
;159=速さUPorDOWN        継続カウンター
;160-カルマUPorDOWN    継続カウンター
;161=魔力UPorDOWN        継続カウンター
;162-物理攻撃回避率UPorDOWN    継続カウンター
;163-クリティカル率UPorDOWN    継続カウンター
;164-魔法ダメージUPorDOWN        継続カウンター
;165-攻撃属性 物理
;166-攻撃属性 火
;167-攻撃属性 氷
;168-攻撃属性 理力
;169-攻撃属性 毒眠呪
;170-攻撃属性 封じ
;171-攻撃属性 死
;172-攻撃属性 無属性
;173-攻撃属性 属性9
;174-攻撃属性 属性10
;175-攻撃属性 属性11
;176-攻撃属性 属性12
;177-攻撃属性 属性13
;178-攻撃属性 属性14
;179-攻撃属性 属性15
;180-攻撃属性 属性16
;181-防御属性 物理
;182-防御属性 火
;183-防御属性 氷
;184-防御属性 理力
;185-防御属性 毒眠呪
;186-防御属性 封じ
;187-防御属性 死
;188-防御属性 無属性
;189-防御属性 属性9
;190-防御属性 属性10
;191-防御属性 属性11
;192-防御属性 属性12
;193-防御属性 属性13
;194-防御属性 属性14
;195-防御属性 属性15
;196-防御属性 属性16
;198=空き
;199=敵出現率少ない 0=通常 1～補正・継続カウンター
;200=敵出現率多い   0=通常 1～補正・継続カウンター
;201-712=使用可能スキルid
;dt(8,713-1224)=所持アイテム 種類id
;dt(9,713-1224)=所持アイテム 数量

return

*siefect

            
/*
        ;スキル
        eiteminfostr(36)="エフェクト○×"
        eiteminfostr(37)="効果音"
        eiteminfostr(38)="失敗時効果音"
        eiteminfostr(39)="エフェクト"
        eiteminfostr(40)="揺れ"
        eiteminfostr(41)="R"
        eiteminfostr(42)="G"
        eiteminfostr(43)="B"
        eiteminfostr(44)="Vol."

        selstrie(37)=bgmnmset
        selstrie(38)=bgmnmset
        selstrie(39)="無し\n点滅短い\n点滅長い\nフェードイン\nフェードアウト\n点滅フェードイン\n点滅フェードアウト\nフェードイン&アウト\n点滅フェードイン&点滅アウト\nフェードイン&点滅\n点滅&フェードアウト\n点滅&点滅フェードアウト\n点滅フェードイン&点滅"
        selstrie(40)="無し\n有り\n前半有り\n後半あり"
        selstrie(41)="0\n1\n2\n3"
        selstrie(42)=selstrie(41)
        selstrie(43)=selstrie(41)
        selstrie(44)="0\n-200\n-400\n-600"
*/
/*
        ;アイテム
        eiteminfostr(50)="効果音"
        eiteminfostr(51)="効果音失敗時"
        eiteminfostr(52)="エフェクト"
        eiteminfostr(53)="揺れ"
        eiteminfostr(54)="R"
        eiteminfostr(55)="G"
        eiteminfostr(56)="B"
        eiteminfostr(57)="Vol."
            
        selstrie(50)=bgmnmset
        selstrie(51)=bgmnmset
        selstrie(52)="無し\n点滅短い\n点滅長い\nフェードイン\nフェードアウト\n点滅フェードイン\n点滅フェードアウト\nフェードイン&アウト\n点滅フェードイン&点滅アウト\nフェードイン&点滅\n点滅&フェードアウト\n点滅&点滅フェードアウト\n点滅フェードイン&点滅"
        selstrie(53)="無し\n有り\n前半有り\n後半あり"
        selstrie(54)="0\n1\n2\n3"
        selstrie(55)=selstrie(54)
        selstrie(56)=selstrie(54)
        selstrie(57)="0\n-200\n-400\n-600"

*/    

/*            
    ;効果音セット方法
        setseno=spid(50)    ;効果音No.のセット
        sevolset=-spid(57)*200
        sevolset=-400
        siefectno1=spid(52)    ;エフェクトNo.のセット
        siefectno2=spid(53)    ;揺れNo.のセット
        siefectco1=spid(54)    ;色R
        siefectco2=spid(55)    ;色G
        siefectco3=spid(56)    ;色B
*/

    dim siefectset,2,128;特技・アイテム使用時のエフェクトセット　0,=画面明るさの状態 1,=揺れの状態 ,0-127=それぞれの状態の実際の値
    siefectcnt=-1;特技・アイテム使用時のエフェクトカウント　0はエフェクト終了 127からカウントダウン
    siefectcnt=15

    ;              0     1         2         3           
    ;selstrie(52)="無し\n点滅短い\n点滅長い\nフェードイン"
    ;              4               5                6                  7                  
    ;selstrie(52)="フェードアウト\n点滅フェードイン\n点滅フェードアウト\nフェードイン&アウト
    ;              8                           9                 10                   11                     
    ;selstrie(52)="点滅フェードイン&点滅アウト\nフェードイン&点滅\n点滅&フェードアウト\n点滅&点滅フェードアウト"
    ;              12                     13       14
    ;selstrie(52)="点滅フェードイン&点滅\nサイン波\nノコギリ波\n瞬間フラッシュ"

    ;selstrie(53)="無し\n有り\n前半有り\n後半あり"
    if siefectno1=1 or siefectno1=3 or siefectno1=4 or siefectno1=5 or siefectno1=6:siefectcnt=7
    if siefectno1=15:siefectcnt=7
    if (siefectno1=0) and (siefectno2=0):siefectcnt=-1


    if siefectcnt>0 {
        
        ;前半
        for siefectnn,siefectcnt,siefectcnt-8,-1

            ;フェードアウト
            if siefectno1=4 or siefectno1=6 {
                siefectset(0,siefectnn)=((7-(siefectnn\8))*32)
            }
            ;フェードイン
            if siefectno1=3 or siefectno1=5 or siefectno1=7 or siefectno1=8 or siefectno1=9 or siefectno1=12 {
                siefectset(0,siefectnn)=(siefectnn\8)*32
            }
            ;点滅
            if siefectno1=1 or siefectno1=2 or siefectno1=5 or siefectno1=6 or siefectno1=8 or siefectno1=10 or siefectno1=11 or siefectno1=12 or siefectno1=13 or siefectno1=15 {
                siefectnn1=((siefectnn\2)=1)
                if siefectnn1=1:siefectset(0,siefectnn)=255
            }
            ;揺れ
            if (siefectno2=1 or siefectno2=2) and (siefectnn>1) {
                siefectset(1,siefectnn)=1
            }
            if siefectset(0,siefectnn)>255:siefectset(0,siefectnn)=255
        next

        ;後半
        if  (siefectno1=2) or (siefectno1>6) or (siefectno2=1) or (siefectno2=3) {
            for siefectnn,7,-1,-1

                ;フェードアウト
                if siefectno1=7 or siefectno1=8 or siefectno1=10 or siefectno1=11 {
                    siefectset(0,siefectnn)=((7-siefectnn)*32)
                }
                ;点滅
                if siefectno1=2 or siefectno1=8 or siefectno1=9 or siefectno1=11 or siefectno1=12 {
                    siefectnn1=((siefectnn\2)=1)
                    if siefectnn1=1:siefectset(0,siefectnn)=255
                }
                ;揺れ
                if (siefectno2=1 or siefectno2=3) and (siefectnn>1) {
                    siefectset(1,siefectnn)=1
                }
                if siefectset(0,siefectnn)>255:siefectset(0,siefectnn)=255
            next
            

        }
        
        ;サイン波
        if siefectno1=13 {
            siefectset(0,0)=0
            siefectset(0,1)=85
            siefectset(0,2)=170
            siefectset(0,3)=255
            siefectset(0,4)=170
            siefectset(0,5)=85
            siefectset(0,6)=0
            siefectset(0,7)=85
            siefectset(0,8)=170
            siefectset(0,9)=255
            siefectset(0,10)=170
            siefectset(0,11)=85
            siefectset(0,12)=0
            siefectset(0,13)=85
            siefectset(0,14)=170
            siefectset(0,15)=255
        }
        ;ノコギリ波
        if siefectno1=14 {
            siefectset(0,0)=255
            siefectset(0,1)=0
            siefectset(0,2)=64
            siefectset(0,3)=128
            siefectset(0,4)=192
            siefectset(0,5)=255
            siefectset(0,6)=0
            siefectset(0,7)=64
            siefectset(0,8)=128
            siefectset(0,9)=192
            siefectset(0,10)=255
            siefectset(0,11)=0
            siefectset(0,12)=64
            siefectset(0,13)=128
            siefectset(0,14)=192
            siefectset(0,15)=255
        }
        
        if siefectno1=15:siefectcnt=1
        
    }


return

*siefecton

    if siefectcnt>-1 {
        gshakemode=siefectset(1,siefectcnt)
        meidonn=((255-siefectset(0,siefectcnt))*dt(8,1291))/10
        gmode 4,,,meidonn
        
        if (flashmeido!2) and ((siefectset(0,siefectcnt))!255) {
            pos 0,0
            gzoom 480,ylinemax,1,0,1024,1,1
        }
        siefectcnt--
        if siefectcnt<0:siefectcnt=-1:gshakemode=0
    }

    if siefectcnt<0:siefectcnt=-1:gshakemode=0

return

*kougeki
    
    notesel q

    ;chrno_1=攻撃する側
    ;spchrno=受ける側
    
            
    ;命中するか
    ;本人の命中率
    ataru=100-dt(chrno_1,114)
    if (spkouka(1)=0 or spkouka(1)=10 or spkouka(1)=15) and siduse(7)>0 {
        ataru=siduse(7)
    }
    if spkouka(n1)=29:ataru=100-dt(chrno_1,114)
            
            
    ;本人が暗闇状態
    if dt(chrno_1,141)>0:ataru=ataru/2
    ;修正
    if ataru<5:ataru=5
    ;当たらなかった
    if ataru<rnd(101) {
        spsetmode=2
        noteget msgset1,718+lung
        btlmsg(btlmsgmaxcnt)=msgset1
        btlmsgmaxcnt++
    }

    ;相手の回避率
    kaihi=dt(spchrno,112)
    ;相手が回避率ＵＰorDOWN状態
    kaihi=kaihi+dt(spchrno,154)
    ;相手が寝ている状態
    kaihi=kaihi*(dt(spchrno,139)=0)
    ;修正
    if kaihi>95:kaihi=95
    ;よけられた
    if spsetmode=0 and kaihi>rnd(100) {
        spsetmode=3
        noteget msgset1,720+lung
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
        btlmsgmaxcnt++
    }

    if spsetmode<2 {
        ;属性による＋ーと倍率セット
        zokuseiritu=200,150,125,100,50,0,-100
        zokusei=0
        for nnn,165,181
            if dt(chrno_1,nnn)=1:zokusei=zokusei+dt(spchrno,nnn+16)
            if siduse(nnn-140)=1:zokusei=zokusei+dt(spchrno,nnn+16)
        next
        zokusei=zokusei+3
        if zokusei>6:zokusei=6
        if zokusei<0:zokusei=0
        
        ;ダメージ値の計算
        ;damage=(dt(chrno_1,76)+dt(chrno_1,149))/2-(dt(spchrno,77)+dt(spchrno,150))/4
        damage=siduse(n1*3+1);-(dt(spchrno,77)+dt(spchrno,150))/4
        ataiplus=76,77,102,103,104,105,106,108,109,110,111
        
        ;攻　防　早　カ　魔のバトル中補正を加味
        if spkouka(n1)!29 {
            taisyou=chrno_1
            if siduse(10+n1*2)=1:taisyou=spchrno
            damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=0:damage=damage+(dt(taisyou,149)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=1:damage=damage+(dt(taisyou,150)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=3:damage=damage+(dt(taisyou,151)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=5:damage=damage+(dt(taisyou,152)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=6:damage=damage+(dt(taisyou,153)*(siduse(2+n1*3)*5)/100)
        }

        ;攻撃＋バトステdownの場合は影響値が攻撃力固定
        if spkouka(n1)=29:damage=(damage*(siduse(7)*5))/100
        
        ;クリティカルの場合
        if (dt(chrno_1,113)+dt(chrno_1,155))>rnd(100) {
            spsetmode=1
            ;damage=siduse(n1*3+1)*2
            damage=damage*2
            noteget msgset1,716+lung
            btlmsg(btlmsgmaxcnt)=msgset1
            btlmsgmaxcnt++
            
            ;setseno=0    ;効果音No.のセット
            ;sevolset=-1000
            siduse(52)=15    ;エフェクトNo.のセット
            siduse(53)=0    ;揺れNo.のセット
        }
        
        ;相手の防御力による補正(クリティカルの場合を除く)
        if spsetmode!1:damage=damage-(dt(spchrno,77)+dt(spchrno,150))/4
        
        ;属性相性による補正
        damage=(damage*zokuseiritu(zokusei))/100

        ;相手が防御状態の場合
        if dt(spchrno,146)>0:damage=damage/2
        
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0

        ;値にランダム性をつける
        damagep=0
        damagem=0
        if damage>0:damagep=rnd(damage/5+2):damagem=rnd(damage/5+1)
        if damage<0:damagep=rnd(-damage/5+2):damagem=rnd(-damage/5+1)        

        damage=damage+damagep-damagem
        
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0

        ;ダメージ０の場合は５０％の確率で１ダメージ
        if damage=0 and (zokusei!6):damage=rnd(2)

        ;エフェクトのセット
        efectok=1

        ;回復する場合のエフェクト
        if damage<0 {
            ;setseno=0    ;効果音No.のセット
            ;sevolset=-1000
            siduse(52)=4    ;エフェクトNo.のセット
            siduse(53)=0    ;揺れNo.のセット
        }

        ;文字のセット
        ;通常ダメージ
        if zokusei!6 {
            noteget msgset1,712+lung
            noteget msgset2,714+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(damage,mbyte)+msgset2
            btlmsgmaxcnt++
        }
        ;吸収
        if zokusei=6 {
            noteget msgset1,724+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
            btlmsgmaxcnt++
            noteget msgset1,712+lung
            noteget msgset2,722+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(-damage,mbyte)+msgset2
            btlmsgmaxcnt++
        }
    
        ;ダメージアニメーションのセット
        if (damage>0 and (zokusei!6)) or (damage<0 and (zokusei=6)):btldmganm(spchrno)=5
        
        ;効果の予約をセット
        bdtkoukaonset(spchrno,110)=bdtkoukaonset(spchrno,110)-damage
        
        ;敵の反撃フラグをたてる
        if spchrno<8 {
            ;通常攻撃の場合
            if usespno=1000 and (dt(spchrno,210)!512):doflag(spchrno)=1
            ;スキル攻撃の場合
            if usespno<1000 and (dt(spchrno,211)!512):doflag(spchrno)=2
        }
    }
return

*damagekougeki
    
    notesel q

    ;chrno_1=攻撃する側
    ;spchrno=受ける側
    
    ;0=通常 1=クリティカル 2=当たらない 3=よけられた
    spsetmode=0
/*    
1        U    パラメータ_1
2        U    x %(x5)_1
3        U    spkoukanm_1
4        U    パラメータ_2
5        U    x %(x5)_2
6        U    spkoukanm_2
7        U    効確率%(-避%)
8        U    範囲        単体\n全体\n本人
9        U    場面        いつも\n移動中\n戦闘中\n×
10        U    誰の_1    使用者の\n受者の
11        U    何の値_1    攻撃力\n防御力\n力\n早さ\n器用さ\nカルマ\n魔力\nMAXHP\nMAXMP\nHP\nMP
12        U    誰の_2    使用者の\n受者の
13        U    何の値_2    攻撃力\n防御力\n力\n早さ\n器用さ\nカルマ\n魔力\nMAXHP\nMAXMP\nHP\nMP
*/
    if spsetmode<2 {

        ;ダメージ値の計算
        damage=siduse(n1*3+1)
        
        ;変数ダメージの場合は各計算
        if spkouka(n1)=13 or spkouka(n1)=14 {
            ;√√金
            if siduse(n1*3+1)=0 {
                damage=sqrt(sqrt(dt(8,8)))*(siduse(2+n1*3)*10)/100
                damage=int(damage)
            }
            ;HP1
            if siduse(n1*3+1)=1 {
                damage=dt(spchrno,110)-1
            }
            ;MAXHP-HP
            if siduse(n1*3+1)=2 {
                damage=dt(chrno_1,108)-dt(chrno_1,110)
            }
        }
        
        if spkouka(n1)!13 and spkouka(n1)!14 {
            ataiplus=76,77,102,103,104,105,106,108,109,110,111
            ;149-153
            taisyou=chrno_1
            if siduse(10+n1*2)=1:taisyou=spchrno
            damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)
            ;バトルステータスがUP or DOWNしている場合
            if siduse(11+n1*2)=0:damage=damage+(dt(taisyou,149)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=1:damage=damage+(dt(taisyou,150)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=3:damage=damage+(dt(taisyou,151)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=5:damage=damage+(dt(taisyou,152)*(siduse(2+n1*3)*5)/100)
            if siduse(11+n1*2)=6:damage=damage+(dt(taisyou,153)*(siduse(2+n1*3)*5)/100)

        }
            
        ;属性相性による補正
        damage=(damage*zokuseiritu(zokusei))/100

        ;相手が防御状態の場合
        if dt(spchrno,146)>0:damage=damage/2
        ;相手の魔法ダメージ補正
        damage=damage+(damage*dt(spchrno,156))/100
        
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0
        
        ;値にランダム性をつける
        damagep=0
        damagem=0
        if spkouka(n1)!13 and spkouka(n1)!14 {

            if damage>0:damagep=rnd(damage/5+2):damagem=rnd(damage/5+1)
            if damage<0:damagep=rnd(-damage/5+2):damagem=rnd(-damage/5+1)
            
        }
        
        damage=damage+damagep-damagem
        if damage<0 and (zokusei!6):damage=0
        if damage>-1 and (zokusei=6):damage=0
        
        ;エフェクトのセット
        efectok=1

        ;回復する場合のエフェクト
        if damage<0 {
            ;setseno=0    ;効果音No.のセット
            ;sevolset=-1000
            siduse(52)=4    ;エフェクトNo.のセット
            siduse(53)=0    ;揺れNo.のセット
        }

        ;文字のセット
        ;通常ダメージ
        if zokusei!6 {
            noteget msgset1,712+lung
            noteget msgset2,714+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(damage,mbyte)+msgset2
            btlmsgmaxcnt++
        }
        ;吸収
        if zokusei=6 {
            noteget msgset1,724+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
            btlmsgmaxcnt++
            noteget msgset1,712+lung
            noteget msgset2,722+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(-damage,mbyte)+msgset2
            btlmsgmaxcnt++
        }
        ;金攻撃の場合はお金を落とす
        if spkouka(n1)=13 or spkouka(n1)=14 {
            ;√√金
            if siduse(n1*3+1)=0 {
                dropdamage=damage
                if dropdamage>dt(8,8):dropdamage=dt(8,8)
                if dropdamage>0 {
                    noteget msgset1,642+lung
                    noteget msgset2,1558+lung
                    btlmsg(btlmsgmaxcnt)=vzstr(dropdamage,mbyte)+msgset1+spacestr+msgset2
                    btlmsgmaxcnt++
                    dt(8,8)=dt(8,8)-dropdamage
                }
            }
        }

    
        ;ダメージアニメーションのセット
        if (damage>0 and (zokusei!6)) or (damage<0 and (zokusei=6)):btldmganm(spchrno)=5
        
        ;効果の予約をセット
        bdtkoukaonset(spchrno,110)=bdtkoukaonset(spchrno,110)-damage
        
        ;敵の反撃フラグをたてる
        if spchrno<8 {
            ;通常攻撃の場合
            if usespno=1000 and (dt(spchrno,210)!512):doflag(spchrno)=1
            ;スキル攻撃の場合
            if usespno<1000 and (dt(spchrno,211)!512):doflag(spchrno)=2
        }

    }
return
            
*hpkaifuku
        
    if (spkouka(n1)!22) and (spkouka(n1)!23) and dt(spchrno,140)=0 {
        ;回復値の計算
        damage=siduse(n1*3+1)
        ataiplus=76,77,102,103,104,105,106,108,109,110,111
        taisyou=chrno_1
        if siduse(10+n1*2)=1:taisyou=spchrno
        damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)
        ;バトルステータスがUP or DOWNしている場合
        if siduse(11+n1*2)=0:damage=damage+(dt(taisyou,149)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=1:damage=damage+(dt(taisyou,150)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=3:damage=damage+(dt(taisyou,151)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=5:damage=damage+(dt(taisyou,152)*(siduse(2+n1*3)*5)/100)
        if siduse(11+n1*2)=6:damage=damage+(dt(taisyou,153)*(siduse(2+n1*3)*5)/100)

        ;値にランダム性をつける
        if damage>0:damagep=rnd(damage/5+2):damagem=rnd(damage/5+1)
        if damage<0:damagep=rnd(-damage/5+2):damagem=rnd(-damage/5+1)        
    
        damage=damage+damagep-damagem
        if damage<0 :damage=0

        ;効果の予約をセット
        bdtkoukaonset(spchrno,110+hpmp)=bdtkoukaonset(spchrno,110+hpmp)+damage
    }
        

    ;回復する場合のエフェクト
    if damage!0 {
        efectok=1
    }


    ;文字のセット
    ;呪われていない場合
    notesel q
    if dt(spchrno,140)=0 {
        if (spkouka(n1)!20) {
            noteget msgset1,712+lung
            ;HP or MP 回復
            if zokusei!6 {
                noteget msgset2,722+lung
                if hpmp=1:noteget msgset2,786+lung
                btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(damage,mbyte)+msgset2
            }
            ;HP or MP すいとられ
            if zokusei=6 {
                noteget msgset2,870+hpmp*2+lung
                btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+vzstr(-damage,mbyte)+msgset2
            }
        } else {
            ;復活 バトルゲージもリセット
            noteget msgset1,866+lung
            if hpmp=1:noteget msgset2,786+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
            dt(spchrno,110)=damage
            if dt(spchrno,110)>dt(spchrno,108):dt(spchrno,110)=dt(spchrno,108)
            bdtkoukaonset(spchrno,110+hpmp)=0
            btlgauge(spchrno)=0+rnd((dtspecial(spchrno,18)>0)*20000+1)
        }
    }
    ;呪われている場合
    if dt(spchrno,140)>0 {
        noteget msgset1,910+lung
        btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
    }

    btlmsgmaxcnt++
        

return            

*autoheal
            
    autohealonoff=0
            
    ;自動HPMP回復のスキル
    if dt(chrno_1,110)>0 {
        notesel q
        ;HP
        if dtspecial(chrno_1,14)>0 {
            if (dt(chrno_1,110)+bdtkoukaonset(chrno_1,110))<dt(chrno_1,108) {
                damage=dt(chrno_1,108)/20+rnd(dt(chrno_1,108)/20+4)+1
                noteget msgset1,712+lung
                noteget msgset2,722+lung
                ;if hpmp=1:noteget msgset2,786+lung
                if (btlmsgmaxcnt\3)=1:btlmsgmaxcnt++
                if (btlmsgmaxcnt\3)=2:btlmsgmaxcnt++
                btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+vzstr(damage,mbyte)+msgset2
                btlmsgmaxcnt++
                ;効果の予約をセット
                bdtkoukaonset(chrno_1,110)=bdtkoukaonset(chrno_1,110)+damage
                autohealonoff=1
            }
        }
        ;MP
        if dtspecial(chrno_1,15)>0 {
            if (dt(chrno_1,111)+bdtkoukaonset(chrno_1,111))<dt(chrno_1,109) {
                damage=dt(chrno_1,109)/20+rnd(dt(chrno_1,109)/20+4)+1
                noteget msgset1,712+lung
                noteget msgset2,786+lung
                ;if hpmp=1:noteget msgset2,786+lung
                if (btlmsgmaxcnt\3)=1:btlmsgmaxcnt++
                if (btlmsgmaxcnt\3)=2:btlmsgmaxcnt++
                btlmsg(btlmsgmaxcnt)=btlchrnmstr(chrno_1)+msgset1+vzstr(damage,mbyte)+msgset2
                btlmsgmaxcnt++
                ;効果の予約をセット
                bdtkoukaonset(chrno_1,111)=bdtkoukaonset(chrno_1,111)+damage
                autohealonoff=autohealonoff+2
            }
        }
    }
return
            
*ijouoff
            
    kikukikanai=0

    for nnnnnn,137,144
        if dt(spchrno,nnnnnn)>0 and ((siduse(1+n1*3)=nnnnnn-137) or (siduse(1+n1*3)=8)) {
            bdtkoukaonset(spchrno,nnnnnn)=-dt(spchrno,nnnnnn)
            ;文字のセット
            noteget msgset1,788+(nnnnnn-137)*2+lung
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
            btlmsgmaxcnt++
            kikukikanai=1
        }
    next

    ;効いた場合のエフェクト
    if kikukikanai=1 :efectok=1

return

*ijouset
            
    kikukikanai=0

    
    ;spsetmode 0=通常 1=クリティカル 2=当たらない 3=よけられた
    ;このうち2か3の場合で攻撃の追加効果の場合はきかないようにする
    ;そうでないと当たらなかったのに毒になったりする
    if spsetmode<2 {
        for nnnnnn,137,144
            if kakuritu>rnd(100) and ((siduse(1+n1*3)=nnnnnn-137) or (siduse(1+n1*3)=8)) {
            
                ;状態異常
                if spkouka(n1)=12 {
                    bdtkoukaonset(spchrno,nnnnnn)=100+kakuritu;これが1以上だと異常状態
                    ;文字のセット
                    noteget msgset1,806+(nnnnnn-137)*2+lung
                    ;眠った場合でゲージが満タンの場合はゲージを減らす
                    if mode>3999 {
                        if nnnnnn=139 and btlgauge(spchrno)>59999:btlgauge(spchrno)=59999
                    }
                }
                ;間合いを外す
                if spkouka(n1)=19 {
                    btlgauge(spchrno)=0+rnd((dtspecial(spchrno,18)>0)*20000+1)
                    ;文字のセット
                    noteget msgset1,842+lung
                }
            
                btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1
                btlmsgmaxcnt++
                kikukikanai=1
            
                ;ダメージアニメーションのセット
                btldmganm(spchrno)=5

            }
        next
    }
            
    ;効かなかった時の文字セット
    if kikukikanai=0 and n1=0 {
        missmsgno=siduse(14)
        gosub *missmsgget
        btlmsg(btlmsgmaxcnt)=missmsg
        btlmsgmaxcnt++
    }
            
    ;効いた場合のエフェクト
    if kikukikanai=1 :efectok=1

return
            
*btlstatsup
            
    kikukikanai=0
            
    ;UP値の計算
    damage=siduse(7)
    ataiplus=76,77,102,103,104,105,106,108,109,110,111
    taisyou=chrno_1
    if siduse(10+n1*2)=1:taisyou=spchrno
    damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)

    for nnnnnn,149,157
        if ((siduse(1+n1*3)=nnnnnn-149) or (siduse(1+n1*3)=9)) {
            henka=76,77,103,105,106,112,113,114
            ;UP値のセット
            ;元の値と合わせて４倍以上にはならない
            ;                                                                                                                                                              ↓基本値とこの*3を合わせると4倍
            if nnnnnn<154 and ((dt(spchrno,henka(nnnnnn-149))*3)<(dt(spchrno,nnnnnn)+damage)):damage=(dt(spchrno,henka(nnnnnn-149))*3)-dt(spchrno,nnnnnn)
            ;元の値と合わせて100以上にはならない
            if nnnnnn>153 and (99<(dt(spchrno,nnnnnn)+damage)):damage=100-dt(spchrno,nnnnnn)

            bdtkoukaonset(spchrno,nnnnnn)=bdtkoukaonset(spchrno,nnnnnn)+damage
            
            ;継続カウンターのセット　これが0まで減るとUP状態の解除
            bdtkoukaonset(spchrno,nnnnnn+8)=siduse(7)+100
            ;文字のセット
            noteget msgset1,712+lung;は
            noteget msgset2,844+(nnnnnn-149)*2+lung
            noteget msgset3,860+lung;が
            noteget msgset4,862+lung;あがった！
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+msgset2+msgset3+vzstr(damage,mbyte)+msgset4
            btlmsgmaxcnt++
            kikukikanai=1
        }
    next

    ;効かなかった時の文字セット
    if kikukikanai=0 {
        missmsgno=siduse(14)
        gosub *missmsgget
        btlmsg(btlmsgmaxcnt)=missmsg
        btlmsgmaxcnt++
    }

    ;効いた場合のエフェクト
    if kikukikanai=1 :efectok=1
    
return
            
*btlstatsdown
            
    kikukikanai=0

    ;DOWN値の計算
    damage=0;siduse(n1*3+1)
    ataiplus=76,77,102,103,104,105,106,108,109,110,111
    taisyou=chrno_1
    if siduse(10+n1*2)=1:taisyou=spchrno
    damage=damage+(dt(taisyou,ataiplus(siduse(11+n1*2)))*(siduse(2+n1*3)*5)/100)

    for nnnnnn,149,157
            
        if kakuritu>rnd(100) and ((siduse(1+n1*3)=nnnnnn-149) or (siduse(1+n1*3)=8)) {
            
            henka=76,77,103,105,106,112,113,114
            ;DOWN値のセット
            ;元の値と合わせてゼロ以下にはならない
            ;  0>基本値-すでに下がっている値-今回減る予定の値:damage=すでに下がっている値+基本値
            ;                                             ↓すでに下がっている値はマイナス値なのでここはプラスにする
            if 0>dt(spchrno,henka(nnnnnn-149))+dt(spchrno,nnnnnn)-damage:damage=dt(spchrno,nnnnnn)+dt(spchrno,henka(nnnnnn-149))
            bdtkoukaonset(spchrno,nnnnnn)=bdtkoukaonset(spchrno,nnnnnn)-damage
            ;カウンター　これが0まで減ると異常状態の解除
            bdtkoukaonset(spchrno,nnnnnn+8)=100+kakuritu

            ;ダメージアニメーションのセット
            btldmganm(spchrno)=5

            ;文字のセット
            noteget msgset1,712+lung;は
            noteget msgset2,844+(nnnnnn-149)*2+lung
            noteget msgset3,860+lung;が
            noteget msgset4,864+lung;さがった！
            btlmsg(btlmsgmaxcnt)=btlchrnmstr(spchrno)+msgset1+msgset2+msgset3+vzstr(damage,mbyte)+msgset4
            btlmsgmaxcnt++
            kikukikanai=1
        }
            
    next
            
    ;効かなかった時の文字セット
    if kikukikanai=0 {
        missmsgno=siduse(14)
        gosub *missmsgget
        btlmsg(btlmsgmaxcnt)=missmsg
        btlmsgmaxcnt++
    }
            
    ;効いた場合のエフェクト
    if kikukikanai=1 :efectok=1

return

