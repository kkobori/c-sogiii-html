#global

*platform

    //plat_form = PLATFORM_WINDOWS
    getreq plat_form, SYSREQ_PLATFORM
    slfolder=""
    testslfolder=""

    
    ;デバッグか製品か 0=製品 1=デバッグ
    debugonoff=1
    
    switch plat_form
    case PLATFORM_WINDOWS
        pmmc=2
        ios=0
        mbyte=2
        ylinemax=800
        zoom=1
        folder="C:/kobori software/sog3/gdata/"
        slfolder="C:/kobori software/sog3/"
        testslfolder="C:/kobori software/sog3/"
        swbreak
    case PLATFORM_IOS
        ios=1
        mbyte=2
        ylinemax=800
        zoom=1
        folder="gdata/"
        swbreak
    case PLATFORM_ANDROID

        pmmc=stat
        pmmcstarton=0;0=初めてアプリを立ち上げた状態でpmmcが４になっている 1=初めてじゃない
        ;たぶん
        ;pmmc=2;パーミッション許可済み
        ;pmmc=3;パーミッション許可をしない
        ;pmmc=4;初めてアプリを立ち上げた
        ;pmmc=5;APIが23より古い
        ;dialogonoff=0;この値が１だとmode=50の時にパーミッション許可選択画面が出る

        if pmmc=5:pmmc=2;:pmmcstarton=1

        ios=0
        mbyte=3
        ylinemax=800

        zoom=1

        folder="::folderauto::/gdata/"
        slfolder="::folderauto::"
        folder="gdata/"
        slfolder=""
        testslfolder=""
            
        if debugonoff=1 {
            folder="/storage/emulated/0/sogiii/gdata/"
            slfolder="/storage/emulated/0/sogiii/"
            testslfolder="/storage/emulated/0/sogiii/"
        }

        swbreak
    case PLATFORM_wwwANDROID

        pmmc=stat
        pmmcstarton=0;0=初めてアプリを立ち上げた状態でpmmcが４になっている 1=初めてじゃない
        ;たぶん
        ;pmmc=2;パーミッション許可済み
        ;pmmc=3;パーミッション許可をしない
        ;pmmc=4;初めてアプリを立ち上げた
        ;pmmc=5;APIが23より古い
        ;dialogonoff=0;この値が１だとmode=50の時にパーミッション許可選択画面が出る

        if pmmc=5:pmmc=2;:pmmcstarton=1

        ios=0
        mbyte=3
        ylinemax=800

        zoom=1

        folder="::folderauto::/gdata/"
        slfolder="::localstorage::"
        testslfolder="::folderauto::/gdata/"
        
        if debugonoff=0 {
            testslfolder="::localstorage::"
        }

        swbreak
    case PLATFORM_wwwWEBGL
        pmmc=2
        ios=0
        mbyte=2
        ylinemax=800
        zoom=1
        
        folder="::folderauto::/gdata/"
        slfolder="::folderauto::/gdata/"
        testslfolder="::folderauto::/gdata/"
        
        if debugonoff=0 {
            testslfolder="::localstorage::"
        }
        
        swbreak
    swend
    
    mbyte=3

    gosub *sogiiidanmakeini
    
*mode_100_main

repeat

    gosub *ontouch
    
    if rmy<150 and rmy>50 and mode=1000:nextmode=4010
    if rmy<150 and rmy>50 and mode>3999 and mode<4030:nextmode=1000:dt(8,1292)=msetfrd(17)

    ;イベント自動開始時　ボタンを離したら正式に開始
;    if mode=2005 and mx=-1 {
;        nextmode=2000
        ;evestartok=1
        ;evestartonoff=1
        ;idocnt=0
        ;meswaitput=0
        ;eveline=0
        ;chrnmtxton=0
;    }

    if mode>4000 and nextmode=1000 and evebtl=1 and takaracheckon=0:eveline=bforebtleveline+1:nextmode=2000

    if mode=1000 and takaracheckon=0:evebtl=0

    if mode!nextmode {
    
        if nextmode=1000 {
            mmstop
            mmplay 0
        }
        if nextmode=4000 {
            mmstop
            mmload "::mmlt::gdata/bgm/btl.txt", 1, 1
            mmplay 1
        }        
        
        gosub *dtspecialset

        ;ファイル選択の場合は各ファイルの名前とLVを取得する
        if nextmode=100:gosub *slnmlvget
        
        ;バトル終了時にマイショップのアイテムが売れるか
        if nextmode=1000 and mode>3999 {
            ;１０個を上から順番にチェック
            for nnnis,0,10
                ;確率　まだ売れていない
                if rnd(100)<5 and dt(15,723+nnnis)=0 {
                    ;持ちアイテム512個分との照合をする
                    for nnnnnnis,713,1225
                        if dt(15,713+nnnis)=dt(8,nnnnnnis) {
                            ;持ちアイテムが１個以上ある場合
                            if dt(9,nnnnnnis)>0 {
                                dt(9,nnnnnnis)--
                                dt(15,723+nnnis)=dt(15,723+nnnis)+itemd(dt(15,713+nnnis),0)
                                ;アイテムがなくなった場合
                                if dt(9,nnnnnnis)<1 {
                                    dt(15,713+nnnis)=0
                                    dt(8,nnnnnnis)=512
                                    dt(9,nnnnnnis)=0
                                    gosub *itemautosortout
                                }
                                nnnnnnis=1230
                            }
                        }
                    next
                    if nnnnnnis=1225 {
                        dt(15,713+nnnis)=0
                    }
                }
            next
            
        }
        ;バトル終了時に宝箱が現れるか
        if nextmode=1000 and takaracheckon=1 and mode>3999 {;and evebtl=0 {
            takaracheckon=0
            boxinitemmax=0
            dim boxinitem,24
            for nnmon,0,monmax
                for nnbox,0,3
                    if montrasure(nnmon,nnbox)!0 and monrannaway(nnmon)=0 {
                        itemgetcheck=rnd(1000)
                        ;必ず手に入る
                        itemgetper=1000
                        ;通常
                        if nnbox=1:itemgetper=25*(1+dtspecial(8,5))
                        ;レア
                        if nnbox=2:itemgetper=8*(1+dtspecial(8,5))
                        if itemgetcheck<itemgetper {
                            boxinitem(boxinitemmax)=montrasure(nnmon,nnbox)
                            boxinitemmax++
                        }
                    }
                next
            next
            if boxinitemmax>0 {
                nextmode=4062
                takaragetok=1
                msetfr=fr
                gosub *msetfrdset
                pickuptraplv=msetfrd(18),msetfrd(19),msetfrd(20)
                gosub *traplvpickup
                if trappickupmax>0:trapno=pickuptrapno(rnd(trappickupmax))
                gosub *btlmsgreset
                notesel q
                noteget msgset1,1548+lung
                btlmsg(btlmsgmaxcnt)=msgset1
                btlmsgmaxcnt++
            } else {
                ;宝は無いがイベントバトルの場合
                if evebtl=1 :eveline=bforebtleveline+1:nextmode=2000
            }
        }
        
        if nextmode=1010:useseitonsely=0:gosub *btlchrnmstrset:gosub *itempagemaxget
        
        if nextmode=1035:useseitonsely=0
            
        if ((nextmode=1020 or nextmode=1022) and (mode!1021)) or (nextmode=4160 and (mode!4161)) {
            gosub *itemautosortout
            itemselectmode=0
            gosub *itemselectset
            gosub *itempagemaxget
            gosub *itemuseokngset
            if mode=1300 {
                if itemsellpage>itempagemax:itemsellpage=itempagemax
                while dt(9,dt(11,713+itemselly+itemsellpage*10))=0 and itemselly>0
                    itemselly--
                wend
            }
            if mode=1010 {
                itemsellpage=0
                itemy=0
            }
        }
        if (nextmode=1020 or nextmode=1021) and useseitonsely=0:gosub *itemuseokngset
        if nextmode=1030 or nextmode=1031 or nextmode=1035:gosub *spuseokngset
        if nextmode=1040 or nextmode=1041:gosub *spuseokngset
        if nextmode=1055:gosub *jobputset:jobselx=0:jobsely=0:jobpage=0
        if nextmode=1080 or nextmode=1180 or nextmode=1181 or nextmode=4080 or nextmode=4081 {
            itemselectmode=eqipy+1
            gosub *itemselectset
            gosub *itempagemaxget
            gosub *itemuseokngset
            gosub *itemeqipinfoset
            ;eqipitemno=dt(8,dt(11,713+itemy+itemsellpage*itempmax))
            a=dt(11,713+itemy+itemsellpage*itempmax)
            eqipitemno=dt(8,a)
            if a>1224:eqipitemno=0
            gosub *itemeqipinfoset
        }
        ;ワナ外しの準備
        if nextmode=1410 or nextmode=1510 or nextmode=4410 {
            dim trapoff,440
            trapseronoff=rnd(2)
            ;最も器用さが高いキャラの器用さ
            kiyousamax=0
            for nn,8,partymax+8
                if dt(nn,104)>kiyousamax:kiyousamax=dt(nn,104)
            next
            ;最も器用さが高いキャラの器用さ＊(ワナ外しスキル人数+1)÷(罠レベル+1)÷5            
            trapoffrndset=(kiyousamax*(dtspecial(8,10)+1))/(traplv+1)/5
            if trapoffrndset>20:trapoffrndset=50
            for nn,0,440
                if trapseronoff=0:trapsel=rnd(100)+5                        ;失敗
                if trapseronoff=1:trapsel=rnd(5+trapoffrndset)+5        ;成功
                if nn+trapsel>440:trapsel=440-nn
                for nnnn,nn,nn+trapsel
                    trapoff(nnnn)=trapseronoff
                next
                trapseronoff=1-trapseronoff
                nn=nn+trapsel
            next
            trapoffcsl=rnd(430)+5
            trapoffcslpm=10
            if rnd(2)=1:trapoffcslpm=-trapoffcslpm
        }
        ;宝箱からアイテム入手
        if nextmode=1430 or nextmode=4430 or (mode=1420 and nextmode=1000) or (mode=4420 and nextmode=1000) {
            ;爆発していないのであれば入手
            if takaragetok=1 {
                gosub *btlmsgreset
                notesel q
                noteget msgset1,1542+lung
                for nnnmax,0,boxinitemmax
                    trasureitemno=boxinitem(nnnmax)
                    btlmsg(btlmsgmaxcnt)=itemnm(trasureitemno,lung)+msgset1
                    btlmsgmaxcnt++
                    for nnnnnn,713,1225
                        if dt(8,nnnnnn)=trasureitemno and dt(9,nnnnnn)>0 {
                            dt(9,nnnnnn)++
                            nnnnnn=2000
                        }
                        if dt(8,nnnnnn)=512 and dt(9,nnnnnn)=0 {
                            dt(8,nnnnnn)=trasureitemno
                            dt(9,nnnnnn)++
                            nnnnnn=2000
                        }
                    next
                next
            }
            ;宝をリセット    
            if (mode!4420) and (mode!4417) {
                ;bbins(挿入する数値,セットする数値のbit桁,変換前数値,挿入bitインデックス)
                dt(12,713+trasureno)=bbins(0,18,dt(12,713+trasureno),0)
                poke dt(13,713+trasureno),0,100+rnd(100)
                ;dt(13,713+trasureno)=100+rnd(100)
                gosub *takaraset
                henfr=(fr+1)-dmindanf
                henix=ix-dmindanx
                heniy=iy-dmindany
                poke mapd(henfr,henix,heniy),2,0
                gosub *mappidset
            }
        }
        
        ;店などから出るときに一歩後退する
        if nextmode=1000 and exitreturn=1 {
            exitreturn=0
            autoidocnton=evemychrido(0)+1
            if idocntnext=0:evemychrido(autoidocnton)=13
            if idocntnext=1:evemychrido(autoidocnton)=11
            if evemychrido(0)<128:evemychrido(0)++
        }
                
        ;店に入るときに特価品を設定
        if nextmode=2070 and mode!2080 and mode!2120 {
            ;(50+rnd((5-人数)x10))%引き
            dim specialplice,10
            for shopn,0,shopitemmax,1
                specialplice(shopn)=100
                if (getshop(shopn)!0) and (rnd(100)<5) and (dtspecial(8,19)>0) {
                    specialplice(shopn)=50+rnd(5-dtspecial(8,19))*10
                }
            next

        }
        if nextmode=2070 or nextmode=2080 or nextmode=2310 {
            simode=1
            itemselectmode=0
            dim shopselln,1225,3    ;0=売りたい数 1=持っている数
            gosub *itemselectset
            gosub *itempagemaxget
        }
        if (nextmode=2120 or nextmode=2130) and (mode!2121) {
            itemselectmode=0
            gosub *itemselectset
            gosub *itempagemaxget
            if mode=2070 {
                itemselly=0
                itemsellpage=0
                itempmax=8
                itemsellgoldmax=0
            }
            gosub *shopsellnset
        }
        if nextmode=2205:gosub *jobputset
        if nextmode=2225:gosub *spuseokngset
        
        ;マイショップ 入るときに売れていたものがあったら表示
        if nextmode=2300 {
            getmyshopgold=0
            for nnn,0,10
                if dt(15,723+nnn)>0 {
                    getmyshopgold=getmyshopgold+dt(15,723+nnn)
                    dt(15,723+nnn)=0
                }
            next
            if getmyshopgold>0 {
                nextmode=2305
                notesel q
                noteget strset1,642+lung
                noteget strset2,1564+lung
                msg(0)=vzstr(getmyshopgold,mbyte)+strset1+strset2
                msg(1)=nostr
                msg(2)=nostr
            }
        }
        ;マイショップのアイテム所持数セット　ゼロの場合は自動で棚から外す
        if nextmode=2300 {
            dim myshopitemhave,10
            for nnn,0,10
                for nnnnnn,713,1225
                    if dt(15,713+nnn)=dt(8,nnnnnn) {
                        myshopitemhave(nnn)=dt(9,nnnnnn)
                        nnnnnn=1230
                    }
                next
                if nnnnnn=1225 {
                    dt(15,713+nnn)=0
                    myshopitemhave(nnn)=0
                }
            next
        }
        
        ;ねがいのいずみ　広告読み込み失敗したあとにねがいのいずみに戻る
        if nextmode=2400 and mode=2430 {
            noteget msg(0),1566+lung
            noteget msg(1),1568+lung
            noteget msg(2),1570+lung
        }
            
        if nextmode=4010 and mode=1000 :gosub *btlcheck:rmx=-1:rmy=-1
        if nextmode>4010 :btlstartmode=0
        if nextmode=4020:useseitonsely=0
            if nextmode=4020 and mode<4020 {
            
            simode=0
            
            btlcomsely=0
            
            spy=0
            spselpage=0
            hpzeroselmode=0
        }
        if nextmode=4070 and ((mode!4080) or (mode!4081)):eqipy=0
        if nextmode=4075 {
            eqipitemuseokng=0
            usespno=dt(chrno,133+eqipy)
            hanni=itemd(usespno,8)
            spchrno_1=btlchrno
            spchrno_2=btlchrno
            simode=1
            spitemno=usespno
            gosub *siduseset
            gosub *spitemchrselokngget
            ;自分
            if (hanni=2) and (koukaokng(3)!0) and (koukaokng(6)!0):eqipitemuseokng=1
        }
        if nextmode=4110 and mode=4020 {
            chrno=btlchrno
            gosub *sppagemaxget
            gosub *spuseokngset            
        }
        if nextmode=4160 and mode=4020 {
            chrno=btlchrno
            gosub *itemautosortout
            itemselectmode=0
            gosub *itemselectset
            gosub *itempagemaxget
            gosub *itemuseokngset            
            itemsellpage=0
            itemy=0
        }

        mode=nextmode
        pxp=0
        pyp=0
        
    }
    
    ;広告読み込み中
    
    if mode=2410 {
        
        mode2410waitcnt--
    
        if mode2410waitcnt=0 {
            gosub *admobisset
            notesel q
        
            ;表示成功
            if (admobres>0) or (mbyte=2) {
                nextmode=2420        
                noteget msg(0),1598+lung+izumiy*2
                msg(1)=nostr
                msg(2)=nostr
                
                if izumiy=0 {
                    
                    nnnnre=rnd(resettakaramax)
                    nnre=resettakara(nnnnre)
                    
                    setfr=takaradata(nnre,2)+1
                    setx=takaradata(nnre,3)
                    sety=takaradata(nnre,4)
                    ;マップを床から宝に変える
                    henfr=(setfr)-dmindanf
                    henix=(setx)-dmindanx
                    heniy=(sety)-dmindany
                    poke mapd(henfr,henix,heniy),2,3
                    ;カウンタをゼロにする
                    poke dt(13,713+nnre),0,0
                    
                }
                ;ワナを消す
                if izumiy=1 {
                    area=0
                    for setiy,0,16
                        for setix,0,16
                            tgetfr=fr
                            tgetix=setix+mindanx
                            tgetiy=setiy+mindany
                            henfr=(fr+1)-dmindanf
                            henix=(tgetix)-dmindanx
                            heniy=(tgetiy)-dmindany
                            if (peek(mapd(henfr,henix,heniy),2)\1000)=4 {
                                gosub *trapnoget
                                poke dt(13,713+trapsetno),1,30+rnd(150)
                                henfr=(fr+1)-dmindanf
                                henix=(tgetix)-dmindanx
                                heniy=(tgetiy)-dmindany
                                poke mapd(henfr,henix,heniy),2,0
                            }
                        next
                    next
                    gosub *mappidset
                }
                ;敵の気配を消す
                if izumiy=2 {
                    dt(8,1292)=3000
                }
                ;ステータスアップ
                if izumiy=3 and partymax>0 {
                    upchrno=rnd(partymax)+8
                    upstrno=99
                    while upstrno=99
                        upstrno=rnd(8)+94
                    wend
                    
                    dt(upchrno,upstrno)++
                    chrno=upchrno
                    gosub *plstrset
                    
                    namechrno=upchrno
                    gosub *plnameget
                    
                    noteget msgset1,26
                    noteget msgset2,432+(upstrno-94)*2
                    noteget msgset3,56
                    noteget msgset4,217
                    noteget msgset5,862
                    
                    msg(0)=chrname+msgset1+spacestr+msgset2+msgset3+spacestr+msgset4+msgset5

                }
                ;全快
                if izumiy=4 {
                    for n3,8,partymax+8,1
                        dt(n3,110)=dt(n3,108)
                        dt(n3,111)=dt(n3,109)
                        dt(n3,137)=0
                        dt(n3,138)=0
                        dt(n3,139)=0
                        dt(n3,140)=0
                        dt(n3,141)=0
                        dt(n3,142)=0
                        dt(n3,143)=0
                    next
                }
                ;詰所前へワープ
                if izumiy=5 {
                    fr=128
                    ix=128
                    iy=128
                    ins=-1
                    iwe=0
                    gosub *nsweget
                    gosub *mappidset
                    msetfr=fr
                    gosub *msetfrdset
                }
                            
            ;表示失敗
            } else {
                nextmode=2430
        
                noteget msg(0),1618+lung
                msg(1)=nostr
                msg(2)=nostr
            
            }
        }
    }

    ;広告表示時にボリュームをゼロにして表示が終わったら徐々にボリュームを戻す
    if admobisvolcnt>-1 {
        mmvol 1,-1000
        if admobisvolcnt<32 {
            setvol=1000-(((bgmvol+1000)*bgmvolsys)/10)
            nnnvol=1000-((1000-setvol)*(32-admobisvolcnt))/32
            mmvol 1,-nnnvol;sevolset
        }
        admobisvolcnt--
    }
    
    ;getreq fpscsl,SYSREQ_timer
    fpscsl++
    if fpscsl>20:fpscsl=0
    cslpcnt=((fpscsl>8) or (mx!-1))
    tenpcnt=(fpscsl>8)
    ;cslpcnt=1


    redraw 0

        gosub *putg
        
        if btn(0)=1 or btnr(0)=1:gosub *budan
        if btn(1)=1 or btnr(1)=1:gosub *brdan
        if btn(2)=1 or btnr(2)=1:gosub *bddan
        if btn(3)=1 or btnr(3)=1:gosub *bldan

        if btn(4)=1 or btnr(4)=1:gosub *badan
        if btn(5)=1 or btnr(5)=1:gosub *bbdan


        
/*
evepstr(0)="乗れる\n乗れない\nくぐる"
evepstr(1)="前\n後\n左\n右"
evepstr(2)="移動無\nする1\nする2\nする3\nする4\nする5\nする6\nする7"
evepstr(3)="足踏有\n足踏無"
evepstr(4)="向く\n向かない"

    eveundertop=bbget(evepropaty(eveno,1),28,2);乗れるか
    evehassei(0)=bbget(evepropaty(eveno,2),0,1);発生方法＝乗る
    evehassei(1)=bbget(evepropaty(eveno,2),1,1);発生方法＝触れる
    evehassei(2)=bbget(evepropaty(eveno,2),2,1);発生方法＝ボタン
    evehassei(3)=bbget(evepropaty(eveno,2),3,1);発生方法＝自動
    evehassei(4)=bbget(evepropaty(eveno,2),12,1);ボタン表示をオンのままにする
    evehassei(5)=bbget(evepropaty(eveno,2),4,8);ボタンで発生の場合の表示テキストNo.
    evechrno=bbget(evepropaty(eveno,2),13,9);表示キャラNo.
    evechrmuki=bbget(evepropaty(eveno,2),22,4);表示キャラ向き
    evechridou=bbget(evepropaty(eveno,2),26,4);表示キャラ移動速度
    evechrashi=bbget(evepropaty(eveno,2),30,1);表示キャラ足踏み
    evechrmukuka=bbget(evepropaty(eveno,2),31,1);表示キャラ向くかどうか

*/

        ;イベント開始チェック
        if evestartok!-1:evestartok=0
        if mode=1000 {
            evestartswokng=0
;-dmindanf
;-dmindanx
;-dmindany
            even=eveloctoid(fr-dmindanf,ix-dmindanx,iy-dmindany)-1
            if even>-1 {
                eveyuukouparameta=bbget(evepropaty(even,3),9,8);イベントが有効となるスイッチなどのパラメータ
                eveyuukousyurui=bbget(evepropaty(even,3),17,3);イベントが有効となる条件の種類
                evestartsw=bbget(dt(8,1225+eveyuukouparameta/32),(eveyuukouparameta\32),1)
                if eveyuukousyurui=1 and evestartsw=1:evestartswokng=1
                if eveyuukousyurui=2 and evestartsw=0:evestartswokng=1
            }
;-dmindanf
;-dmindanx
;-dmindany
            if eveloctoid(fr-dmindanf,ix-dmindanx,iy-dmindany)>0 and evestartok=0 and evestartswokng=0 {
                evestartok=1
                checkeveno=eveloctoid(fr-dmindanf,ix-dmindanx,iy-dmindany)-1
                eveno=eveloctoid(fr-dmindanf,ix-dmindanx,iy-dmindany)-1
                if eveno>-1 {
                    gosub *evecheck
                    if evehassei(0)=0:evestartok=0
                    if evehassei(2)=1 and evehassei(0)=0:evestartok=2;ボタンで開始する
                    if evehassei(6)=1 and ins=-1:evestartok=0
                    if evehassei(7)=1 and ins=1:evestartok=0
                    if evehassei(8)=1 and iwe=1:evestartok=0
                    if evehassei(9)=1 and iwe=-1:evestartok=0
                }
            }
        }

        ;ワナチェック
        if mode=1000 {
            henfr=(fr+1)-dmindanf
            henix=(ix)-dmindanx
            heniy=(iy)-dmindany
            kokoyuka=peek(mapd(henfr,henix,heniy),2)\1000
            if kokoyuka=4 and idocnt=0 {
                evestartok=4
            }
        }

        ;ワナ　乗ったら開始
        if evestartok=4 and evestartonoff=1 and idocnt=0 {
            takaragetok=0
            nextmode=1500
            
            notesel q
            noteget msg(0),1546+lung
            msg(1)=nostr
            msg(2)=nostr
            
            msetfr=fr
            gosub *msetfrdset
            pickuptraplv=msetfrd(18),msetfrd(19),msetfrd(20)
            
            gosub *traplvpickup
            
            if trappickupmax>0 {
                trappickupnn=rnd(trappickupmax)
                trapno=pickuptrapno(trappickupnn)
                traplv=pickuptraplvno(trappickupnn)
            }
        }
        
        ;イベント　乗ったら開始
        if evestartok=1 and evestartonoff=1 and idocnt=0 and mode=1000 {
            meswaitput=0
            eveline=0
            nextmode=2000
            chrnmtxton=0
        }
        
        ;壁のスイッチ
        wallswich=0
        dpfr=2        ;高低
        dpy=0        ;奥行
        dpx=2    ;左右
        gosub *nsweget
        idookng=putd(2,2,1,0)\1000
        if idookng>6 and idookng<11 and nextmode=1000 and mode=1000 {
            wallswich=1
            meswaitput=0
            btnco=5
            if mx>150 and my>720 and mx<250 and my<800 and idocnt=0 :btnco=1
            if rmx>150 and rmy>720 and rmx<250 and rmy<800 and idocnt=0 {
                hendrf=getdpfr-dmindanf
                hendrx=getmaedpx-dmindanx
                hendry=getmaedpy-dmindany
                ;a=wpeek(keydoorswno(getdpfr,getmaedpx,getmaedpy,maeget),0);swno.
                a=wpeek(keydoorswno(hendrf,hendrx,hendry,maeget),0);swno.
                b=bbget(dt(8,1225+a/32),(a\32),1)
                dt(8,1225+a/32)=bbins(1-b,1,dt(8,1225+a/32),(a\32))
                gosub *mappidset
            }

            boli btnco,150,720,250-3,800-3
            notesel evestartstr
            noteget evestartstrget,4
            evestartstrgetlen=strlen(evestartstrget)/mbyte
            strp evestartstrget,150+(50-evestartstrgetlen*(8-(lung)*3)),720+(80-24)/2,mbyte            
        }


        ;イベント　ボタンで開始
        if evestartok=2 and wallswich=0 {
            meswaitput=0
            btnco=5
            if mx>150 and my>720 and mx<250 and my<800 and idocnt=0 :btnco=1
            if rmx>150 and rmy>720 and rmx<250 and rmy<800 and idocnt=0 {
                eveline=0
                nextmode=2000
                chrnmtxton=0                
            }

            boli btnco,150,720,250-3,800-3
            notesel evestartstr
            noteget evestartstrget,evehassei(5)
            evestartstrgetlen=strlen(evestartstrget)/mbyte
            strp evestartstrget,150+(50-evestartstrgetlen*(8-(lung)*3)),720+(80-24)/2,mbyte            
            
        }
        
        ;現在地の情報とイベント開始やはしごのボタン表示
        dpfr=2        ;高低
        dpy=0        ;奥行
        dpx=2    ;左右
        hashigobtnon=0
        gosub *nsweget
        ;上へのはしご
        if (putd(2-1,2,1,3)\1000)=2 and mode=1000 and wallswich=0:hashigobtnon=1
        ;下へのはしご
        if (putd(2+0,2,1,3)\1000)=2 and mode=1000 and wallswich=0:hashigobtnon=hashigobtnon+2
        ;ねがいのいずみ
        if (putd(2+0,2,1,3)\1000)=6 and mode=1000 and wallswich=0:hashigobtnon=4

        if mode=1000 and hashigobtnon>0 and wallswich=0 {
            menubtnx=150
            menubtny=720
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+100 and my<menubtny+80 and idocnt=0 :btnco=1
            if rmx>menubtnx and rmy>menubtny and rmx<menubtnx+100 and rmy<menubtny+80 and idocnt=0 {
                ;はしご上
                if hashigobtnon=1 {
                    fr--
                    gosub *mappidset
                    msetfr=fr
                    gosub *msetfrdset
                    idocnt=1000
                    idocntnext=4
                    if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
                    hokouudlr=0

                    ;btlstartonoff=1
                }
                ;はしご下
                if hashigobtnon=2 {
                    fr++
                    gosub *mappidset
                    msetfr=fr
                    gosub *msetfrdset
                    idocnt=1000
                    idocntnext=5
                    if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
                    hokouudlr=0
                    ;btlstartonoff=1
                }
                ;はしご上下
                if hashigobtnon=3:nextmode=1001
                ;ねがいのいずみ
                if hashigobtnon=4 {
                    
                    getreq lookimaadmobtime,SYSREQ_timer
                    
                    notesel q

                    ;前回表示から３分たっていれば表示できる・初回表示の場合は無条件で表示
                    admobwatetime=1000*60*3
                    if mbyte=2:admobwatetime=1000*5
                    ;if ((admobiscnt=0) or (lookimaadmobtime>looklastadmobtime+(1000*60*3))) and (mbyte=3) {
                    if ((admobiscnt=0) or (lookimaadmobtime>looklastadmobtime+admobwatetime)) {

                        nextmode=2400
                        izumiy=0
                        izumimax=7
                        dim izumiselokng,izumimax
                        noteget msg(0),1566+lung
                        noteget msg(1),1568+lung
                        noteget msg(2),1570+lung
                        
                        ;このフロアのからっぽになっている宝を検索
                        dim resettakara,takaramaxput
                        resettakaramax=0
                        
                        for nnre,0,takaramaxput
                            ;現時点の出現カウンタ数
                            nnnnre=peek(dt(13,713+nnre),0)
                            ;カウンタがゼロ以上でまだ宝が復活していない物
                            if nnnnre>0 {
                                setfr=takaradata(nnre,2)+1
                                ;このフロアのものなら情報を保存
                                if setfr=fr+1 {
                                    resettakara(resettakaramax)=nnre
                                    resettakaramax++
                                }
                            }
                        next
                        if resettakaramax=0:izumiselokng(0)=1
                        
                        ;このフロアにワナが残っているか検索
                        setfr=fr+1
                        izumiselokng(1)=1
                        for sety,mindany,mindany+16
                            for setx,mindanx,mindanx+16
                                henfr=(setfr)-dmindanf
                                henix=(setx)-dmindanx
                                heniy=(sety)-dmindany
                                if (peek(mapd(henfr,henix,heniy),2)\1000)=4:izumiselokng(1)=0
                            next
                        next
                        
                        ;敵の気配
                        izumiselokng(2)=((dt(8,1292)=3000) or (msetfrd(17)=0))
                        
                        ;味方の状態
                        izumiselokng(4)=1
                        for n3,8,partymax+8,1
                            if dt(n3,110)!dt(n3,108):izumiselokng(4)=0
                            if dt(n3,111)!dt(n3,109):izumiselokng(4)=0
                            if dt(n3,137)!0:izumiselokng(4)=0
                            if dt(n3,138)!0:izumiselokng(4)=0
                            if dt(n3,139)!0:izumiselokng(4)=0
                            if dt(n3,140)!0:izumiselokng(4)=0
                            if dt(n3,141)!0:izumiselokng(4)=0
                            if dt(n3,142)!0:izumiselokng(4)=0
                            if dt(n3,143)!0:izumiselokng(4)=0
                        next

                        
                    } else {
                        
                        ;前回表示時から充分な時間が経っていない場合
                        nextmode=2405
                        noteget msg(0),1566+lung
                        noteget msg(1),1572+lung
                        noteget msg(2),1574+lung
                        
                    }
                }
            }

            ;bolico btnco,2,menubtnx,menubtny,menubtnx+100,menubtny+80
            boli btnco,menubtnx,menubtny,menubtnx+100-3,menubtny+80-3
            if hashigobtnon<4:strpq 678+lung,menubtnx+(100-16*3)/2,menubtny+(80-24)/2,mbyte,q            
            if hashigobtnon=4:strpq 268+lung,menubtnx+(100-16*4)/2,menubtny+(80-24)/2,mbyte,q            

        }
        
        ;よじのぼる
        kokoyuka=putd(2,2,1,3)\1000
        kokomae=putd(2,2,1,0)\1000
        ueyuka=putd(1,2,1,3)\1000
        uemae=putd(1,2,1,0)\1000
        uemaeyuka=putd(1,2,2,3)\1000
        if dtspecial(8,56)>0 and kokoyuka=0 and kokomae=0 and ueyuka=1 and uemae=1 and (uemaeyuka=0 or uemaeyuka=3 or uemaeyuka=4 or uemaeyuka=5) and mode=1000 and idocnt=0 and wallswich=0 {
            menubtnx=150
            menubtny=720
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+100 and my<menubtny+80 :btnco=1
            if rmx>menubtnx and rmy>menubtny and rmx<menubtnx+100 and rmy<menubtny+80 {
                evemychrido(0)=2
                evemychrido(2)=5
                ;if ins=-1 and iwe=0:n3=1
                ;if ins=0 and iwe=1:n3=1
                ;if ins=1 and iwe=0:n3=3
                ;if ins=0 and iwe=-1:n3=3
                evemychrido(1)=18
            }

            boli btnco,menubtnx,menubtny,menubtnx+100-3,menubtny+80-3
            strpq 1514+lung,menubtnx+(100-16*5)/2,menubtny+(80-24)/2,mbyte,q            
            
        }
        
        ;とびおりる
        kokoyuka=putd(2,2,1,3)\1000
        kokomae=putd(2,2,1,0)\1000
        maeyuka=putd(2,2,2,3)\1000
        sitayuka=putd(3,2,2,3)\1000
        if dtspecial(8,56)>0 and kokoyuka=0 and kokomae=1 and maeyuka=1 and (sitayuka=0 or sitayuka=3 or sitayuka=4 or sitayuka=5) and mode=1000 and idocnt=0 and wallswich=0 {
            menubtnx=150
            menubtny=720
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+100 and my<menubtny+80 :btnco=1
            if rmx>menubtnx and rmy>menubtny and rmx<menubtnx+100 and rmy<menubtny+80 {
                evemychrido(0)=2
                evemychrido(1)=6
                ;if ins=-1 and iwe=0:n3=0
                ;if ins=0 and iwe=1:n3=1
                ;if ins=1 and iwe=0:n3=2
                ;if ins=0 and iwe=-1:n3=3
                ;evemychrido(2)=n3+11
                ;btlstartonoff=1
                evemychrido(2)=18
            }

            boli btnco,menubtnx,menubtny,menubtnx+100-3,menubtny+80-3
            strpq 1516+lung,menubtnx+(100-16*5)/2,menubtny+(80-24)/2,mbyte,q            
            
        }

        ;宝箱
        kokoyuka=putd(2,2,1,3)\1000
        if kokoyuka=3 and mode=1000 and wallswich=0 {
            menubtnx=150
            menubtny=720
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+100 and my<menubtny+80 and idocnt=0 :btnco=1
            if rmx>menubtnx and rmy>menubtny and rmx<menubtnx+100 and rmy<menubtny+80 and idocnt=0 {
                nextmode=1400
                takaragetok=1
                for nn,0,takaramaxput
                    if takaradata(nn,2)=fr and takaradata(nn,3)=ix and takaradata(nn,4)=iy {
                        trasureitemno=bbget(dt(12,713+nn),0,9)
                        boxinitem(0)=bbget(dt(12,713+nn),0,9)
                        boxinitemmax=1
                        trapno=bbget(dt(12,713+nn),9,9)
                        trasureno=nn
                        _break
                    }
                next
            }

            boli btnco,menubtnx,menubtny,menubtnx+100-3,menubtny+80-3
            strpq 1524+lung,menubtnx+(100-16*5)/2,menubtny+(80-24)/2,mbyte,q            

        }
        
        ;menuボタン
        if mode=1000 {
            ;menubtnx=50
            ;menubtny=460
            menubtnx=200
            menubtny=640
            btnco=5
            if mx>menubtnx and my>menubtny and mx<menubtnx+100 and my<menubtny+80 :btnco=1
            if rmx>menubtnx and rmy>menubtny and rmx<menubtnx+100 and rmy<menubtny+80 and idocnt=0 :nextmode=1010

            boli btnco,menubtnx,menubtny,menubtnx+100-3,menubtny+80-3
            strpq 660+lung,menubtnx+(100-16*4)/2,menubtny+(80-24)/2,mbyte,q            
        }
        

        gosub *ido
                
    redraw 1
    
    await 33;1000/30;(30-(evemychrido(0)>0)*22)
    
loop


