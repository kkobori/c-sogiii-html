    if mode=1020 or mode=1028 or mode=1029 or mode=1080 or mode=1180 or mode=4080 or mode=4160:boli 0,pxp-2,(itempyset+pyp)-itempmax*36+pyp-2,272+pxp,(itempyset+pyp)+pyp

    ;装備品表示
    if mode=1080 or mode=1180 or mode=1181 or mode=4080 or mode=4081 {
        boli 4,pxp-2,(itempyset+pyp)-itempmax*36+pyp-2-36,272+pxp,(itempyset+pyp)-itempmax*36+pyp-5
        strpq 682+eqipy*2+lung,pxp-2+8,(itempyset+pyp)-itempmax*36+pyp-2-36+6,mbyte,q
        eqipputnm=itemnm(dt(chrno,133+eqipy),0+lung)
        if dt(chrno,133+eqipy)=512:eqipputnm=nostr
        strp eqipputnm,pxp-2+72,(itempyset+pyp)-itempmax*36+pyp-2-36+6,mbyte
    }

    ;アイテムの情報を表示
    if mode=1020 or mode=1021 or mode=1028 or mode=1029 or mode=1120 or mode=4160 or mode=4161 {
        itemselno=dt(8,713+itemy+itemsellpage*itempmax)
        eqipitemselno=dt(8,713+itemy+itemsellpage*itempmax)
        infoitemno=dt(8,713+itemy+itemsellpage*itempmax)
