            msetfr=fr
            gosub *msetfrdset
            if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
            hokouudlr=0
        }
        ;下に降りる
        if evemychrido(evemychrido(0))=6 {
            idocntnext=5
            idocnt=1000
            fr++
            gosub *nsweget
            gosub *mappidset
            msetfr=fr
            gosub *msetfrdset
            if dt(8,1292)=3000:dt(8,1292)=msetfrd(17)
            hokouudlr=0
        }
        gosub *nsweget
        ins=motoins
        iwe=motoiwe
        henfr=(getdpfr)-dmindanf
        henix=(getmaefrdpx)-dmindanx
        heniy=(getmaefrdpy)-dmindany
        if evemychrido(evemychrido(0))>10 or (((peek(mapd(henfr+1,henix,heniy),2)\1000)!1) and ((peek(mapd(henfr,henix,heniy),maeget)\1000)=1 or (peek(mapd(henfr,henix,heniy),maeget)\1000)=2)) {
            if evemychrido(evemychrido(0))\10=1:idocntnext=0:idocnt=1000;iy++
            if evemychrido(evemychrido(0))\10=2:idocntnext=3:idocnt=1000;ix++
            if evemychrido(evemychrido(0))\10=3:idocntnext=1:idocnt=1000;iy--
            if evemychrido(evemychrido(0))\10=4:idocntnext=2:idocnt=1000;ix--
            ;前へ進む
            if evemychrido(evemychrido(0))\10=8:idocntnext=0:idocnt=1000;ix--
            ;後ろへ進む
            if evemychrido(evemychrido(0))\10=9:idocntnext=1:idocnt=1000;ix--
            gosub *mappidset
        }
        evemychrido(evemychrido(0))=0
        evemychrido(0)--
        if evemychrido(0)<0:evemychrido(0)=0
        gosub *putdan
        gosub *putmap
    }
    
    if mode=1000 and evemychrido(0)=0 and idocnt=0 {

        if btlstartonoff=1 and partymax>0 and idocnt=0 {
            
            gosub *btlcheck
            if nextmode<4000 {
                
                ;歩行カウンター
                dt(8,1293)++
                if dt(8,1293)>2519:dt(8,1293)=0
                
                ;歩くとHPMP回復
                for nn,8,partymax+8
                    if dt(nn,110)>0 and (dt(8,1293)\11)=0 {
                        if dtspecial(nn,12)>0 {
                            dt(nn,110)=dt(nn,110)+(dt(nn,108)/80)+1
                            if dt(nn,110)>dt(nn,108):dt(nn,110)=dt(nn,108)
                        }
                        if dtspecial(nn,13)>0 {
                            dt(nn,111)=dt(nn,111)+(dt(nn,109)/120)+1
                            if dt(nn,111)>dt(nn,109):dt(nn,111)=dt(nn,109)
                        }
                    }
                next
                ;状態異常や出現率の効果のカウンターを減らす
                for nn,137,147
                    nnnn=nn
                    if nnnn=145:nnnn=199
                    if nnnn=146:nnnn=200
                    for chrno,8,8+partymax
                        if (nnnn<145) or (chrno=8) {
                            if dt(chrno,nnnn)>0 {
                                dt(chrno,nnnn)--
                                if dtspecial(chrno,11)>0 and nnnn<145:dt(chrno,nnnn)=dt(chrno,nnnn)-rnd(7)-1
                                ;効果が切れる瞬間
                                if dt(chrno,nnnn)<1 {
                                    dt(chrno,nnnn)=0
                                    if nnnn<145 {
                                        noteget msgset1,788+(nnnn-137)*2+lung
                                        msg(0)=btlchrnmstr(chrno)+msgset1
                                        msg(1)=nostr
                                        msg(2)=nostr
                                        nextmode=1005
                                    }
                                }
                            }
                        }
                    next
                next
                ;毒・とりつかれのダメージ137 143
                damagesion=0
                for chrno,8,8+partymax
                    if dt(chrno,110)>0 {
                        if dt(chrno,137)>0 and (dt(8,1293)\8)=0 {
                            dt(chrno,110)=dt(chrno,110)-(dt(chrno,108)/80)-1
                            if dt(chrno,108)<1:dt(chrno,108)=1
                            damagesion=1
                        }
                        if dt(chrno,143)>0 and (dt(8,1293)\8)=4 {
                            dt(chrno,111)=dt(chrno,111)-(dt(chrno,109)/120)-1
                            if dt(chrno,111)<0:dt(chrno,109)=0
                            damagesion=1
                        }
                    }
                next
                if damagesion=1 {
                    siefectcnt=2
                    siefectset(0,siefectcnt-1)=0
                    gosub *siefecton
                }
            }
        }

        ;前へ進む
        if (btnpushon(0)=1 or btn(0)=1) and nextmode<2000 and mx!-1 and (evestartok!4) {
            dpfr=2        ;高低
            dpy=0        ;奥行
            dpx=2    ;左右
            gosub *nsweget
            idookngkabe=putd(2,2,1,0)\1000
            idookngyuka=putd(2,2,2,3)\1000
            idookngkokoyuka=putd(2,2,1,3)\1000
            idookng=0
            if (idookngyuka!1) and (idookngkabe=1 or idookngkabe=2 or idookngkabe=6):idookng=1
            ;lrud(0,1,0,0)=1    ;a=14, ins=0 , iwe=-1, 0(U)
            if idookngkokoyuka>13 and idookngkokoyuka<25 {
                if lrud(idookngkokoyuka-14,ins+1,iwe+1,0)=1:idookng=0                
            }
            if idookngyuka>13 and idookngyuka<25 {
                if lrud(idookngyuka-14,ins+1,iwe+1,2)=1:idookng=0                
            }
            if idookng=1 {
                idocnt=1000
                evestartonoff=1
                btlstartonoff=1
                idocntnext=0
                pmsm=1
                hokouudlr=0
            }
        }
        ;後ろへ進む
            if (btnpushon(2)=1 or btn(2)=1) and nextmode<2000 and mx!-1 and (evestartok!4) {
            dpfr=2        ;高低
            dpy=0        ;奥行
            dpx=2    ;左右
            gosub *nsweget
            ;idookng=putd(2,2,0,0)\1000
