            n2=bbget(eved(eveno,eveline,0),8,1)        ;0=マップ 1=イベント
            n3=bbget(eved(eveno,eveline,0),9,8)        ;チップNo.
            n4=bbget(eved(eveno,eveline,0),17,8)    ;Ｘ(map 定数or現在地)
            n5=bbget(eved(eveno,eveline,1),0,8)        ;Ｙ(map 定数or現在地)
