        gosub *sppagemaxget
    }
    if mode=1050 and rmx!-1 :nextmode=1055:jobpage=0:joby=0:chrno=chrsely+8
    if mode=1055 and rmx!-1 {
        if jobputno(jobpage*8+jobsely*2+jobselx,1)=1 {
