            setcbno=bbget(eved(eveno,eveline,0),9,7)
            volsetmode=bbget(eved(eveno,eveline,0),17,7)
            onetimeorloop=bbget(eved(eveno,eveline,0),24,1)
            voludcom=bbget(eved(eveno,eveline,0),25,4)
            voludcountn=20
            if (setcbno<51) {
                if volsetmode=0:bgmvolsetmode=1:bgmvol=0
                if volsetmode=1:bgmvolsetmode=2:bgmvol=-1000
                if volsetmode=2:sevolsetmode=1:sevol=0
                if volsetmode=3:sevolsetmode=2:sevol=-1000
                if volsetmode=4:bgmvolsetmode=3:bgmvol=-1000    :voludcountn=1000/(voludcom+1)/30
                if volsetmode=5:bgmvolsetmode=4:bgmvol=0        :voludcountn=1000/(voludcom+1)/30
                if volsetmode=6:bgmvolsetmode=5:bgmvol=0        :voludcountn=volhalf/(voludcom+1)/30
                if volsetmode=7:bgmvolsetmode=6:bgmvol=volhalf    :voludcountn=volhalf/(voludcom+1)/30
                if volsetmode=8:bgmvolsetmode=7:bgmvol=volhalf    :voludcountn=(1000-volhalf)/(voludcom+1)/30
                if volsetmode=9:bgmvolsetmode=8:bgmvol=0        :voludcountn=(1000-volhalf)/(voludcom+1)/30
                if volsetmode=10:sevolsetmode=3:sevol=-1000        
                if volsetmode=11:sevolsetmode=4:sevol=0            
                if volsetmode=12:sevolsetmode=5:sevol=0            
                if volsetmode=13:sevolsetmode=6:sevol=volhalf    
                if volsetmode=14:sevolsetmode=7:sevol=volhalf    
                if volsetmode=15:sevolsetmode=8:sevol=0        
            }
            if bgmorvol=0 and bgmonoff=0 and (bgmno!cbno) and (setcbno<51) {
                cbno=setcbno
                bgmsetmap=cbno
                mmstop 1
